{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://apis.google.com https://www.googletagmanager.com https://pagead2.googlesyndication.com https://www.google-analytics.com https://challenges.cloudflare.com https://static.cloudflareinsights.com; connect-src 'self' https://www.google-analytics.com https://www.google.com https://formspree.io https://challenges.cloudflare.com https://static.cloudflareinsights.com; frame-src 'self' https://challenges.cloudflare.com; img-src 'self' data: https://www.google-analytics.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://www.praveentechworld.com; base-uri 'self'; object-src 'none'"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/pagefind/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/about",
      "destination": "/contact",
      "statusCode": 301
    },
    {
      "source": "/services",
      "destination": "https://services.praveentechworld.com",
      "statusCode": 301
    },
    {
      "source": "/services/(.*)",
      "destination": "https://services.praveentechworld.com/$1",
      "statusCode": 301
    },
    {
      "source": "/blog/ga4-data-delayed-or-missing-check-measurement-id-consent",
      "destination": "/blog/ga4-not-tracking-visitors-12-troubleshooting-steps",
      "statusCode": 301
    },
    {
      "source": "/blog/ga4-shows-realtime-users-but-reports-blank-fix-processing",
      "destination": "/blog/ga4-not-tracking-visitors-12-troubleshooting-steps",
      "statusCode": 301
    },
    {
      "source": "/blog/ga4-traffic-looks-wrong-check-consent-mode-and-filters",
      "destination": "/blog/ga4-not-tracking-visitors-12-troubleshooting-steps",
      "statusCode": 301
    },
    {
      "source": "/blog/how-to-use-google-analytics-4-to-improve-your-content-strategy",
      "destination": "/blog/ga4-not-tracking-visitors-12-troubleshooting-steps",
      "statusCode": 301
    },
    {
      "source": "/blog/sitemap-submitted-but-pages-undiscovered-robotstxt-check",
      "destination": "/blog/how-to-fix-google-indexing-errors-crawled-not-indexed",
      "statusCode": 301
    },
    {
      "source": "/blog/sitemap-urls-blocked-by-robotstxt-clean-and-resubmit",
      "destination": "/blog/how-to-fix-sitemap-errors-in-google-search-console",
      "statusCode": 301
    },
    {
      "source": "/blog/understanding-sitemap-indexing-fix-crawling-issues",
      "destination": "/blog/how-to-fix-sitemap-errors-in-google-search-console",
      "statusCode": 301
    },
    {
      "source": "/blog/why-you-dont-have-gemini-spark-mode-yet-access-guide",
      "destination": "/blog/google-gemini-spark-mode-features-guide",
      "statusCode": 301
    },
    {
      "source": "/blog/gemini-spark-remote-browser-vs-local-chrome-fix",
      "destination": "/blog/google-gemini-spark-mode-features-guide",
      "statusCode": 301
    },
    {
      "source": "/blog/will-factory-resetting-windows-fix-corrupted-user-profile",
      "destination": "/blog/will-reinstalling-windows-fix-slow-performance-issues",
      "statusCode": 301
    },
    {
      "source": "/blog/will-reinstalling-windows-fix-blue-screen-errors",
      "destination": "/blog/will-reinstalling-windows-fix-slow-performance-issues",
      "statusCode": 301
    },
    {
      "source": "/blog/website-speed-optimization-why-it-matters-for-seo-and-how-to-fix-it",
      "destination": "/blog/website-speed-upgrades-fix-crawling-delays-and-core-web-vitals",
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "query",
          "key": "m",
          "value": "1"
        }
      ],
      "destination": "/$1",
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "missing": [
        {
          "type": "host",
          "value": "www.praveentechworld.com"
        }
      ],
      "destination": "https://www.praveentechworld.com/$1",
      "statusCode": 301
    }
  ]
}