---
import BaseLayout from "@layouts/BaseLayout.astro";
import DeGoogleScoreCalculator from "@components/blog/DeGoogleScoreCalculator.astro";
import TechAdUnit from "@components/ads/TechAdUnit.astro";

const seo = {
  title: "DeGoogle Freedom Score & Privacy Audit Calculator (2026)",
  description: "Check how DeGoogled you are. Interactive privacy checklist calculating your score, daily background telemetry pings blocked, and next quick-win migration steps.",
  canonical: "https://www.praveentechworld.com/tools/degoogle-score-checker",
};

const faqItems = [
  {
    question: "How is the DeGoogle Freedom Score calculated?",
    answer: "Each category is weighted according to its data harvesting impact based on our 72-hour Wireshark mobile telemetry benchmark. The Mobile Operating System carries 20% because stock Android initiates 348 background pings/hour. Email (15%) and Search (15%) represent your primary identity and query profiles, while Browser, Cloud Storage, Photos, Maps, and Notes/Calendar each contribute 10% toward your 100% sovereignty goal."
  },
  {
    question: "What does the 'Daily Pings Blocked' counter mean?",
    answer: "In our laboratory tests behind managed firewalls, a stock Google Pixel phone connected to an active Google account initiated an average of 348.4 background outbound socket requests every single hour while locked and idle. Over 24 hours, that equals approximately 8,920 pings per day. As you replace Google services with private alternatives, the calculator projects your daily telemetry reduction."
  },
  {
    question: "Do I have to score 100% to protect my privacy?",
    answer: "No. Reaching Level 2 (26% to 50%) or Level 3 (51% to 80%) eliminates the vast majority of consumer advertising profiling and personal data mining. Switching your search engine, web browser, and email takes under 15 minutes and immediately closes the widest data leaks."
  },
  {
    question: "Can I save or share my DeGoogle Freedom Score?",
    answer: "Yes. Your checklist selections are automatically saved in your browser's local storage so you can track your progress over time. You can also click 'Copy My Score' to share your progress with friends or on social media."
  }
];
---

<BaseLayout seo={seo}>
  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:py-16">
    <!-- Breadcrumb -->
    <nav class="mb-6 text-sm text-text-muted dark:text-text-dark-muted" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2">
        <li><a href="/" class="hover:text-brand-600 dark:hover:text-brand-400">Home</a></li>
        <li><span class="text-text-muted/60">/</span></li>
        <li><a href="/tools" class="hover:text-brand-600 dark:hover:text-brand-400">Tools</a></li>
        <li><span class="text-text-muted/60">/</span></li>
        <li class="font-medium text-text dark:text-text-dark" aria-current="page">DeGoogle Score Checker</li>
      </ol>
    </nav>

    <!-- Header -->
    <header class="mb-8 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 rounded-full border border-brand-500/20 bg-brand-500/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-brand-600 dark:text-brand-400 mb-4">
        ⚡ Free Interactive Privacy Utility
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl lg:text-5xl text-text dark:text-text-dark">
        How DeGoogled Are You?
      </h1>
      <p class="mt-4 text-base sm:text-lg text-text-muted dark:text-text-dark-muted leading-relaxed">
        Audit your digital life in 60 seconds. Check off the Google services you have replaced to see your real-time <strong>DeGoogle Freedom Score</strong>, estimated daily background pings blocked, and your next recommended migration win.
      </p>
    </header>

    <!-- Main Calculator Component -->
    <DeGoogleScoreCalculator />

    <!-- In-Article Tech Ad Unit -->
    <TechAdUnit category="privacy" tags={["degoogle", "privacy", "security"]} slotType="in-article" />

    <!-- Why DeGoogling Matters Section -->
    <section class="my-16 rounded-2xl border border-border bg-surface p-6 sm:p-8 dark:border-border-dark dark:bg-surface-dark-alt">
      <h2 class="text-2xl font-bold text-text dark:text-text-dark mb-4">
        Why Every Percentage Point Matters
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-sm text-text-muted dark:text-text-dark-muted leading-relaxed">
        <div class="space-y-2">
          <h3 class="text-base font-bold text-text dark:text-text-dark flex items-center gap-2">
            <span>🛡️</span> Identity Protection
          </h3>
          <p>
            When you use Google Search, Chrome, and Gmail simultaneously, Google connects your financial receipts, medical queries, and personal identity into a unified behavioral profile.
          </p>
        </div>
        <div class="space-y-2">
          <h3 class="text-base font-bold text-text dark:text-text-dark flex items-center gap-2">
            <span>🔋</span> Battery & Performance
          </h3>
          <p>
            Our <a href="/research/degoogle-telemetry-2026" class="text-brand-600 hover:underline dark:text-brand-400">72-hour packet study</a> confirmed that Google Play Services wakes up your phone 348 times an hour. Removing background telemetry preserves battery life and reduces processor wakeups.
          </p>
        </div>
        <div class="space-y-2">
          <h3 class="text-base font-bold text-text dark:text-text-dark flex items-center gap-2">
            <span>🔒</span> True Data Ownership
          </h3>
          <p>
            Moving to open-source protocols like Proton Mail (PGP), Bitwarden (zero-knowledge vault), and Immich ensures that no automated algorithm can lock you out of your photos or documents without recourse.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ Accordion -->
    <section class="my-16">
      <h2 class="text-2xl font-bold text-text dark:text-text-dark mb-6">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqItems.map((item) => (
          <details open class="group border border-border dark:border-border-dark rounded-xl bg-surface dark:bg-surface-dark-alt p-5 transition-colors duration-300">
            <summary class="list-none flex items-center justify-between font-bold text-base text-text dark:text-text-dark cursor-pointer">
              <span>{item.question}</span>
              <span class="text-brand-600 dark:text-brand-400 group-open:rotate-180 transition-transform duration-200">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <div class="mt-3 pt-3 border-t border-border/50 dark:border-border-dark/50 text-text-muted dark:text-text-dark-muted text-sm leading-relaxed">
              {item.answer}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Bridge to Runbook -->
    <div class="rounded-2xl border-2 border-brand-500 bg-slate-950 p-6 sm:p-8 text-white shadow-xl">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <span class="inline-flex items-center rounded-md bg-brand-500/30 px-2.5 py-1 text-xs font-black uppercase tracking-wider text-brand-300">
            Step-by-Step Runbook
          </span>
          <h3 class="text-xl sm:text-2xl font-black text-white mt-2 mb-1">
            Need Help Replacing Your Services?
          </h3>
          <p class="text-sm text-slate-300 max-w-2xl leading-relaxed m-0">
            Read our flagship DeGoogle Starter Pack guide for step-by-step migration checklists, Takeout metadata fixes, and banking app workarounds.
          </p>
        </div>
        <a
          href="/blog/degoogle-starter-pack-complete-guide"
          class="inline-flex shrink-0 items-center gap-2 rounded-xl bg-brand-500 px-6 py-3.5 text-sm font-bold text-white shadow-lg transition-all hover:bg-brand-400"
        >
          <span>Read the Complete Guide &rarr;</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
