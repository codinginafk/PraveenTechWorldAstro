---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getPublishedArticles } from "@lib/content/posts";
import ArticleCard from "@components/content/ArticleCard.astro";

const articles = await getPublishedArticles();
const toolArticles = articles.filter(
  (a) => a.data.category === "ai-tools" || a.data.category === "free-software"
);
---

<BaseLayout
  seo={{
    title: "Developer Tools & Software Reviews",
    description:
      "Interactive AI calculators, GPU memory estimators, and honest software reviews for developers, sysadmins, and power users.",
  }}
>
  <div class="mx-auto max-w-6xl px-4 py-16">
    <div class="mb-10">
      <h1 class="mb-3 text-3xl font-extrabold tracking-tight sm:text-4xl text-text-main dark:text-text-dark-main">
        Developer Tools & Utilities
      </h1>
      <p class="text-base text-text-muted dark:text-text-dark-muted">
        Zero-lag interactive engineering calculators and software benchmarks.
      </p>
    </div>

    <!-- Featured Interactive Tool Hero Card -->
    <div class="mb-14 rounded-2xl border border-accent/30 bg-gradient-to-br from-card-light to-accent/5 p-8 shadow-sm dark:border-accent/30 dark:from-card-dark dark:to-accent/5">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-3 max-w-2xl">
          <div class="inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-accent">
            ⚡ Flagship Interactive Tool
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold text-text-main dark:text-text-dark-main">
            Local AI VRAM & Quantization Calculator
          </h2>
          <p class="text-sm sm:text-base text-text-muted dark:text-text-dark-muted leading-relaxed">
            Planning to run DeepSeek-R1, Llama 3.3, or Qwen 2.5 locally? Calculate exact GPU memory costs for weights, KV cache, and CUDA buffers across Q4, Q8, and FP8 precision before downloading hundreds of gigabytes.
          </p>
          <div class="flex flex-wrap gap-2 pt-1 text-xs font-mono text-text-muted dark:text-text-dark-muted">
            <span class="rounded-md bg-bg-light dark:bg-bg-dark px-2 py-1 border border-border-light dark:border-border-dark">RTX 4090 / 4060</span>
            <span class="rounded-md bg-bg-light dark:bg-bg-dark px-2 py-1 border border-border-light dark:border-border-dark">Apple M-Series</span>
            <span class="rounded-md bg-bg-light dark:bg-bg-dark px-2 py-1 border border-border-light dark:border-border-dark">DeepSeek-R1</span>
            <span class="rounded-md bg-bg-light dark:bg-bg-dark px-2 py-1 border border-border-light dark:border-border-dark">Ollama & llama.cpp</span>
          </div>
        </div>
        <a
          href="/tools/vram-calculator"
          class="inline-flex shrink-0 items-center gap-2 rounded-xl bg-accent px-6 py-3.5 text-sm font-bold text-white shadow-md hover:bg-accent/90 transition"
        >
          <span>Launch Calculator</span>
          <span>&rarr;</span>
        </a>
      </div>
    </div>

    <!-- Software Reviews Grid -->
    <div class="border-t border-border-light dark:border-border-dark pt-12">
      <h2 class="mb-6 text-2xl font-bold text-text-main dark:text-text-dark-main">
        Tool Reviews & Comparisons
      </h2>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {toolArticles.map((article, idx) => (
          <ArticleCard article={article} index={idx} />
        ))}
      </div>

      {toolArticles.length === 0 && (
        <p class="py-12 text-center text-text-muted dark:text-text-dark-muted">
          Tool reviews coming soon.
        </p>
      )}
    </div>
  </div>
</BaseLayout>
