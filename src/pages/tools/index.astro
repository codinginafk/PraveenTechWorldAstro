---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getPublishedArticles } from "@lib/content/posts";
import ArticleCard from "@components/content/ArticleCard.astro";

const articles = await getPublishedArticles();
const toolArticles = articles.filter(
  (a) => a.data.category === "ai-tools" || a.data.category === "free-software"
);
---

<BaseLayout
  seo={{
    title: "Developer Tools & Software Reviews",
    description:
      "Interactive AI calculators, GPU memory estimators, and honest software reviews for developers, sysadmins, and power users.",
  }}
>
  <div class="mx-auto max-w-6xl px-4 py-16">
    <div class="mb-10">
      <h1 class="mb-3 text-3xl font-extrabold tracking-tight sm:text-4xl text-text dark:text-text-dark">
        Developer Tools & Utilities
      </h1>
      <p class="text-base text-text-muted dark:text-text-dark-muted">
        Zero-lag interactive engineering calculators and software benchmarks.
      </p>
    </div>

    <!-- Featured Interactive Tool Hero Card -->
    <div class="mb-14 rounded-2xl border border-brand-500/30 bg-surface p-8 shadow-sm dark:border-brand-500/30 dark:bg-surface-dark relative overflow-hidden">
      <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-brand-500/10 blur-3xl pointer-events-none"></div>
      <div class="relative flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-3 max-w-2xl">
          <div class="inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-500/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-brand-600 dark:text-brand-400">
            ⚡ Flagship Interactive Tool
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold text-text dark:text-text-dark">
            Local AI VRAM & Quantization Calculator
          </h2>
          <p class="text-sm sm:text-base text-text-muted dark:text-text-dark-muted leading-relaxed">
            Planning to run DeepSeek-R1, Llama 3.3, or Qwen 2.5 locally? Calculate exact GPU memory costs for weights, KV cache, and CUDA buffers across Q4, Q8, and FP8 precision before downloading hundreds of gigabytes.
          </p>
          <div class="flex flex-wrap gap-2 pt-1 text-xs font-mono text-text-muted dark:text-text-dark-muted">
            <span class="rounded-md bg-surface-alt dark:bg-surface-dark-alt px-2.5 py-1 border border-border dark:border-border-dark text-text dark:text-text-dark">RTX 4090 / 4060</span>
            <span class="rounded-md bg-surface-alt dark:bg-surface-dark-alt px-2.5 py-1 border border-border dark:border-border-dark text-text dark:text-text-dark">Apple M-Series</span>
            <span class="rounded-md bg-surface-alt dark:bg-surface-dark-alt px-2.5 py-1 border border-border dark:border-border-dark text-text dark:text-text-dark">DeepSeek-R1</span>
            <span class="rounded-md bg-surface-alt dark:bg-surface-dark-alt px-2.5 py-1 border border-border dark:border-border-dark text-text dark:text-text-dark">Ollama & llama.cpp</span>
          </div>
        </div>
        <a
          href="/tools/vram-calculator"
          class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-brand-600 hover:bg-brand-700 active:scale-95 px-6 py-3.5 text-sm font-bold text-white shadow-md hover:shadow-lg transition-all duration-200 cursor-pointer dark:bg-brand-500 dark:hover:bg-brand-600"
        >
          <span>Launch Calculator</span>
          <span class="text-base">&rarr;</span>
        </a>
      </div>
    </div>

    <!-- Windows Error Decryptor Tool Card -->
    <div class="mb-14 rounded-2xl border border-border bg-surface p-8 shadow-sm dark:border-border-dark dark:bg-surface-dark relative overflow-hidden">
      <div class="relative flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-3 max-w-2xl">
          <div class="inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-500/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-brand-600 dark:text-brand-400">
            🛠️ Sysadmin Diagnostic Tool
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold text-text dark:text-text-dark">
            Windows Error Code Decryptor & PowerShell Fixer
          </h2>
          <p class="text-sm sm:text-base text-text-muted dark:text-text-dark-muted leading-relaxed">
            Instant search for Windows Update error codes (0x8024200d, 0x80070002, 0x800f081f) and BSoD stop codes (CLOCK_WATCHDOG_TIMEOUT, DPC_WATCHDOG_VIOLATION). Generates 1-click administrator PowerShell repair commands.
          </p>
          <div class="flex flex-wrap gap-2 pt-1 text-xs font-mono text-text-muted dark:text-text-dark-muted">
            <span class="rounded-md bg-surface-alt dark:bg-surface-dark-alt px-2.5 py-1 border border-border dark:border-border-dark text-text dark:text-text-dark">0x8024200d</span>
            <span class="rounded-md bg-surface-alt dark:bg-surface-dark-alt px-2.5 py-1 border border-border dark:border-border-dark text-text dark:text-text-dark">0x80070002</span>
            <span class="rounded-md bg-surface-alt dark:bg-surface-dark-alt px-2.5 py-1 border border-border dark:border-border-dark text-text dark:text-text-dark">BSoD Stop Codes</span>
            <span class="rounded-md bg-surface-alt dark:bg-surface-dark-alt px-2.5 py-1 border border-border dark:border-border-dark text-text dark:text-text-dark">PowerShell Fixes</span>
          </div>
        </div>
        <a
          href="/tools/windows-error-fixer"
          class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl border border-brand-500/40 bg-surface-alt hover:bg-brand-500/10 active:scale-95 px-6 py-3.5 text-sm font-bold text-brand-600 dark:text-brand-400 shadow-sm transition-all duration-200 cursor-pointer"
        >
          <span>Launch Decryptor</span>
          <span class="text-base">&rarr;</span>
        </a>
      </div>
    </div>

    <!-- Software Reviews Grid -->
    <div class="border-t border-border dark:border-border-dark pt-12">
      <h2 class="mb-6 text-2xl font-bold text-text dark:text-text-dark">
        Tool Reviews & Comparisons
      </h2>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {toolArticles.map((article, idx) => (
          <ArticleCard article={article} index={idx} />
        ))}
      </div>

      {toolArticles.length === 0 && (
        <p class="py-12 text-center text-text-muted dark:text-text-dark-muted">
          Tool reviews coming soon.
        </p>
      )}
    </div>
  </div>
</BaseLayout>
