</BaseLayout>

<script is:inline>
  const hostRamSlider = document.getElementById("host-ram");
  const hostRamVal = document.getElementById("host-ram-val");
  const hostCoresSlider = document.getElementById("host-cores");
  const hostCoresVal = document.getElementById("host-cores-val");
  
  const wslRamSlider = document.getElementById("wsl-ram");
  const wslRamVal = document.getElementById("wsl-ram-val");
  const ramPctBadge = document.getElementById("ram-pct-badge");

  const wslCoresSlider = document.getElementById("wsl-cores");
  const wslCoresVal = document.getElementById("wsl-cores-val");
  const coresPctBadge = document.getElementById("cores-pct-badge");

  const wslSwapSelect = document.getElementById("wsl-swap");
  const autoReclaimSelect = document.getElementById("auto-reclaim");

  const featSparse = document.getElementById("feat-sparse");
  const featMirrored = document.getElementById("feat-mirrored");
  const featDns = document.getElementById("feat-dns");
  const featProxy = document.getElementById("feat-proxy");
  const featFirewall = document.getElementById("feat-firewall");
  const featPage = document.getElementById("feat-page");

  const configCode = document.getElementById("config-code");
  const psCommandCode = document.getElementById("ps-command-code");
  const savedRamBadge = document.getElementById("saved-ram-badge");
  const copyBtn = document.getElementById("copy-btn");
  const downloadBtn = document.getElementById("download-btn");
  const copyPsBtn = document.getElementById("copy-ps-btn");
  const presetBtns = document.querySelectorAll(".preset-btn");

  function updateLimits() {
    const hostRam = parseInt(hostRamSlider.value, 10);
    const hostCores = parseInt(hostCoresSlider.value, 10);

    hostRamVal.textContent = `${hostRam} GB`;
    hostCoresVal.textContent = `${hostCores} Cores`;

    // Max WSL RAM cannot exceed hostRam - 2
    const maxWslRam = Math.max(2, hostRam - 2);
    wslRamSlider.max = maxWslRam;
    if (parseInt(wslRamSlider.value, 10) > maxWslRam) {
      wslRamSlider.value = Math.round(hostRam * 0.5);
    }

    // Max WSL cores cannot exceed hostCores
    wslCoresSlider.max = hostCores;
    if (parseInt(wslCoresSlider.value, 10) > hostCores) {
      wslCoresSlider.value = Math.max(2, Math.round(hostCores * 0.5));
    }

    renderConfig();
  }

  function renderConfig() {
    const hostRam = parseInt(hostRamSlider.value, 10);
    const hostCores = parseInt(hostCoresSlider.value, 10);
    const wslRam = parseInt(wslRamSlider.value, 10);
    const wslCores = parseInt(wslCoresSlider.value, 10);
    const swap = wslSwapSelect.value;
    const reclaim = autoReclaimSelect.value;

    const ramPct = Math.round((wslRam / hostRam) * 100);
    const coresPct = Math.round((wslCores / hostCores) * 100);

    wslRamVal.textContent = `${wslRam} GB`;
    ramPctBadge.textContent = `${ramPct}% of Host`;
    wslCoresVal.textContent = `${wslCores} Cores`;
    coresPctBadge.textContent = `${coresPct}% of Host`;

    const savedRam = hostRam - wslRam;
    savedRamBadge.textContent = `Host Headroom: ${savedRam} GB Protected`;

    let lines = [
      "# Settings apply to all WSL2 distributions (Windows 11 / 10)",
      "# Generated via PraveenTechWorld WSL2 Memory Optimizer",
      "[wsl2]",
      `memory=${wslRam}GB`,
      `processors=${wslCores}`,
      `swap=${swap}`,
      `swapFile=%USERPROFILE%\\AppData\\Local\\Temp\\wsl2-swap.vhdx`
    ];

    if (featPage.checked) {
      lines.push("pageReporting=true");
    }

    // Advanced Section (Windows 11 23H2+)
    let experimental = [];
    if (reclaim !== "disabled") {
      experimental.push(`autoMemoryReclaim=${reclaim}`);
    }
    if (featSparse.checked) {
      experimental.push("sparseVhd=true");
    }

    if (experimental.length > 0) {
      lines.push("");
      lines.push("# Modern Memory & Disk Compaction (Windows 11 23H2/24H2/25H2)");
      lines.push("[experimental]");
      experimental.forEach(e => lines.push(e));
    }

    // Networking section
    let netLines = [];
    if (featMirrored.checked) {
      netLines.push("networkingMode=mirrored");
    }
    if (featDns.checked) {
      netLines.push("dnsTunneling=true");
    }
    if (featProxy.checked) {
      netLines.push("autoProxy=true");
    }
    if (featFirewall.checked) {
      netLines.push("firewall=true");
    }

    if (netLines.length > 0) {
      if (!lines.includes("[experimental]")) {
        lines.push("");
        lines.push("[experimental]");
      }
      netLines.forEach(n => lines.push(n));
    }

    const configText = lines.join("\n");
    configCode.textContent = configText;

    // Generate PowerShell 1-liner
    const psText = `@'\n${configText}\n'@ | Out-File -FilePath "$HOME\\.wslconfig" -Encoding ascii -Force; wsl --shutdown`;
    psCommandCode.textContent = psText;
  }

  // Workload Presets
  presetBtns.forEach(btn => {
    btn.addEventListener("click", () => {
      presetBtns.forEach(b => {
        b.classList.remove("border-brand-500/40", "bg-brand-500/10", "dark:bg-brand-500/20", "text-brand-600", "dark:text-brand-300");
        b.classList.add("border-border", "dark:border-border-dark", "bg-surface-alt", "dark:bg-surface-dark-alt", "text-text", "dark:text-text-dark");
      });
      btn.classList.add("border-brand-500/40", "bg-brand-500/10", "dark:bg-brand-500/20", "text-brand-600", "dark:text-brand-300");
      btn.classList.remove("border-border", "dark:border-border-dark", "bg-surface-alt", "dark:bg-surface-dark-alt", "text-text", "dark:text-text-dark");

      const preset = btn.getAttribute("data-preset");
      const hostRam = parseInt(hostRamSlider.value, 10);
      const hostCores = parseInt(hostCoresSlider.value, 10);

      if (preset === "docker") {
        wslRamSlider.value = Math.max(4, Math.round(hostRam * 0.5));
        wslCoresSlider.value = Math.max(2, Math.round(hostCores * 0.5));
        wslSwapSelect.value = "4GB";
        autoReclaimSelect.value = "dropcache";
        featSparse.checked = true;
        featMirrored.checked = true;
        featDns.checked = true;
      } else if (preset === "rust") {
        wslRamSlider.value = Math.max(6, Math.round(hostRam * 0.75));
        wslCoresSlider.value = Math.max(4, hostCores - 2);
        wslSwapSelect.value = "8GB";
        autoReclaimSelect.value = "gradual";
        featSparse.checked = true;
        featMirrored.checked = true;
        featDns.checked = true;
      } else if (preset === "ai") {
        wslRamSlider.value = Math.max(8, Math.round(hostRam * 0.8));
        wslCoresSlider.value = Math.max(4, hostCores - 2);
        wslSwapSelect.value = "0GB";
        autoReclaimSelect.value = "gradual";
        featPage.checked = true;
        featSparse.checked = true;
        featMirrored.checked = false;
      } else if (preset === "web") {
        wslRamSlider.value = Math.max(4, Math.round(hostRam * 0.35));
        wslCoresSlider.value = Math.max(2, Math.round(hostCores * 0.5));
        wslSwapSelect.value = "2GB";
        autoReclaimSelect.value = "gradual";
        featSparse.checked = true;
        featMirrored.checked = true;
        featDns.checked = true;
      } else if (preset === "balanced") {
        wslRamSlider.value = Math.max(4, Math.round(hostRam * 0.5));
        wslCoresSlider.value = Math.max(2, Math.round(hostCores * 0.5));
        wslSwapSelect.value = "4GB";
        autoReclaimSelect.value = "gradual";
        featSparse.checked = true;
        featMirrored.checked = true;
        featDns.checked = true;
      }

      renderConfig();
    });
  });

  // Event Listeners
  hostRamSlider.addEventListener("input", updateLimits);
  hostCoresSlider.addEventListener("input", updateLimits);
  wslRamSlider.addEventListener("input", renderConfig);
  wslCoresSlider.addEventListener("input", renderConfig);
  wslSwapSelect.addEventListener("change", renderConfig);
  autoReclaimSelect.addEventListener("change", renderConfig);

  [featSparse, featMirrored, featDns, featProxy, featFirewall, featPage].forEach(cb => {
    cb.addEventListener("change", renderConfig);
  });

  // Copy Config
  copyBtn.addEventListener("click", () => {
    navigator.clipboard.writeText(configCode.textContent).then(() => {
      const orig = copyBtn.innerHTML;
      copyBtn.innerHTML = "<span>✅ Copied!</span>";
      setTimeout(() => { copyBtn.innerHTML = orig; }, 2000);
    });
  });

  // Copy PowerShell
  copyPsBtn.addEventListener("click", () => {
    navigator.clipboard.writeText(psCommandCode.textContent).then(() => {
      const orig = copyPsBtn.innerHTML;
      copyPsBtn.innerHTML = "Copied!";
      setTimeout(() => { copyPsBtn.innerHTML = orig; }, 2000);
    });
  });

  // Download File
  downloadBtn.addEventListener("click", () => {
    const blob = new Blob([configCode.textContent], { type: "text/plain" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = ".wslconfig";
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });

  // Initialize
  updateLimits();
</script>\n