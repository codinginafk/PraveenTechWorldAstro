---
import BaseLayout from "@layouts/BaseLayout.astro";
import TechAdUnit from "@components/ads/TechAdUnit.astro";

const seo = {
  title: "Windows 11 Error Code Lookup & PowerShell Fixes",
  description: "Client-side Windows error decryptor. Look up Windows Update and BSoD error codes (0x8024200d, 0x101) and copy verified PowerShell repair scripts.",
  keywords: "windows error code lookup, windows 11 error decryptor, 0x8024200d fix, powershell repair script, bsod error lookup, windows update error generator",
};
---

<BaseLayout seo={seo}>
  <div class="mx-auto max-w-5xl px-4 py-12">
    <!-- Header -->
    <div class="mb-10 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-brand-500/20 bg-brand-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-400 mb-4">
        🛠️ Instant Diagnostic Tool
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl lg:text-5xl text-text dark:text-text-dark">
        Windows Error Code Decryptor & PowerShell Fixer
      </h1>
      <p class="mt-4 text-base sm:text-lg text-text-muted dark:text-text-dark-muted max-w-3xl mx-auto">
        Search any Windows Update error code or Blue Screen (BSoD) stop code. Get instant plain-English root causes and copy-paste ready, administrator-validated PowerShell repair commands.
      </p>
    </div>

    <!-- Search & Filter Bar -->
    <div class="mb-8 rounded-2xl border border-border bg-surface p-6 shadow-sm dark:border-border-dark dark:bg-surface-dark">
      <div class="relative">
        <input
          type="text"
          id="error-search"
          placeholder="Type an error code (e.g., 0x8024200d, 0x80070002, CLOCK_WATCHDOG_TIMEOUT)..."
          class="w-full rounded-xl border border-border bg-surface-alt px-5 py-4 pl-12 text-base font-medium text-text shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20 dark:border-border-dark dark:bg-surface-dark-alt dark:text-text-dark"
        />
        <span class="absolute left-4 top-4 text-xl text-text-muted dark:text-text-dark-muted">🔍</span>
      </div>

      <!-- Quick Preset Tags -->
      <div class="mt-4 flex flex-wrap items-center gap-2 text-xs">
        <span class="font-semibold text-text-muted dark:text-text-dark-muted">Common Errors:</span>
        <button type="button" class="preset-btn rounded-lg bg-surface-alt dark:bg-surface-dark-alt px-2.5 py-1 border border-border dark:border-border-dark text-text dark:text-text-dark hover:border-brand-500 transition-colors cursor-pointer" data-code="0x124">WHEA (0x124)</button>
        <button type="button" class="preset-btn rounded-lg bg-surface-alt dark:bg-surface-dark-alt px-2.5 py-1 border border-border dark:border-border-dark text-text dark:text-text-dark hover:border-brand-500 transition-colors cursor-pointer" data-code="0x116">VIDEO_TDR (0x116)</button>
        <button type="button" class="preset-btn rounded-lg bg-surface-alt dark:bg-surface-dark-alt px-2.5 py-1 border border-border dark:border-border-dark text-text dark:text-text-dark hover:border-brand-500 transition-colors cursor-pointer" data-code="0x101">CLOCK_WATCHDOG (0x101)</button>
        <button type="button" class="preset-btn rounded-lg bg-surface-alt dark:bg-surface-dark-alt px-2.5 py-1 border border-border dark:border-border-dark text-text dark:text-text-dark hover:border-brand-500 transition-colors cursor-pointer" data-code="0x133">DPC_WATCHDOG (0x133)</button>
        <button type="button" class="preset-btn rounded-lg bg-surface-alt dark:bg-surface-dark-alt px-2.5 py-1 border border-border dark:border-border-dark text-text dark:text-text-dark hover:border-brand-500 transition-colors cursor-pointer" data-code="0x50">PAGE_FAULT (0x50)</button>
        <button type="button" class="preset-btn rounded-lg bg-surface-alt dark:bg-surface-dark-alt px-2.5 py-1 border border-border dark:border-border-dark text-text dark:text-text-dark hover:border-brand-500 transition-colors cursor-pointer" data-code="0x1e">KMODE (0x1e)</button>
        <button type="button" class="preset-btn rounded-lg bg-surface-alt dark:bg-surface-dark-alt px-2.5 py-1 border border-border dark:border-border-dark text-text dark:text-text-dark hover:border-brand-500 transition-colors cursor-pointer" data-code="0x3b">SYSTEM_SERVICE (0x3b)</button>
        <button type="button" class="preset-btn rounded-lg bg-surface-alt dark:bg-surface-dark-alt px-2.5 py-1 border border-border dark:border-border-dark text-text dark:text-text-dark hover:border-brand-500 transition-colors cursor-pointer" data-code="0xd1">DRIVER_IRQL (0xd1)</button>
        <button type="button" class="preset-btn rounded-lg bg-surface-alt dark:bg-surface-dark-alt px-2.5 py-1 border border-border dark:border-border-dark text-text dark:text-text-dark hover:border-brand-500 transition-colors cursor-pointer" data-code="KB5121003">KB5121003</button>
        <button type="button" class="preset-btn rounded-lg bg-surface-alt dark:bg-surface-dark-alt px-2.5 py-1 border border-border dark:border-border-dark text-text dark:text-text-dark hover:border-brand-500 transition-colors cursor-pointer" data-code="0x8024200d">0x8024200d</button>
        <button type="button" class="preset-btn rounded-lg bg-surface-alt dark:bg-surface-dark-alt px-2.5 py-1 border border-border dark:border-border-dark text-text dark:text-text-dark hover:border-brand-500 transition-colors cursor-pointer" data-code="0x80070002">0x80070002</button>
        <button type="button" class="preset-btn rounded-lg bg-surface-alt dark:bg-surface-dark-alt px-2.5 py-1 border border-border dark:border-border-dark text-text dark:text-text-dark hover:border-brand-500 transition-colors cursor-pointer" data-code="0x80070005">0x80070005</button>
        <button type="button" class="preset-btn rounded-lg bg-surface-alt dark:bg-surface-dark-alt px-2.5 py-1 border border-border dark:border-border-dark text-text dark:text-text-dark hover:border-brand-500 transition-colors cursor-pointer" data-code="0x800f081f">0x800f081f</button>
      </div>
    </div>

    <!-- Active Result Container -->
    <div id="result-container" class="space-y-6">
      <!-- Dynamic Javascript Content Injected Here -->
    </div>

    <!-- Empty State -->
    <div id="empty-state" class="hidden text-center py-12">
      <div class="text-4xl mb-3">🧩</div>
      <p class="text-lg font-bold text-text dark:text-text-dark">Error code not in instant cache</p>
      <p class="text-sm text-text-muted dark:text-text-dark-muted mt-1 max-w-md mx-auto">
        We add new error codes daily based on Windows telemetry. Check our in-depth guides below or try searching by hex code (e.g., 0x8024200d or 0x124).
      </p>
    </div>

    <!-- Related Diagnostic Guides -->
    <div class="mt-16 border-t border-border dark:border-border-dark pt-10">
      <h2 class="text-xl font-bold text-text dark:text-text-dark mb-4">Related In-Depth Diagnostic Guides</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <a href="/blog/how-to-fix-whea-uncorrectable-error-0x124-windows-11" class="rounded-xl border border-brand-500/30 bg-brand-500/5 p-4 dark:border-brand-500/30 dark:bg-brand-500/10 hover:border-brand-500 transition-colors">
          <div class="font-bold text-brand-600 dark:text-brand-400 text-sm">WHEA_UNCORRECTABLE_ERROR (0x124) Diagnostic Guide &rarr;</div>
          <div class="text-xs text-text-muted dark:text-text-dark-muted mt-1">Decode Event ID 18/17, triage CPU VCORE droop, and fix PCIe AER NVMe drops.</div>
        </a>
        <a href="/blog/how-to-fix-nvlddmkm-event-id-153-gpu-crashes" class="rounded-xl border border-border bg-surface-alt p-4 dark:border-border-dark dark:bg-surface-dark-alt hover:border-brand-500 transition-colors">
          <div class="font-bold text-text dark:text-text-dark text-sm">NVIDIA nvlddmkm Event ID 153 & TDR 0x116 Fix &rarr;</div>
          <div class="text-xs text-text-muted dark:text-text-dark-muted mt-1">Resolve GPU timeout crashes, power limits, and PCIe driver resets.</div>
        </a>
        <a href="/blog/fix-windows-11-update-errors-2026-troubleshooting" class="rounded-xl border border-border bg-surface-alt p-4 dark:border-border-dark dark:bg-surface-dark-alt hover:border-brand-500 transition-colors">
          <div class="font-bold text-text dark:text-text-dark text-sm">Complete Windows Update Error Troubleshooting (2026) &rarr;</div>
          <div class="text-xs text-text-muted dark:text-text-dark-muted mt-1">Step-by-step resolution for stalled updates, DISM failures, and CBS errors.</div>
        </a>
        <a href="/blog/how-to-fix-windows-11-kb5121003-inpoutx64-crash" class="rounded-xl border border-border bg-surface-alt p-4 dark:border-border-dark dark:bg-surface-dark-alt hover:border-brand-500 transition-colors">
          <div class="font-bold text-text dark:text-text-dark text-sm">Fix KB5121003 inpoutx64.sys Crash on Windows 11 &rarr;</div>
          <div class="text-xs text-text-muted dark:text-text-dark-muted mt-1">Mitigate vulnerable Ring 0 RGB hardware polling drivers and memory traps.</div>
        </a>
        <a href="/blog/pc-keeps-crashing-how-to-tell-if-it-s-a-ram-issue-or-a-bad-driver" class="rounded-xl border border-border bg-surface-alt p-4 dark:border-border-dark dark:bg-surface-dark-alt hover:border-brand-500 transition-colors">
          <div class="font-bold text-text dark:text-text-dark text-sm">RAM Issue vs Bad Driver Crash Diagnostic Guide &rarr;</div>
          <div class="text-xs text-text-muted dark:text-text-dark-muted mt-1">Distinguish memory parity errors from kernel-mode driver faults.</div>
        </a>
        <a href="/blog/windows-11-search-not-working-12-proven-fixes-for-2026" class="rounded-xl border border-border bg-surface-alt p-4 dark:border-border-dark dark:bg-surface-dark-alt hover:border-brand-500 transition-colors">
          <div class="font-bold text-text dark:text-text-dark text-sm">Windows 11 Search Not Working? 12 Proven Fixes &rarr;</div>
          <div class="text-xs text-text-muted dark:text-text-dark-muted mt-1">Repair SearchHost, rebuild indexing databases, and clear cache.</div>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  const ERROR_DATABASE = [
    {
      code: "0x124",
      name: "WHEA_UNCORRECTABLE_ERROR",
      category: "Hardware Kernel Fault (BSoD)",
      severity: "Fatal BSoD",
      cause: "Windows Hardware Error Architecture (WHEA) caught an uncorrectable hardware exception. Parameter 1 indicates the component: 0x0 is CPU Machine Check Architecture (Event ID 18, CPU VCORE droop/microcode), 0x4 is PCIe Advanced Error Reporting (Event ID 17, NVMe SSD drop or GPU slot sag).",
      steps: [
        "Audit Event Viewer: Applications and Services Logs -> Microsoft -> Windows -> WHEA-Logger.",
        "Event ID 18: Update motherboard BIOS (Intel 0x12B / AMD AGESA 1.2.0.2) and enforce Intel Default Power Limits (PL1/PL2).",
        "Event ID 17: Reseat M.2 NVMe SSD in CPU PCIe slot or install GPU anti-sag bracket.",
        "Run PowerShell hardware telemetry audit to dump recent WHEA error events."
      ],
      powershell: `# Run in Administrator PowerShell - WHEA Hardware Telemetry Audit
Get-WinEvent -FilterHashtable @{LogName='System'; ProviderName='Microsoft-Windows-WHEA-Logger'} -MaxEvents 20 -ErrorAction SilentlyContinue |
    Select-Object TimeCreated, Id, LevelDisplayName, Message | Format-List
Write-Host "Review WHEA events above. Event ID 18 = CPU MCA; Event ID 17 = PCIe AER." -ForegroundColor Yellow`,
      guideUrl: "/blog/how-to-fix-whea-uncorrectable-error-0x124-windows-11"
    },
    {
      code: "0x116",
      name: "VIDEO_TDR_FAILURE",
      category: "Display Driver & GPU (BSoD)",
      severity: "Critical BSoD",
      cause: "Graphics driver failed to respond to the DirectX Graphics Kernel (dxgkrnl.sys) within the 2-second Timeout Detection and Recovery (TDR) window. Triggered by nvlddmkm.sys (NVIDIA) or amdkmdag.sys (AMD) corruption, PCIe power state ASPM drops, or 12VHPWR voltage droop.",
      steps: [
        "Clean reinstall GPU drivers in Windows Safe Mode using Display Driver Uninstaller (DDU).",
        "Check NVIDIA Event ID 153/13 errors in System event log.",
        "Disable PCIe Link State Power Management (ASPM) in Windows Power Plan.",
        "Verify GPU 12VHPWR / 8-pin PCIe power cable seating."
      ],
      powershell: `# Run in Administrator PowerShell - GPU Driver & TDR Health Check
Get-WinEvent -FilterHashtable @{LogName='System'; ProviderName='nvlddmkm'} -MaxEvents 15 -ErrorAction SilentlyContinue |
    Select-Object TimeCreated, Id, Message | Format-Table -AutoSize
powercfg -setacvalueindex SCHEME_CURRENT SUB_PCIEXPRESS ASPM 0
powercfg -setactive SCHEME_CURRENT
Write-Host "✅ PCIe Link State Power Management disabled (ASPM=Off) to prevent GPU TDR drops!" -ForegroundColor Green`,
      guideUrl: "/blog/how-to-fix-nvlddmkm-event-id-153-gpu-crashes"
    },
    {
      code: "KB5121003",
      name: "WINDOWS_11_KB5121003_INPOUTX64_CRASH",
      category: "Vulnerable Kernel Driver Trap",
      severity: "High",
      cause: "Windows 11 KB5121003 update enforces strict Kernel-mode Code Integrity (KMCI) and Hypervisor-protected Code Integrity (HVCI). Legacy RGB software (iCUE, Armoury Crate, RGB Fusion) loading unsigned or vulnerable inpoutx64.sys Ring 0 drivers triggers immediate PAGE_FAULT or system freezing.",
      steps: [
        "Identify and terminate third-party motherboard and peripheral RGB sync services.",
        "Purge vulnerable inpoutx64.sys and WinRing0x64.sys binaries from Drivers and SysWOW64 directories.",
        "Re-enable Windows Core Isolation and Memory Integrity (HVCI) cleanly."
      ],
      powershell: `# Run in Administrator PowerShell - Locate and isolate vulnerable inpoutx64 driver
Get-ChildItem -Path "C:\\Windows\\System32\\drivers", "C:\\Windows\\SysWOW64" -Filter "*inpout*.sys" -Recurse -ErrorAction SilentlyContinue |
    Select-Object FullName, Length, LastWriteTime
Stop-Process -Name "OpenRGB", "LightingService" -ErrorAction SilentlyContinue
Write-Host "Inspect driver paths above. Rename inpoutx64.sys to inpoutx64.sys.bak to prevent Ring 0 crash." -ForegroundColor Yellow`,
      guideUrl: "/blog/how-to-fix-windows-11-kb5121003-inpoutx64-crash"
    },
    {
      code: "KB5124008",
      name: "WINDOWS_11_25H2_UPDATE_FAIL",
      category: "Windows 11 25H2 Upgrade",
      severity: "High",
      cause: "Windows 11 Version 25H2 update (Build 26200.9445 via KB5124008) stalls at 0%, 25%, or 100% install loop due to servicing stack locks or component store staging conflicts.",
      steps: [
        "Stop Windows Update, BITS, and Cryptographic background services.",
        "Clear corrupted SoftwareDistribution staging cache.",
        "Execute DISM StartComponentCleanup to clear servicing stack locks.",
        "Restart update services and force a clean scan using UsoClient."
      ],
      powershell: `# Run in Administrator PowerShell
Stop-Service -Name wuauserv, bits, cryptsvc -Force
Remove-Item -Path "$env:SystemRoot\\SoftwareDistribution\\Download\\*" -Recurse -Force -ErrorAction SilentlyContinue
dism.exe /Online /Cleanup-Image /StartComponentCleanup
dism.exe /Online /Cleanup-Image /RestoreHealth
Start-Service -Name wuauserv, bits, cryptsvc
UsoClient.exe StartScan
Write-Host "✅ Servicing stack cleared. KB5124008 (25H2) update restart initiated!" -ForegroundColor Green`,
      guideUrl: "/blog/fix-windows-11-update-errors-2026-troubleshooting"
    },
    {
      code: "0x8024200d",
      name: "WU_E_UH_NEEDUNPACKING",
      category: "Windows Update",
      severity: "High",
      cause: "Windows Update handler failed because the downloaded update payload or cab file was corrupted during download, preventing extraction into the component store.",
      steps: [
        "Stop Windows Update and Background Intelligent Transfer Service (BITS).",
        "Purge the corrupted SoftwareDistribution download cache directory.",
        "Execute DISM Component Cleanup to discard broken transaction manifests.",
        "Restart update services and initiate a clean update scan."
      ],
      powershell: `# Run in Administrator PowerShell
Stop-Service -Name wuauserv, bits, cryptsvc -Force
Remove-Item -Path "$env:SystemRoot\\SoftwareDistribution\\Download\\*" -Recurse -Force -ErrorAction SilentlyContinue
dism.exe /Online /Cleanup-Image /RestoreHealth
Start-Service -Name wuauserv, bits, cryptsvc
UsoClient.exe StartScan
Write-Host "✅ SoftwareDistribution cache purged. Update scan restarted!" -ForegroundColor Green`,
      guideUrl: "/blog/how-to-fix-windows-11-update-error-0x8024200d"
    },
    {
      code: "0x80070002",
      name: "ERROR_FILE_NOT_FOUND",
      category: "Windows Update",
      severity: "Medium",
      cause: "Windows Update cannot locate a critical manifest or delta payload referenced in the registry. Often caused by aggressive cleaner utilities deleting temporary staging files.",
      steps: [
        "Stop Cryptographic and Windows Update services.",
        "Rename the Catroot2 transaction catalog folder.",
        "Run System File Checker (SFC) to restore missing system DLLs.",
        "Re-register Windows Update engine DLLs."
      ],
      powershell: `# Run in Administrator PowerShell
Stop-Service -Name cryptsvc, wuauserv -Force
Rename-Item -Path "$env:SystemRoot\\System32\\catroot2" -NewName "catroot2.old" -Force -ErrorAction SilentlyContinue
sfc /scannow
Start-Service -Name cryptsvc, wuauserv
Write-Host "✅ Catroot2 catalog rebuilt and SFC scan executed!" -ForegroundColor Green`,
      guideUrl: "/blog/fix-windows-11-update-errors-2026-troubleshooting"
    },
    {
      code: "0x80070005",
      name: "ERROR_ACCESS_DENIED",
      category: "Windows Update & Permissions",
      severity: "High",
      cause: "Windows Update or DISM was denied access to update staging registries or component folders. Typically caused by third-party antivirus file locking, corrupted ACLs on %windir%, or group policy blocks.",
      steps: [
        "Temporarily disable third-party antivirus real-time shields during servicing.",
        "Reset Windows Update registry and folder security descriptors using SubInACL or PowerShell icacls.",
        "Run DISM RestoreHealth under elevated SYSTEM context."
      ],
      powershell: `# Run in Administrator PowerShell
icacls "$env:SystemRoot\\SoftwareDistribution" /grant "NT AUTHORITY\\SYSTEM":(OI)(CI)F /T
icacls "$env:SystemRoot\\System32\\catroot2" /grant "NT AUTHORITY\\SYSTEM":(OI)(CI)F /T
dism.exe /Online /Cleanup-Image /RestoreHealth
Write-Host "✅ SYSTEM access permissions restored on update directories." -ForegroundColor Green`,
      guideUrl: "/blog/fix-windows-11-update-errors-2026-troubleshooting"
    },
    {
      code: "0x80070422",
      name: "ERROR_SERVICE_DISABLED",
      category: "Windows Update",
      severity: "Medium",
      cause: "The Windows Update service (wuauserv) or its prerequisite dependencies (BITS, DCOM, Cryptographic Services) have been explicitly disabled in the Service Control Manager.",
      steps: [
        "Configure wuauserv startup type to Automatic.",
        "Configure BITS startup type to Automatic (Delayed Start).",
        "Enable Cryptographic Services.",
        "Start all three services immediately."
      ],
      powershell: `# Run in Administrator PowerShell
Set-Service -Name wuauserv -StartupType Automatic
Set-Service -Name bits -StartupType Automatic
Set-Service -Name cryptsvc -StartupType Automatic
Start-Service -Name wuauserv, bits, cryptsvc
Write-Host "✅ Required Windows Update services enabled and started!" -ForegroundColor Green`,
      guideUrl: "/blog/fix-windows-11-update-errors-2026-troubleshooting"
    },
    {
      code: "0x800f081f",
      name: "CBS_E_SOURCE_MISSING",
      category: "DISM & Component Store",
      severity: "Critical",
      cause: "The files required to service a Windows feature (.NET Framework 3.5 or Cumulative Update) are missing from the local WinSxS component store and cannot be retrieved via Windows Update.",
      steps: [
        "Run DISM online health check to evaluate store integrity.",
        "Mount a matching Windows 11 ISO if working in an offline environment.",
        "Execute DISM RestoreHealth pointing to live Microsoft servers or mounted WIM.",
        "Run SFC scan to repair linked permissions."
      ],
      powershell: `# Run in Administrator PowerShell
dism.exe /Online /Cleanup-Image /StartComponentCleanup
dism.exe /Online /Cleanup-Image /RestoreHealth
sfc /scannow
Write-Host "✅ WinSxS Component Store successfully verified and restored!" -ForegroundColor Green`,
      guideUrl: "/blog/how-to-fix-windows-11-update-errors-in-2026-complete-troubleshooting-guide"
    },
    {
      code: "0x101",
      name: "CLOCK_WATCHDOG_TIMEOUT",
      category: "Blue Screen (BSoD)",
      severity: "Critical BSoD",
      cause: "An expected clock interrupt on a secondary processor core was not delivered within the allocated interval. Indicates unstable CPU undervolt/overclock, outdated motherboard BIOS microcode, or deadlocked kernel threads.",
      steps: [
        "Reset BIOS/UEFI overclocking, PBO, or undervolting profiles to defaults.",
        "Update motherboard BIOS to the latest microcode AGESA/Intel firmware.",
        "Audit chipset drivers directly from AMD or Intel support.",
        "Run Windows Memory Diagnostic to confirm DDR4/DDR5 stability."
      ],
      powershell: `# Run in Administrator PowerShell
Get-CimInstance -ClassName Win32_BIOS | Select-Object Manufacturer, SMBIOSBIOSVersion, ReleaseDate
powercfg /setactive scheme_balanced
mdsched.exe
Write-Host "✅ BIOS info logged and memory diagnostic scheduled for next system restart!" -ForegroundColor Green`,
      guideUrl: "/blog/pc-keeps-crashing-how-to-tell-if-it-s-a-ram-issue-or-a-bad-driver"
    },
    {
      code: "0x133",
      name: "DPC_WATCHDOG_VIOLATION",
      category: "Blue Screen (BSoD)",
      severity: "Critical BSoD",
      cause: "A Deferred Procedure Call (DPC) routine ran longer than allowed. Typically triggered by outdated NVMe SSD firmware, incompatible SATA AHCI controllers, or corrupt graphics drivers.",
      steps: [
        "Replace manufacturer-specific storage controller drivers with Microsoft Standard NVMe Controller.",
        "Update SSD firmware using Samsung Magician, WD Dashboard, or Crucial Storage Executive.",
        "Run Clean GPU driver reinstallation using Display Driver Uninstaller (DDU)."
      ],
      powershell: `# Run in Administrator PowerShell
Get-PhysicalDisk | Select-Object DeviceId, FriendlyName, MediaType, OperationalStatus, FirmwareVersion
Get-StorageReliabilityCounter | Select-Object DeviceId, ReadErrorsTotal, WriteErrorsTotal, Wear
Write-Host "Review disk reliability counters above for hardware failure." -ForegroundColor Cyan`,
      guideUrl: "/blog/pc-keeps-crashing-how-to-tell-if-it-s-a-ram-issue-or-a-bad-driver"
    },
    {
      code: "0x50",
      name: "PAGE_FAULT_IN_NONPAGED_AREA",
      category: "Blue Screen (BSoD)",
      severity: "Critical BSoD",
      cause: "Invalid system memory was referenced. Memory addresses point to RAM that does not exist or has encountered hardware parity bit-flips, or an antivirus kernel filter driver requested illegal memory.",
      steps: [
        "Run Memory Diagnostic test across all RAM channels.",
        "Disable automated virtual memory paging file, reboot, and re-enable it to clear corrupt pagefile.sys.",
        "Run Check Disk (chkdsk) to scan for NTFS file system structure corruptions."
      ],
      powershell: `# Run in Administrator PowerShell
chkdsk C: /f /r
Write-Host "Schedule disk volume check on next reboot..." -ForegroundColor Yellow`,
      guideUrl: "/blog/pc-keeps-crashing-how-to-tell-if-it-s-a-ram-issue-or-a-bad-driver"
    },
    {
      code: "0x1e",
      name: "KMODE_EXCEPTION_NOT_HANDLED",
      category: "Kernel Driver & Memory (BSoD)",
      severity: "Critical BSoD",
      cause: "A kernel-mode program generated an exception that the error handler did not catch. Commonly caused by faulty third-party drivers (antivirus, network, or RGB software) or memory parity errors.",
      steps: [
        "Identify the offending .sys driver in memory dump via WhoCrashed or WinDbg.",
        "Test RAM modules individually using MemTest86 or Windows Memory Diagnostic.",
        "Boot into Safe Mode and roll back recently installed device drivers."
      ],
      powershell: `# Run in Administrator PowerShell - Dump recent BugCheck 0x1E crash events
Get-WinEvent -FilterHashtable @{LogName='System'; ProviderName='Microsoft-Windows-WER-SystemErrorReporting'} -MaxEvents 10 -ErrorAction SilentlyContinue |
    Select-Object TimeCreated, Message | Format-List
sfc /scannow`,
      guideUrl: "/blog/pc-keeps-crashing-how-to-tell-if-it-s-a-ram-issue-or-a-bad-driver"
    },
    {
      code: "0x3b",
      name: "SYSTEM_SERVICE_EXCEPTION",
      category: "System Kernel & Graphics (BSoD)",
      severity: "Critical BSoD",
      cause: "An exception occurred while executing a routine that transitions from non-privileged to privileged code. Most frequently caused by corrupted GUI subsystem drivers (win32kbase.sys) or graphics card drivers.",
      steps: [
        "Run Display Driver Uninstaller (DDU) in Safe Mode and install the latest WHQL graphics drivers.",
        "Scan system binaries using System File Checker (SFC).",
        "Check RAM sticks for timing instability or XMP/EXPO overclocking errors."
      ],
      powershell: `# Run in Administrator PowerShell
dism.exe /Online /Cleanup-Image /RestoreHealth
sfc /scannow
Write-Host "✅ System file repair sequence completed." -ForegroundColor Green`,
      guideUrl: "/blog/pc-keeps-crashing-how-to-tell-if-it-s-a-ram-issue-or-a-bad-driver"
    },
    {
      code: "0x7e",
      name: "SYSTEM_THREAD_EXCEPTION_NOT_HANDLED",
