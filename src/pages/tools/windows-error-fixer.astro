  function buildRedditMarkdown(err) {
    const cleanUrl = "https://praveentechworld.com/tools/windows-error-fixer?code=" + encodeURIComponent(err.code);
    return `**Windows Error ${err.code} (${err.name})**
> **Root Cause**: ${err.cause}

**Recommended Administrator PowerShell Fix**:
\`\`\`powershell
${err.powershell}
\`\`\`

🔗 *Diagnostic Runbook & Telemetry Steps*: [PraveenTechWorld Windows Error Decryptor](${cleanUrl})`;
  }

  function renderErrorCards(matches) {
    const container = document.getElementById("result-container");
    const emptyState = document.getElementById("empty-state");

    if (matches.length === 0) {
      container.innerHTML = "";
      emptyState.classList.remove("hidden");
      return;
    }

    emptyState.classList.add("hidden");
    container.innerHTML = matches.map(err => {
      const shareUrl = "https://praveentechworld.com/tools/windows-error-fixer?code=" + encodeURIComponent(err.code);
      const redditMd = buildRedditMarkdown(err);

      return `
      <div id="error-card-${err.code.replace(/[^a-zA-Z0-9]/g, '_')}" class="rounded-2xl border border-border bg-surface p-6 shadow-sm dark:border-border-dark dark:bg-surface-dark transition-all">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border dark:border-border-dark pb-4 mb-4">
          <div class="flex items-center gap-3">
            <span class="rounded-lg bg-brand-500/10 text-brand-600 dark:text-brand-400 font-mono font-bold text-lg px-3 py-1 border border-brand-500/20">
              ${err.code}
            </span>
            <div>
              <div class="font-bold text-text dark:text-text-dark text-base">${err.name}</div>
              <div class="text-xs text-text-muted dark:text-text-dark-muted">${err.category} • Severity: <span class="font-semibold text-rose-500">${err.severity}</span></div>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <button
              type="button"
              class="reddit-copy-btn inline-flex items-center gap-1.5 rounded-lg border border-orange-500/30 bg-orange-500/10 px-2.5 py-1 text-xs font-semibold text-orange-600 dark:text-orange-400 hover:bg-orange-500/20 transition cursor-pointer"
              data-reddit="${encodeURIComponent(redditMd)}"
              title="Copy pre-formatted Reddit answer with diagnostic link"
            >
              <span>📋</span> Copy Reddit Markdown
            </button>
            <button
              type="button"
              class="link-copy-btn inline-flex items-center gap-1 rounded-lg border border-border dark:border-border-dark bg-surface-alt dark:bg-surface-dark-alt px-2 py-1 text-xs font-medium text-text-muted dark:text-text-dark-muted hover:border-brand-500 hover:text-brand-600 transition cursor-pointer"
              data-link="${shareUrl}"
              title="Copy direct permalink"
            >
              <span>🔗</span> Link
            </button>
            ${err.guideUrl ? `
              <a href="${err.guideUrl}" class="inline-flex items-center gap-1 text-xs font-bold text-brand-600 dark:text-brand-400 hover:underline ml-1">
                <span>Runbook &rarr;</span>
              </a>
            ` : ''}
          </div>
        </div>

        <div class="mb-4">
          <h4 class="text-xs font-bold uppercase tracking-wider text-text-muted dark:text-text-dark-muted mb-1">Root Cause Diagnosis</h4>
          <p class="text-sm text-text dark:text-text-dark leading-relaxed">${err.cause}</p>
        </div>

        <div class="mb-5">
          <h4 class="text-xs font-bold uppercase tracking-wider text-text-muted dark:text-text-dark-muted mb-2">Recommended IT Action</h4>
          <ul class="list-disc pl-5 text-sm text-text-muted dark:text-text-dark-muted space-y-1">
            ${err.steps.map(step => `<li>${step}</li>`).join('')}
          </ul>
        </div>

        <div>
          <div class="flex items-center justify-between mb-2">
            <h4 class="text-xs font-bold uppercase tracking-wider text-brand-600 dark:text-brand-400 flex items-center gap-1.5">
              <span>⚡</span> 1-Click Administrator PowerShell Fix
            </h4>
            <button
              type="button"
              class="copy-btn text-xs font-semibold px-2.5 py-1 rounded bg-brand-500/10 hover:bg-brand-500/20 text-brand-600 dark:text-brand-400 transition-colors cursor-pointer"
              data-clipboard="${encodeURIComponent(err.powershell)}"
            >
              📋 Copy Script
            </button>
          </div>
          <pre class="overflow-x-auto rounded-xl bg-slate-950 p-4 font-mono text-xs text-slate-200 border border-slate-800"><code>${err.powershell.replace(/</g, "&lt;").replace(/>/g, "&gt;")}</code></pre>
        </div>
      </div>
      `;
    }).join('');

    // Attach copy PowerShell script listeners
    document.querySelectorAll(".copy-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const text = decodeURIComponent(btn.getAttribute("data-clipboard"));
        navigator.clipboard.writeText(text).then(() => {
          const originalText = btn.innerHTML;
          btn.innerHTML = "✅ Copied!";
          setTimeout(() => { btn.innerHTML = originalText; }, 2000);
        });
      });
    });

    // Attach Copy Reddit Markdown listeners
    document.querySelectorAll(".reddit-copy-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const text = decodeURIComponent(btn.getAttribute("data-reddit"));
        navigator.clipboard.writeText(text).then(() => {
          const originalText = btn.innerHTML;
          btn.innerHTML = "✅ Copied Reddit Markdown!";
          setTimeout(() => { btn.innerHTML = originalText; }, 2000);
        });
      });
    });

    // Attach Copy Link listeners
    document.querySelectorAll(".link-copy-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const link = btn.getAttribute("data-link");
        navigator.clipboard.writeText(link).then(() => {
          const originalText = btn.innerHTML;
          btn.innerHTML = "✅ Copied!";
          setTimeout(() => { btn.innerHTML = originalText; }, 2000);
        });
      });
    });
  }

  function syncUrlParam(code) {
    const newUrl = new URL(window.location.href);
    if (code && code.trim().length > 0) {
      newUrl.searchParams.set("code", code.trim());
    } else {
      newUrl.searchParams.delete("code");
      newUrl.searchParams.delete("q");
    }
    window.history.replaceState(null, "", newUrl.toString());
  }

  function filterErrors(query) {
    const q = query.trim().toLowerCase();
    if (!q) {
      renderErrorCards(ERROR_DATABASE);
      syncUrlParam("");
      return;
    }

    const matches = ERROR_DATABASE.filter(err => 
      err.code.toLowerCase().includes(q) ||
      err.name.toLowerCase().includes(q) ||
      err.category.toLowerCase().includes(q) ||
      err.cause.toLowerCase().includes(q)
    );

    renderErrorCards(matches);
    syncUrlParam(query);
  }

  document.addEventListener("DOMContentLoaded", () => {
    const searchInput = document.getElementById("error-search");
    
    // Check for URL Query Param (?code=... or ?q=...)
    const params = new URLSearchParams(window.location.search);
    const initialCode = params.get("code") || params.get("q");

    if (initialCode) {
      searchInput.value = initialCode;
      filterErrors(initialCode);
      setTimeout(() => {
        const container = document.getElementById("result-container");
        if (container && container.firstElementChild) {
          container.firstElementChild.scrollIntoView({ behavior: "smooth", block: "center" });
        }
      }, 100);
    } else {
      renderErrorCards(ERROR_DATABASE);
    }

    // Search Input Listener
    searchInput.addEventListener("input", (e) => {
      filterErrors(e.target.value);
    });

    // Preset Button Listeners
    document.querySelectorAll(".preset-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const code = btn.getAttribute("data-code");
        searchInput.value = code;
        filterErrors(code);
      });
    });
  });
</script>
