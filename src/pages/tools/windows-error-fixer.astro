---
import BaseLayout from "@layouts/BaseLayout.astro";
import TechAdUnit from "@components/ads/TechAdUnit.astro";

const seo = {
  title: "Windows 11 Error Code Lookup & PowerShell Fix Generator (2026)",
  description: "Instant client-side Windows error code decryptor. Search any Windows Update or BSoD error code (0x8024200d, 0x80070002, 0x101) and copy 1-click PowerShell repair scripts.",
  keywords: "windows error code lookup, windows 11 error decryptor, 0x8024200d fix, powershell repair script, bsod error lookup, windows update error generator",
};
---

<BaseLayout seo={seo}>
  <div class="mx-auto max-w-5xl px-4 py-12">
    <!-- Header -->
    <div class="mb-10 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-brand-500/20 bg-brand-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-400 mb-4">
        🛠️ Instant Diagnostic Tool
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl lg:text-5xl text-text dark:text-text-dark">
        Windows Error Code Decryptor & PowerShell Fixer
      </h1>
      <p class="mt-4 text-base sm:text-lg text-text-muted dark:text-text-dark-muted max-w-3xl mx-auto">
        Search any Windows Update error code or Blue Screen (BSoD) stop code. Get instant plain-English root causes and copy-paste ready, administrator-validated PowerShell repair commands.
      </p>
    </div>

    <!-- Search & Filter Bar -->
    <div class="mb-8 rounded-2xl border border-border bg-surface p-6 shadow-sm dark:border-border-dark dark:bg-surface-dark">
      <div class="relative">
        <input
          type="text"
          id="error-search"
          placeholder="Type an error code (e.g., 0x8024200d, 0x80070002, CLOCK_WATCHDOG_TIMEOUT)..."
          class="w-full rounded-xl border border-border bg-surface-alt px-5 py-4 pl-12 text-base font-medium text-text shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20 dark:border-border-dark dark:bg-surface-dark-alt dark:text-text-dark"
        />
        <span class="absolute left-4 top-4 text-xl text-text-muted dark:text-text-dark-muted">🔍</span>
      </div>

      <!-- Quick Preset Tags -->
      <div class="mt-4 flex flex-wrap items-center gap-2 text-xs">
        <span class="font-semibold text-text-muted dark:text-text-dark-muted">Common Errors:</span>
        <button type="button" class="preset-btn rounded-lg bg-surface-alt dark:bg-surface-dark-alt px-2.5 py-1 border border-border dark:border-border-dark text-text dark:text-text-dark hover:border-brand-500 transition-colors cursor-pointer" data-code="0x8024200d">0x8024200d</button>
        <button type="button" class="preset-btn rounded-lg bg-surface-alt dark:bg-surface-dark-alt px-2.5 py-1 border border-border dark:border-border-dark text-text dark:text-text-dark hover:border-brand-500 transition-colors cursor-pointer" data-code="0x80070002">0x80070002</button>
        <button type="button" class="preset-btn rounded-lg bg-surface-alt dark:bg-surface-dark-alt px-2.5 py-1 border border-border dark:border-border-dark text-text dark:text-text-dark hover:border-brand-500 transition-colors cursor-pointer" data-code="0x80070422">0x80070422</button>
        <button type="button" class="preset-btn rounded-lg bg-surface-alt dark:bg-surface-dark-alt px-2.5 py-1 border border-border dark:border-border-dark text-text dark:text-text-dark hover:border-brand-500 transition-colors cursor-pointer" data-code="0x800f081f">0x800f081f</button>
        <button type="button" class="preset-btn rounded-lg bg-surface-alt dark:bg-surface-dark-alt px-2.5 py-1 border border-border dark:border-border-dark text-text dark:text-text-dark hover:border-brand-500 transition-colors cursor-pointer" data-code="0x101">CLOCK_WATCHDOG_TIMEOUT (0x101)</button>
        <button type="button" class="preset-btn rounded-lg bg-surface-alt dark:bg-surface-dark-alt px-2.5 py-1 border border-border dark:border-border-dark text-text dark:text-text-dark hover:border-brand-500 transition-colors cursor-pointer" data-code="0x133">DPC_WATCHDOG_VIOLATION (0x133)</button>
        <button type="button" class="preset-btn rounded-lg bg-surface-alt dark:bg-surface-dark-alt px-2.5 py-1 border border-border dark:border-border-dark text-text dark:text-text-dark hover:border-brand-500 transition-colors cursor-pointer" data-code="0x50">PAGE_FAULT_IN_NONPAGED_AREA</button>
      </div>
    </div>

    <!-- Active Result Container -->
    <div id="result-container" class="space-y-6">
      <!-- Dynamic Javascript Content Injected Here -->
    </div>

    <!-- Empty State -->
    <div id="empty-state" class="hidden text-center py-12">
      <div class="text-4xl mb-3">🧩</div>
      <h3 class="text-lg font-bold text-text dark:text-text-dark">No matching error code found</h3>
      <p class="text-sm text-text-muted dark:text-text-dark-muted mt-1 max-w-md mx-auto">
        Try searching by hexadecimal code (e.g., 0x8024) or plain-text symptom (e.g., Watchdog, Update, Driver).
      </p>
    </div>

    <!-- Bottom Guidance & Related Hub Links -->
    <div class="mt-16 rounded-2xl border border-border bg-surface p-8 shadow-sm dark:border-border-dark dark:bg-surface-dark">
      <h2 class="text-xl font-bold text-text dark:text-text-dark mb-4 flex items-center gap-2">
        <span>📖</span> Comprehensive Workbench Troubleshooting Guides
      </h2>
      <p class="text-sm text-text-muted dark:text-text-dark-muted mb-6 leading-relaxed">
        Need deeper diagnostics? Our team tested and documented reproducible sysadmin runbooks for severe system crashes:
      </p>
      <div class="grid gap-4 sm:grid-cols-2">
        <a href="/blog/how-to-fix-windows-11-update-error-0x8024200d" class="rounded-xl border border-border bg-surface-alt p-4 dark:border-border-dark dark:bg-surface-dark-alt hover:border-brand-500 transition-colors">
          <div class="font-bold text-text dark:text-text-dark text-sm">How to Fix Windows 11 Update Error 0x8024200d &rarr;</div>
          <div class="text-xs text-text-muted dark:text-text-dark-muted mt-1">Resolve component store corruptions and failed patch staging.</div>
        </a>
        <a href="/blog/windows-11-search-not-working-12-proven-fixes-for-2026" class="rounded-xl border border-border bg-surface-alt p-4 dark:border-border-dark dark:bg-surface-dark-alt hover:border-brand-500 transition-colors">
          <div class="font-bold text-text dark:text-text-dark text-sm">Windows 11 Search Not Working? 12 Proven Fixes &rarr;</div>
          <div class="text-xs text-text-muted dark:text-text-dark-muted mt-1">Repair SearchHost, rebuild indexing databases, and clear cache.</div>
        </a>
        <a href="/blog/pc-keeps-crashing-how-to-tell-if-it-s-a-ram-issue-or-a-bad-driver" class="rounded-xl border border-border bg-surface-alt p-4 dark:border-border-dark dark:bg-surface-dark-alt hover:border-brand-500 transition-colors">
          <div class="font-bold text-text dark:text-text-dark text-sm">RAM Issue vs Bad Driver Crash Diagnostic Guide &rarr;</div>
          <div class="text-xs text-text-muted dark:text-text-dark-muted mt-1">Distinguish memory parity errors from kernel-mode driver faults.</div>
        </a>
        <a href="/blog/technical-seo-checklist-for-beginners-fix-these-issues-to-rank-better" class="rounded-xl border border-border bg-surface-alt p-4 dark:border-border-dark dark:bg-surface-dark-alt hover:border-brand-500 transition-colors">
          <div class="font-bold text-text dark:text-text-dark text-sm">Technical SEO Checklist & Python Crawler Guide &rarr;</div>
          <div class="text-xs text-text-muted dark:text-text-dark-muted mt-1">Audit HTTP headers, canonical tags, and crawling bottlenecks.</div>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  const ERROR_DATABASE = [
    {
      code: "0x8024200d",
      name: "WU_E_UH_NEEDUNPACKING",
      category: "Windows Update",
      severity: "High",
      cause: "Windows Update handler failed because the downloaded update payload or cab file was corrupted during download, preventing extraction into the component store.",
      steps: [
        "Stop Windows Update and Background Intelligent Transfer Service (BITS).",
        "Purge the corrupted SoftwareDistribution download cache directory.",
        "Execute DISM Component Cleanup to discard broken transaction manifests.",
        "Restart update services and initiate a clean update scan."
      ],
      powershell: `# Run in Administrator PowerShell
Stop-Service -Name wuauserv, bits, cryptsvc -Force
Remove-Item -Path "$env:SystemRoot\\SoftwareDistribution\\Download\\*" -Recurse -Force -ErrorAction SilentlyContinue
dism.exe /Online /Cleanup-Image /RestoreHealth
Start-Service -Name wuauserv, bits, cryptsvc
UsoClient.exe StartScan
Write-Host "✅ SoftwareDistribution cache purged. Update scan restarted!" -ForegroundColor Green`,
      guideUrl: "/blog/how-to-fix-windows-11-update-error-0x8024200d"
    },
    {
      code: "0x80070002",
      name: "ERROR_FILE_NOT_FOUND",
      category: "Windows Update",
      severity: "Medium",
      cause: "Windows Update cannot locate a critical manifest or delta payload referenced in the registry. Often caused by aggressive third-party cleaner tools deleting temporary staging files.",
      steps: [
        "Stop the Cryptographic and Windows Update services.",
        "Rename the Catroot2 transaction catalog folder.",
        "Run System File Checker (SFC) to restore missing system DLLs.",
        "Re-register Windows Update engine DLLs."
      ],
      powershell: `# Run in Administrator PowerShell
Stop-Service -Name cryptsvc, wuauserv -Force
Rename-Item -Path "$env:SystemRoot\\System32\\catroot2" -NewName "catroot2.old" -Force -ErrorAction SilentlyContinue
sfc /scannow
Start-Service -Name cryptsvc, wuauserv
Write-Host "✅ Catroot2 catalog rebuilt and SFC scan executed!" -ForegroundColor Green`,
      guideUrl: "/blog/fix-windows-11-update-errors-2026-troubleshooting"
    },
    {
      code: "0x80070422",
      name: "ERROR_SERVICE_DISABLED",
      category: "Windows Update",
      severity: "Medium",
      cause: "The Windows Update service (wuauserv) or its prerequisite dependencies (Network Connection Service, DCOM, RPC) have been disabled in the Service Control Manager.",
      steps: [
        "Configure wuauserv startup type to Automatic.",
        "Configure BITS startup type to Automatic (Delayed Start).",
        "Enable Cryptographic Services.",
        "Start all three services immediately."
      ],
      powershell: `# Run in Administrator PowerShell
Set-Service -Name wuauserv -StartupType Automatic
Set-Service -Name bits -StartupType Automatic
Set-Service -Name cryptsvc -StartupType Automatic
Start-Service -Name wuauserv, bits, cryptsvc
Write-Host "✅ Required Windows Update services enabled and started!" -ForegroundColor Green`,
      guideUrl: "/blog/fix-windows-11-update-errors-2026-troubleshooting"
    },
    {
      code: "0x800f081f",
      name: "CBS_E_SOURCE_MISSING",
      category: "DISM & Component Store",
      severity: "Critical",
      cause: "The files required to service a Windows feature (.NET Framework 3.5 or Cumulative Update) are missing from the local WinSxS component store and cannot be retrieved via Windows Update.",
      steps: [
        "Run DISM online health check to evaluate store integrity.",
        "Mount a matching Windows 11 ISO if working in an offline enterprise environment.",
        "Execute DISM RestoreHealth pointing to live Microsoft servers or mounted WIM.",
        "Run SFC scan to repair linked permissions."
      ],
      powershell: `# Run in Administrator PowerShell
dism.exe /Online /Cleanup-Image /StartComponentCleanup
dism.exe /Online /Cleanup-Image /RestoreHealth
sfc /scannow
Write-Host "✅ WinSxS Component Store successfully verified and restored!" -ForegroundColor Green`,
      guideUrl: "/blog/how-to-fix-windows-11-update-errors-in-2026-complete-troubleshooting-guide"
    },
    {
      code: "CLOCK_WATCHDOG_TIMEOUT",
      name: "BugCheck 0x101",
      category: "Blue Screen (BSoD)",
      severity: "Critical",
      cause: "An expected clock interrupt on a secondary processor core was not delivered within the allocated interval. Indicates unstable CPU undervolt/overclock, outdated motherboard BIOS, or deadlocked kernel threads.",
      steps: [
        "Reset BIOS/UEFI overclocking, PBO (Precision Boost Overdrive), or undervolting profiles to defaults.",
        "Update motherboard BIOS to the latest microcode AGESA/Intel firmware.",
        "Audit chipset drivers directly from AMD or Intel support.",
        "Run Windows Memory Diagnostic to confirm DDR4/DDR5 stability."
      ],
      powershell: `# Run in Administrator PowerShell
Get-CimInstance -ClassName Win32_BIOS | Select-Object Manufacturer, SMBIOSBIOSVersion, ReleaseDate
Write-Host "Checking for CPU throttling and processor state..." -ForegroundColor Cyan
powercfg /setactive scheme_balanced
mdsched.exe
Write-Host "✅ Memory diagnostic scheduled for next system restart!" -ForegroundColor Green`,
      guideUrl: "/blog/pc-keeps-crashing-how-to-tell-if-it-s-a-ram-issue-or-a-bad-driver"
    },
    {
      code: "DPC_WATCHDOG_VIOLATION",
      name: "BugCheck 0x133",
      category: "Blue Screen (BSoD)",
      severity: "Critical",
      cause: "A Deferred Procedure Call (DPC) routine ran longer than allowed. Typically triggered by outdated NVMe SSD firmware, incompatible SATA AHCI controllers, or corrupt graphics drivers.",
      steps: [
        "Replace manufacturer-specific storage controller drivers with Microsoft Standard NVMe Controller.",
        "Update SSD firmware using Samsung Magician, WD Dashboard, or Crucial Storage Executive.",
        "Run Clean GPU driver reinstallation using Display Driver Uninstaller (DDU)."
      ],
      powershell: `# Run in Administrator PowerShell to inspect storage drivers
Get-PhysicalDisk | Select-Object DeviceId, FriendlyName, MediaType, OperationalStatus, FirmwareVersion
Get-StorageReliabilityCounter | Select-Object DeviceId, ReadErrorsTotal, WriteErrorsTotal, Wear
Write-Host "Review disk reliability counters above for hardware failure." -ForegroundColor Cyan`,
      guideUrl: "/blog/pc-keeps-crashing-how-to-tell-if-it-s-a-ram-issue-or-a-bad-driver"
    },
    {
      code: "PAGE_FAULT_IN_NONPAGED_AREA",
      name: "BugCheck 0x50",
      category: "Blue Screen (BSoD)",
      severity: "Critical",
      cause: "Invalid system memory was referenced. Memory addresses point to RAM that does not exist or has encountered hardware parity bit-flips, or an antivirus kernel filter driver requested illegal memory.",
      steps: [
        "Run Memory Diagnostic test across all RAM channels.",
        "Disable automated virtual memory paging file, reboot, and re-enable it to clear corrupt pagefile.sys.",
        "Run Check Disk (chkdsk) to scan for NTFS file system structure corruptions."
      ],
      powershell: `# Run in Administrator PowerShell
chkdsk C: /f /r
Write-Host "Schedule disk volume check on next reboot..." -ForegroundColor Yellow`,
      guideUrl: "/blog/pc-keeps-crashing-how-to-tell-if-it-s-a-ram-issue-or-a-bad-driver"
    }
  ];

  function renderErrorCards(matches) {
    const container = document.getElementById("result-container");
    const emptyState = document.getElementById("empty-state");

    if (matches.length === 0) {
      container.innerHTML = "";
      emptyState.classList.remove("hidden");
      return;
    }

    emptyState.classList.add("hidden");
    container.innerHTML = matches.map(err => `
      <div class="rounded-2xl border border-border bg-surface p-6 shadow-sm dark:border-border-dark dark:bg-surface-dark transition-all">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border dark:border-border-dark pb-4 mb-4">
          <div class="flex items-center gap-3">
            <span class="rounded-lg bg-brand-500/10 text-brand-600 dark:text-brand-400 font-mono font-bold text-lg px-3 py-1 border border-brand-500/20">
              ${err.code}
            </span>
            <div>
              <div class="font-bold text-text dark:text-text-dark text-base">${err.name}</div>
              <div class="text-xs text-text-muted dark:text-text-dark-muted">${err.category} • Severity: <span class="font-semibold text-rose-500">${err.severity}</span></div>
            </div>
          </div>
          ${err.guideUrl ? `
            <a href="${err.guideUrl}" class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-600 dark:text-brand-400 hover:underline">
              <span>Read Full Runbook</span>
              <span>&rarr;</span>
            </a>
          ` : ''}
        </div>

        <div class="mb-4">
          <h4 class="text-xs font-bold uppercase tracking-wider text-text-muted dark:text-text-dark-muted mb-1">Root Cause Diagnosis</h4>
          <p class="text-sm text-text dark:text-text-dark leading-relaxed">${err.cause}</p>
        </div>

        <div class="mb-5">
          <h4 class="text-xs font-bold uppercase tracking-wider text-text-muted dark:text-text-dark-muted mb-2">Recommended IT Action</h4>
          <ul class="list-disc pl-5 text-sm text-text-muted dark:text-text-dark-muted space-y-1">
            ${err.steps.map(step => `<li>${step}</li>`).join('')}
          </ul>
        </div>

        <div>
          <div class="flex items-center justify-between mb-2">
            <h4 class="text-xs font-bold uppercase tracking-wider text-brand-600 dark:text-brand-400 flex items-center gap-1.5">
              <span>⚡</span> 1-Click Administrator PowerShell Fix
            </h4>
            <button
              type="button"
              class="copy-btn text-xs font-semibold px-2.5 py-1 rounded bg-brand-500/10 hover:bg-brand-500/20 text-brand-600 dark:text-brand-400 transition-colors cursor-pointer"
              data-clipboard="${encodeURIComponent(err.powershell)}"
            >
              📋 Copy Script
            </button>
          </div>
          <pre class="overflow-x-auto rounded-xl bg-slate-950 p-4 font-mono text-xs text-slate-200 border border-slate-800"><code>${err.powershell.replace(/</g, "&lt;").replace(/>/g, "&gt;")}</code></pre>
        </div>
      </div>
    `).join('');

    // Attach copy button listeners
    document.querySelectorAll(".copy-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const text = decodeURIComponent(btn.getAttribute("data-clipboard"));
        navigator.clipboard.writeText(text).then(() => {
          const originalText = btn.innerHTML;
          btn.innerHTML = "✅ Copied!";
          setTimeout(() => {
            btn.innerHTML = originalText;
          }, 2000);
        });
      });
    });
  }

  function filterErrors(query) {
    const q = query.trim().toLowerCase();
    if (!q) {
      renderErrorCards(ERROR_DATABASE);
      return;
    }

    const matches = ERROR_DATABASE.filter(err => 
      err.code.toLowerCase().includes(q) ||
      err.name.toLowerCase().includes(q) ||
      err.category.toLowerCase().includes(q) ||
      err.cause.toLowerCase().includes(q)
    );

    renderErrorCards(matches);
  }

  document.addEventListener("DOMContentLoaded", () => {
    const searchInput = document.getElementById("error-search");
    
    // Initial Render
    renderErrorCards(ERROR_DATABASE);

    // Search Input Listener
    searchInput.addEventListener("input", (e) => {
      filterErrors(e.target.value);
    });

    // Preset Button Listeners
    document.querySelectorAll(".preset-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const code = btn.getAttribute("data-code");
        searchInput.value = code;
        filterErrors(code);
      });
    });
  });
</script>
