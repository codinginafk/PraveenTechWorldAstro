---
import BaseLayout from "@layouts/BaseLayout.astro";
import Icon from "@components/common/Icon.astro";
import SchemaOrg from "@components/seo/SchemaOrg.astro";
import ErrorLookupBar from "@components/blog/ErrorLookupBar.astro";
import { WINDOWS_ERRORS, type WindowsError } from "../../../data/windowsErrors";

export async function getStaticPaths() {
  return WINDOWS_ERRORS.map((error) => ({
    params: { code: error.slug },
    props: { error },
  }));
}

interface Props {
  error: WindowsError;
}

const { error } = Astro.props;

const seo = {
  title: `How to Fix Windows Error ${error.code}: Tested PowerShell Fix (2026)`,
  description: `Fix Windows stop code ${error.code} (${error.name}). Plain-English cause, Parameter 1 decoding, and verified administrator PowerShell repair command.`,
  keywords: `${error.code} fix, how to fix ${error.code}, ${error.name}, windows error ${error.code}, powershell repair ${error.code}, ${error.category}`,
};

const canonicalUrl = `https://www.praveentechworld.com/tools/windows-error-fixer/${error.slug}`;
---

<BaseLayout seo={seo}>
  <SchemaOrg
    type="webapplication"
    webApplicationData={{
      name: `Windows Error ${error.code} PowerShell Fixer & Diagnostic`,
      description: `Instant root-cause analysis and verified administrator PowerShell repair command for Windows error ${error.code} (${error.name}).`,
      url: canonicalUrl,
      applicationCategory: "UtilityApplication",
      operatingSystem: "Windows 11, Windows 10, Windows Server",
      browserRequirements: "Requires JavaScript. Modern Browser.",
      offers: {
        price: "0",
        priceCurrency: "USD",
      },
    }}
  />

  <div class="mx-auto max-w-4xl px-4 py-10 sm:py-14">
    <!-- Breadcrumb Navigation -->
    <nav class="mb-6 flex items-center gap-2 text-xs text-text-muted dark:text-text-dark-muted">
      <a href="/" class="hover:text-brand-500 transition-colors">Home</a>
      <span>/</span>
      <a href="/tools/windows-error-fixer" class="hover:text-brand-500 transition-colors">Windows Error Fixer</a>
      <span>/</span>
      <span class="font-mono font-bold text-text dark:text-text-dark">{error.code}</span>
    </nav>

    <!-- Header & 0-Second Direct Answer -->
    <div class="mb-8">
      <div class="inline-flex items-center gap-2 rounded-full border border-brand-500/20 bg-brand-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-brand-700 dark:text-brand-300 mb-3">
        <Icon name="wrench" class="w-3.5 h-3.5" /> {error.category}
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl lg:text-5xl text-text dark:text-text-dark">
        How to Fix Windows Error <span class="font-mono text-brand-700 dark:text-brand-400">{error.code}</span>
      </h1>
      <p class="mt-2 text-sm sm:text-base font-mono text-text-muted dark:text-text-dark-muted">
        Symbolic Name: <strong class="text-text dark:text-text-dark">{error.name}</strong> | Severity: <span class="text-red-500 font-bold">{error.severity}</span>
      </p>
    </div>

    <!-- The 0-Second Fix (First 50 Words & Instant Command Block) -->
    <div class="mb-10 rounded-2xl border-2 border-brand-500/40 bg-surface p-6 shadow-lg dark:border-brand-500/30 dark:bg-surface-dark">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-700 dark:text-brand-300 flex items-center gap-1.5">
          <Icon name="terminal" class="w-4 h-4" /> The 0-Second Fix (Run as Administrator)
        </span>
        <button
          type="button"
          id="copy-ps-btn"
          class="inline-flex items-center gap-1.5 rounded-lg bg-brand-500/10 hover:bg-brand-500/20 px-3 py-1 text-xs font-semibold text-brand-700 dark:text-brand-300 transition-colors cursor-pointer"
        >
          <Icon name="copy" class="w-3.5 h-3.5" /> <span id="copy-btn-text">Copy Script</span>
        </button>
      </div>

      <p class="text-xs sm:text-sm text-text dark:text-text-dark mb-4 leading-relaxed font-sans">
        To immediately remediate Windows error <strong>{error.code}</strong> without reinstalling the operating system, open PowerShell as administrator and execute our verified diagnostic repair sequence below.
      </p>

      <pre class="overflow-x-auto rounded-xl bg-neutral-900 p-4 font-mono text-xs sm:text-sm text-neutral-100 border border-neutral-800 leading-relaxed"><code id="powershell-code">{error.powershell}</code></pre>
    </div>

    <!-- Passage Citability Answer Capsule (134-167 Words for Google AI Overview / GEO) -->
    <div class="mb-10 rounded-xl border border-brand-500/30 bg-brand-500/5 p-6 dark:border-brand-500/40 dark:bg-brand-500/10">
      <h2 class="text-lg font-bold text-text dark:text-text-dark mb-2 flex items-center gap-2">
        <Icon name="wrench" class="w-4 h-4 text-brand-700 dark:text-brand-300 shrink-0" /> Root Cause & Diagnostic Breakdown
      </h2>
      <p class="text-sm text-text dark:text-text-dark leading-relaxed font-sans">
        {error.citabilityAnswer}
      </p>
    </div>

    <!-- Parameter 1 & Kernel Telemetry Matrix -->
    <div class="mb-10 rounded-2xl border border-border bg-surface p-6 shadow-sm dark:border-border-dark dark:bg-surface-dark">
      <h3 class="text-base font-bold text-text dark:text-text-dark mb-3 flex items-center gap-2">
        <Icon name="layers" class="w-4 h-4 text-brand-700 dark:text-brand-300 shrink-0" /> Parameter 1 Minidump & Subsystem Telemetry
      </h3>
      <div class="grid gap-3 sm:grid-cols-2 text-xs font-sans">
        <div class="rounded-xl border border-border bg-surface-alt p-3 dark:border-border-dark dark:bg-surface-dark-alt">
          <div class="font-bold text-text-muted dark:text-text-dark-muted mb-1">Underlying Trigger:</div>
          <div class="text-text dark:text-text-dark leading-normal">{error.cause}</div>
        </div>
        <div class="rounded-xl border border-border bg-surface-alt p-3 dark:border-border-dark dark:bg-surface-dark-alt">
          <div class="font-bold text-text-muted dark:text-text-dark-muted mb-1">Parameter 1 Decoding:</div>
          <div class="font-mono text-brand-700 dark:text-brand-300 leading-normal">{error.param1Info}</div>
        </div>
      </div>
    </div>

    <!-- 4-Step Actionable Triage Plan -->
    <div class="mb-10 rounded-2xl border border-border bg-surface p-6 shadow-sm dark:border-border-dark dark:bg-surface-dark">
      <h3 class="text-base font-bold text-text dark:text-text-dark mb-4 flex items-center gap-2">
        <Icon name="check" class="w-4 h-4 text-brand-700 dark:text-brand-300 shrink-0" /> 4-Step Resolution Runbook
      </h3>
      <ol class="space-y-3 text-xs sm:text-sm text-text dark:text-text-dark font-sans list-decimal pl-5">
        {error.steps.map((step) => (
          <li class="leading-relaxed pl-1">{step}</li>
        ))}
      </ol>
    </div>

    <!-- The Interactive Moat: ErrorLookupBar Embedded Directly on Page -->
    <div class="mb-10">
      <ErrorLookupBar
        initialCode={error.code}
        title="Need to Look Up Another Windows Error Code?"
        subtitle="Search our instant telemetry database of 25+ verified Windows 11 BSoD hex codes, kernel drivers, and update errors."
      />
    </div>

    <!-- Related In-Depth Guide Bridge -->
    {error.guideUrl && (
      <div class="rounded-xl border border-border bg-surface-alt p-5 dark:border-border-dark dark:bg-surface-dark-alt flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <div class="text-xs font-semibold text-brand-700 dark:text-brand-300">Complete Forensic Analysis</div>
          <div class="text-sm font-bold text-text dark:text-text-dark mt-0.5">Read our full workbench diagnostic guide for {error.code}</div>
        </div>
        <a
          href={error.guideUrl}
          class="inline-flex items-center gap-1 rounded-lg bg-brand-700 px-4 py-2 text-xs font-bold text-white hover:bg-brand-800 dark:bg-brand-600 dark:hover:bg-brand-500 transition-colors shrink-0"
        >
          <span>Read Full Runbook &rarr;</span>
        </a>
      </div>
    )}
  </div>
</BaseLayout>

<script is:inline>
  const copyBtn = document.getElementById('copy-ps-btn');
  const codeEl = document.getElementById('powershell-code');
  const btnText = document.getElementById('copy-btn-text');

  if (copyBtn && codeEl && btnText) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(codeEl.innerText.trim());
        btnText.textContent = 'Copied!';
        copyBtn.classList.add('bg-green-500/20', 'text-green-700');
        setTimeout(() => {
          btnText.textContent = 'Copy Script';
          copyBtn.classList.remove('bg-green-500/20', 'text-green-700');
        }, 2500);
      } catch (err) {
        console.error('Copy failed:', err);
      }
    });
  }
</script>
