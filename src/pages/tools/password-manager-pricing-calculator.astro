---
import BaseLayout from "@layouts/BaseLayout.astro";
import TechAdUnit from "@components/ads/TechAdUnit.astro";

const seo = {
  title: "Business Password Manager Pricing & TCO Calculator (2026)",
  description: "Calculate exact annual costs and hidden SSO add-on fees for business password managers. Compare Bitwarden, 1Password, Keeper, and Dashlane for your team size.",
  keywords: "business password managers 2026 pricing, password manager cost calculator, bitwarden vs 1password business pricing, keeper sso hidden fees, enterprise password manager tco",
};
---

<BaseLayout seo={seo}>
  <div class="mx-auto max-w-6xl px-4 py-12">
    <!-- Header -->
    <div class="mb-10 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-brand-500/20 bg-brand-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-400 mb-4">
        🔐 Interactive IT Procurement & Security Tool
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl lg:text-5xl text-text dark:text-text-dark">
        Business Password Manager Pricing & TCO Calculator
      </h1>
      <p class="mt-4 text-base sm:text-lg text-text-muted dark:text-text-dark-muted max-w-3xl mx-auto">
        Planning an enterprise vault rollout? Calculate exact seat licenses, uncover hidden SAML SSO add-on fees, and compare true annual costs across <span class="font-bold text-text dark:text-text-dark">Bitwarden</span>, <span class="font-bold text-text dark:text-text-dark">1Password</span>, <span class="font-bold text-text dark:text-text-dark">Keeper</span>, and <span class="font-bold text-text dark:text-text-dark">Dashlane</span>.
      </p>
    </div>

    <!-- Main Interactive Calculator Grid -->
    <div class="grid gap-8 lg:grid-cols-12 items-start">
      
      <!-- Input Controls (Left Column: 5 cols) -->
      <div class="lg:col-span-5 rounded-2xl border border-border bg-surface p-6 shadow-sm dark:border-border-dark dark:bg-surface-dark space-y-6">
        <h2 class="text-xl font-bold text-text dark:text-text-dark flex items-center gap-2">
          <span>⚙️</span> 1. Team Size & Requirements
        </h2>

        <!-- Headcount Slider & Input -->
        <div class="space-y-3">
          <div class="flex justify-between items-center">
            <label for="seatSlider" class="text-sm font-semibold text-text dark:text-text-dark">
              Number of User Seats
            </label>
            <span id="seatDisplay" class="text-xl font-extrabold text-brand-600 dark:text-brand-400 font-mono">
              25 Seats
            </span>
          </div>
          <input
            type="range"
            id="seatSlider"
            min="5"
            max="250"
            step="5"
            value="25"
            class="w-full accent-brand-600 dark:accent-brand-400 cursor-pointer"
          />
          <div class="flex justify-between text-xs text-text-muted dark:text-text-dark-muted font-mono">
            <span>5 seats</span>
            <span>50 seats</span>
            <span>100 seats</span>
            <span>250+</span>
          </div>

          <!-- Quick Select Buttons -->
          <div class="flex flex-wrap gap-2 pt-2">
            <button type="button" class="seat-btn px-2.5 py-1 text-xs font-mono font-medium rounded-lg border border-border dark:border-border-dark bg-surface-alt dark:bg-surface-dark-alt hover:border-brand-500 transition-colors" data-seats="10">10 seats</button>
            <button type="button" class="seat-btn px-2.5 py-1 text-xs font-mono font-medium rounded-lg border border-brand-500/50 bg-brand-500/10 text-brand-600 dark:text-brand-400 transition-colors" data-seats="25">25 seats</button>
            <button type="button" class="seat-btn px-2.5 py-1 text-xs font-mono font-medium rounded-lg border border-border dark:border-border-dark bg-surface-alt dark:bg-surface-dark-alt hover:border-brand-500 transition-colors" data-seats="50">50 seats</button>
            <button type="button" class="seat-btn px-2.5 py-1 text-xs font-mono font-medium rounded-lg border border-border dark:border-border-dark bg-surface-alt dark:bg-surface-dark-alt hover:border-brand-500 transition-colors" data-seats="100">100 seats</button>
            <button type="button" class="seat-btn px-2.5 py-1 text-xs font-mono font-medium rounded-lg border border-border dark:border-border-dark bg-surface-alt dark:bg-surface-dark-alt hover:border-brand-500 transition-colors" data-seats="250">250 seats</button>
          </div>
        </div>

        <!-- Billing Frequency -->
        <div class="border-t border-border dark:border-border-dark pt-5 space-y-3">
          <label class="text-sm font-semibold text-text dark:text-text-dark block">
            Billing Frequency
          </label>
          <div class="grid grid-cols-2 gap-3">
            <button type="button" id="billingAnnual" class="billing-btn py-2.5 px-3 rounded-xl border border-brand-500 bg-brand-500/10 dark:bg-brand-500/20 text-brand-600 dark:text-brand-300 font-bold text-xs flex items-center justify-center gap-1.5 transition-all">
              <span>📅 Annual (Standard)</span>
            </button>
            <button type="button" id="billingMonthly" class="billing-btn py-2.5 px-3 rounded-xl border border-border dark:border-border-dark bg-surface-alt dark:bg-surface-dark-alt text-text-muted dark:text-text-dark-muted font-medium text-xs flex items-center justify-center gap-1.5 hover:border-brand-500 transition-all">
              <span>💳 Monthly (+20% avg)</span>
            </button>
          </div>
        </div>

        <!-- Enterprise Feature Filter Checkboxes -->
        <div class="border-t border-border dark:border-border-dark pt-5 space-y-4">
          <label class="text-sm font-semibold text-text dark:text-text-dark block">
            Enterprise & Infrastructure Requirements
          </label>
          
          <label class="flex items-start gap-3 cursor-pointer select-none">
            <input type="checkbox" id="reqSSO" class="mt-1 h-4 w-4 rounded border-border accent-brand-600 dark:accent-brand-400" checked />
            <div class="text-xs">
              <span class="font-bold text-text dark:text-text-dark block">Require SAML 2.0 / Okta / Azure AD SSO</span>
              <span class="text-text-muted dark:text-text-dark-muted">Forces enterprise tier or SSO add-on module (uncovers Keeper's ARAM surcharge).</span>
            </div>
          </label>

          <label class="flex items-start gap-3 cursor-pointer select-none">
            <input type="checkbox" id="reqSCIM" class="mt-1 h-4 w-4 rounded border-border accent-brand-600 dark:accent-brand-400" checked />
            <div class="text-xs">
              <span class="font-bold text-text dark:text-text-dark block">Require Automated SCIM Deprovisioning</span>
              <span class="text-text-muted dark:text-text-dark-muted">Instantly revokes vault access when employee leaves company directory.</span>
            </div>
          </label>

          <label class="flex items-start gap-3 cursor-pointer select-none">
            <input type="checkbox" id="reqCLI" class="mt-1 h-4 w-4 rounded border-border accent-brand-600 dark:accent-brand-400" />
            <div class="text-xs">
              <span class="font-bold text-text dark:text-text-dark block">Developer CLI Secrets & SSH Key Injection</span>
              <span class="text-text-muted dark:text-text-dark-muted">Prioritizes 1Password (`op`) and Bitwarden (`bw`) CLI integration.</span>
            </div>
          </label>

          <label class="flex items-start gap-3 cursor-pointer select-none">
            <input type="checkbox" id="reqSelfHost" class="mt-1 h-4 w-4 rounded border-border accent-brand-600 dark:accent-brand-400" />
            <div class="text-xs">
              <span class="font-bold text-text dark:text-text-dark block">Air-Gapped / On-Premise Self-Hosting (Docker)</span>
              <span class="text-text-muted dark:text-text-dark-muted">Restricts valid solutions strictly to Bitwarden enterprise containers.</span>
            </div>
          </label>
        </div>

        <div class="pt-2">
          <button type="button" id="copySummaryBtn" class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-brand-600 hover:bg-brand-700 active:scale-95 px-4 py-3 text-sm font-bold text-white shadow-sm transition-all cursor-pointer dark:bg-brand-500 dark:hover:bg-brand-600">
            <span>📋 Copy Budget Estimate to Clipboard</span>
          </button>
        </div>
      </div>

      <!-- Comparison Results Table & Cards (Right Column: 7 cols) -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Summary Box -->
        <div class="rounded-2xl border border-brand-500/30 bg-surface p-6 shadow-sm dark:border-brand-500/30 dark:bg-surface-dark relative overflow-hidden">
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-brand-600 dark:text-brand-400">
                💰 Lowest Enterprise TCO Winner
              </span>
              <h3 id="winnerTitle" class="text-2xl font-black text-text dark:text-text-dark mt-1">
                Bitwarden Enterprise
              </h3>
              <p id="winnerSubtitle" class="text-xs sm:text-sm text-text-muted dark:text-text-dark-muted mt-1">
                Zero hidden SSO fees. Includes SAML 2.0, SCIM directory sync, and self-hosting.
              </p>
            </div>
            <div class="text-left sm:text-right">
              <div class="text-xs text-text-muted dark:text-text-dark-muted">Annual Company Cost:</div>
              <div id="winnerPrice" class="text-3xl font-black text-brand-600 dark:text-brand-400 font-mono">
                $1,800 / yr
              </div>
              <div id="winnerSavings" class="text-xs font-semibold text-emerald-600 dark:text-emerald-400">
                Saves $597 / yr vs 1Password
              </div>
            </div>
          </div>
        </div>

        <!-- Dynamic Detailed Provider Cards -->
        <div class="space-y-3" id="providerCardsContainer">
          <!-- Populated by JavaScript -->
        </div>

        <!-- Warning / Fine Print Callout -->
        <div class="rounded-xl border border-amber-500/30 bg-amber-500/10 p-4 text-xs text-amber-900 dark:text-amber-200 space-y-1">
          <div class="font-bold flex items-center gap-1.5">
            <span>⚠️</span> The Enterprise SSO Trap (Why Sticker Prices Lie)
          </div>
          <p class="leading-relaxed">
            Several providers advertise low baseline seats ($3.75/user/mo), but lock essential SAML 2.0 (Okta, Entra ID) behind proprietary add-ons like Keeper's ARAM module (+$3.00/user/mo) or require custom annual contracts. Our calculator automatically applies these real-world add-on surcharges when SSO is checked.
          </p>
        </div>

      </div>
    </div>

    <!-- Ad Unit -->
    <div class="my-14">
      <TechAdUnit client:visible slotId="tools-footer-ad" />
    </div>

    <!-- Educational Guide & FAQ Section -->
    <div class="mt-14 max-w-4xl mx-auto space-y-12">
      
      <!-- Detailed Guide -->
      <section class="space-y-4">
        <h2 class="text-2xl font-bold tracking-tight text-text dark:text-text-dark">
          How to Choose the Best Business Password Manager in 2026
        </h2>
        <p class="text-base text-text-muted dark:text-text-dark-muted leading-relaxed">
          When our team tested password managers across developer workstations and remote teams, we found that pricing discrepancies rarely stem from core password storage. Instead, total cost of ownership (TCO) is dictated by three mission-critical enterprise features: <strong>Identity Provider (IdP) federation</strong>, <strong>SCIM offboarding automation</strong>, and <strong>developer secret management</strong>.
        </p>
        <p class="text-base text-text-muted dark:text-text-dark-muted leading-relaxed">
          For full technical deep-dives on zero-knowledge encryption algorithms (Argon2id vs PBKDF2), passkey sync, and client benchmarks, read our comprehensive runbook: <a href="/blog/best-password-managers-in-2026-security-features-and-pricing-compared/" class="text-brand-600 dark:text-brand-400 underline font-semibold hover:text-brand-700">Best Business Password Managers 2026: Pricing & Security Compared</a>.
        </p>
      </section>

      <!-- FAQ Accordions / Answers -->
      <section class="space-y-6">
        <h3 class="text-xl font-bold text-text dark:text-text-dark">
          Frequently Asked Questions on Business Vault Licensing
        </h3>

        <div class="space-y-4">
          <div class="rounded-xl border border-border dark:border-border-dark p-5 bg-surface dark:bg-surface-dark space-y-2">
            <h4 class="font-bold text-text dark:text-text-dark">
              How much do business password managers cost per user in 2026?
            </h4>
            <p class="text-sm text-text-muted dark:text-text-dark-muted leading-relaxed">
              Business password managers cost between $3.00 and $8.00 per user per month billed annually. Bitwarden Teams starts at $4.00/user/mo and Enterprise is $6.00/user/mo with all SSO features included. Keeper starts at $3.75/user/mo but rises to $6.75/user/mo with SAML SSO. 1Password Business is flat-rate at $7.99/user/mo with premium developer tools, and Dashlane Business is $8.00/user/mo.
            </p>
          </div>

          <div class="rounded-xl border border-border dark:border-border-dark p-5 bg-surface dark:bg-surface-dark space-y-2">
            <h4 class="font-bold text-text dark:text-text-dark">
              Why is SCIM provisioning essential for corporate security?
            </h4>
            <p class="text-sm text-text-muted dark:text-text-dark-muted leading-relaxed">
              System for Cross-domain Identity Management (SCIM) allows your company directory (Okta, Microsoft Entra ID, Google Workspace) to automatically create and instantly revoke employee vault accounts. When an employee departs, deactivating them in your IdP immediately revokes their vault tokens, preventing departing staff from retaining access to shared production credentials.
            </p>
          </div>

          <div class="rounded-xl border border-border dark:border-border-dark p-5 bg-surface dark:bg-surface-dark space-y-2">
            <h4 class="font-bold text-text dark:text-text-dark">
              Can our engineering team self-host our password vault on-premise?
            </h4>
            <p class="text-sm text-text-muted dark:text-text-dark-muted leading-relaxed">
              Yes. Among the top commercial providers, Bitwarden is the only platform that provides official, fully supported on-premise Docker containers for self-hosting. This allows regulated financial, healthcare, or defense organizations to maintain complete data sovereignty inside air-gapped internal subnets.
            </p>
          </div>
        </div>
      </section>

    </div>
  </div>

  <!-- Client-Side Calculator Logic -->
  <script is:inline>
    (function () {
      const seatSlider = document.getElementById("seatSlider");
      const seatDisplay = document.getElementById("seatDisplay");
      const billingAnnual = document.getElementById("billingAnnual");
      const billingMonthly = document.getElementById("billingMonthly");
      const reqSSO = document.getElementById("reqSSO");
      const reqSCIM = document.getElementById("reqSCIM");
      const reqCLI = document.getElementById("reqCLI");
      const reqSelfHost = document.getElementById("reqSelfHost");
      const providerCardsContainer = document.getElementById("providerCardsContainer");
      const winnerTitle = document.getElementById("winnerTitle");
      const winnerSubtitle = document.getElementById("winnerSubtitle");
      const winnerPrice = document.getElementById("winnerPrice");
      const winnerSavings = document.getElementById("winnerSavings");
      const copyBtn = document.getElementById("copySummaryBtn");

      let currentSeats = 25;
      let isAnnual = true;

      // Rate card data (verified 2026 rates)
      const providers = [
        {
          id: "bitwarden",
          name: "Bitwarden",
          teamsRate: 4.0,
          enterpriseRate: 6.0,
          hasSSOAddon: false,
          ssoIncludedInEnterprise: true,
          supportsCLI: true,
          supportsSelfHost: true,
          supportsSCIM: true,
          monthlyMarkup: 0.15,
          tagline: "Best value & open-source transparency",
          color: "brand",
        },
        {
          id: "1password",
          name: "1Password",
          teamsRate: 7.99,
          enterpriseRate: 7.99,
          hasSSOAddon: false,
          ssoIncludedInEnterprise: true,
          supportsCLI: true,
          supportsSelfHost: false,
          supportsSCIM: true,
          monthlyMarkup: 0.2,
          tagline: "Best for developer CLI & biometric SSH keys",
          color: "blue",
        },
        {
          id: "keeper",
          name: "Keeper Security",
          teamsRate: 3.75,
          enterpriseRate: 5.0,
          hasSSOAddon: true,
          ssoAddonRate: 3.0, // ARAM module
          supportsCLI: true,
          supportsSelfHost: false,
          supportsSCIM: true,
          monthlyMarkup: 0.18,
          tagline: "FedRAMP authorized & granular folder permissions",
          color: "amber",
        },
        {
          id: "dashlane",
          name: "Dashlane",
          teamsRate: 5.0,
          enterpriseRate: 8.0,
          hasSSOAddon: false,
          ssoIncludedInEnterprise: true,
          supportsCLI: false,
          supportsSelfHost: false,
          supportsSCIM: true,
          monthlyMarkup: 0.2,
          tagline: "User-friendly UI & built-in dark web monitoring",
          color: "emerald",
        },
        {
          id: "proton",
          name: "Proton Pass",
          teamsRate: 3.99,
          enterpriseRate: 6.99,
          hasSSOAddon: false,
          ssoIncludedInEnterprise: true,
          supportsCLI: false,
          supportsSelfHost: false,
          supportsSCIM: true,
          monthlyMarkup: 0.2,
          tagline: "Swiss jurisdiction & email alias masking",
          color: "purple",
        },
      ];

      function calculateCosts() {
        const sso = reqSSO.checked;
        const scim = reqSCIM.checked;
        const cli = reqCLI.checked;
        const selfHost = reqSelfHost.checked;
        const markupMultiplier = isAnnual ? 1.0 : 1.2;

        const results = providers.map((p) => {
          let eligible = true;
          let notes = [];

          if (selfHost && !p.supportsSelfHost) {
            eligible = false;
            notes.push("❌ Cloud only (cannot self-host)");
          }
          if (cli && !p.supportsCLI) {
            notes.push("⚠️ Basic or no native secrets CLI");
          }

          // Tier decision
          let planName = "Teams Tier";
          let baseRate = p.teamsRate;

          if (sso || scim) {
            planName = "Enterprise Tier";
            baseRate = p.enterpriseRate;
            if (p.hasSSOAddon) {
              baseRate += p.ssoAddonRate;
              notes.push("Includes +$3.00/mo ARAM SSO module");
            }
          }

          const effectiveMonthlyPerUser = (baseRate * markupMultiplier).toFixed(2);
          const annualTotal = Math.round(baseRate * markupMultiplier * currentSeats * 12);
          const monthlyTotal = Math.round(baseRate * markupMultiplier * currentSeats);

          return {
            ...p,
            eligible,
            planName,
            baseRate,
            effectiveMonthlyPerUser,
            annualTotal,
            monthlyTotal,
            notes,
          };
        });

        // Filter eligible
        const eligibleList = results.filter((r) => r.eligible);
        eligibleList.sort((a, b) => a.annualTotal - b.annualTotal);

        renderResults(results, eligibleList);
      }

      function renderResults(allResults, eligibleSorted) {
        // Render Winner Box
        if (eligibleSorted.length > 0) {
          const winner = eligibleSorted[0];
          const runnerUp = eligibleSorted.find((r) => r.id === "1password") || eligibleSorted[1];
          winnerTitle.textContent = winner.name + " (" + winner.planName + ")";
          winnerSubtitle.textContent = winner.tagline + ". Calculated for " + currentSeats + " seats.";
          winnerPrice.textContent = "$" + winner.annualTotal.toLocaleString() + " / yr";

          if (runnerUp && runnerUp.id !== winner.id) {
            const diff = runnerUp.annualTotal - winner.annualTotal;
            if (diff > 0) {
              winnerSavings.textContent = "Saves $" + diff.toLocaleString() + " / yr vs " + runnerUp.name;
              winnerSavings.className = "text-xs font-semibold text-emerald-600 dark:text-emerald-400";
            } else {
              winnerSavings.textContent = "Competitive enterprise price point";
              winnerSavings.className = "text-xs font-semibold text-text-muted dark:text-text-dark-muted";
            }
          } else {
            winnerSavings.textContent = "Single qualifying solution for selected filters";
          }
        }

        // Render Cards
        providerCardsContainer.innerHTML = "";
        allResults.forEach((p) => {
          const isWinner = eligibleSorted.length > 0 && eligibleSorted[0].id === p.id;
          const card = document.createElement("div");
          card.className =
            "rounded-xl border p-4 sm:p-5 transition-all " +
            (!p.eligible
              ? "opacity-40 border-border dark:border-border-dark bg-surface-alt/50 dark:bg-surface-dark-alt/50"
              : isWinner
              ? "border-brand-500 bg-brand-500/5 dark:bg-brand-500/10 shadow-sm"
              : "border-border dark:border-border-dark bg-surface dark:bg-surface-dark hover:border-brand-500/40");

          card.innerHTML = `
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
              <div>
                <div class="flex items-center gap-2">
                  <h4 class="font-bold text-base text-text dark:text-text-dark">${p.name}</h4>
                  <span class="text-xs px-2 py-0.5 rounded-full font-mono font-medium ${
                    isWinner
                      ? "bg-brand-500 text-white"
                      : "bg-surface-alt dark:bg-surface-dark-alt text-text-muted dark:text-text-dark-muted border border-border dark:border-border-dark"
                  }">
                    ${p.planName}
                  </span>
                </div>
                <p class="text-xs text-text-muted dark:text-text-dark-muted mt-0.5">${p.tagline}</p>
                ${
                  p.notes.length > 0
                    ? `<div class="text-[11px] text-amber-600 dark:text-amber-400 font-medium mt-1">${p.notes.join(
                        " • "
                      )}</div>`
                    : ""
                }
              </div>
              <div class="text-left sm:text-right shrink-0">
                <div class="text-xl sm:text-2xl font-black font-mono text-text dark:text-text-dark">
                  $${p.annualTotal.toLocaleString()}<span class="text-xs font-normal text-text-muted dark:text-text-dark-muted">/yr</span>
                </div>
                <div class="text-xs text-text-muted dark:text-text-dark-muted font-mono">
                  $${p.effectiveMonthlyPerUser} / user / mo ($${p.monthlyTotal.toLocaleString()}/mo)
                </div>
              </div>
            </div>
          `;
          providerCardsContainer.appendChild(card);
        });
      }

      // Event Listeners
      seatSlider.addEventListener("input", function (e) {
        currentSeats = parseInt(e.target.value);
        seatDisplay.textContent = currentSeats + " Seats";
        calculateCosts();
      });

      document.querySelectorAll(".seat-btn").forEach((btn) => {
        btn.addEventListener("click", function () {
          currentSeats = parseInt(this.dataset.seats);
          seatSlider.value = currentSeats;
          seatDisplay.textContent = currentSeats + " Seats";
          document.querySelectorAll(".seat-btn").forEach((b) => {
            b.className =
              "seat-btn px-2.5 py-1 text-xs font-mono font-medium rounded-lg border border-border dark:border-border-dark bg-surface-alt dark:bg-surface-dark-alt hover:border-brand-500 transition-colors";
          });
          this.className =
            "seat-btn px-2.5 py-1 text-xs font-mono font-medium rounded-lg border border-brand-500/50 bg-brand-500/10 text-brand-600 dark:text-brand-400 transition-colors";
          calculateCosts();
        });
      });

      billingAnnual.addEventListener("click", function () {
        isAnnual = true;
        this.className =
          "billing-btn py-2.5 px-3 rounded-xl border border-brand-500 bg-brand-500/10 dark:bg-brand-500/20 text-brand-600 dark:text-brand-300 font-bold text-xs flex items-center justify-center gap-1.5 transition-all";
        billingMonthly.className =
          "billing-btn py-2.5 px-3 rounded-xl border border-border dark:border-border-dark bg-surface-alt dark:bg-surface-dark-alt text-text-muted dark:text-text-dark-muted font-medium text-xs flex items-center justify-center gap-1.5 hover:border-brand-500 transition-all";
        calculateCosts();
      });

      billingMonthly.addEventListener("click", function () {
        isAnnual = false;
        this.className =
          "billing-btn py-2.5 px-3 rounded-xl border border-brand-500 bg-brand-500/10 dark:bg-brand-500/20 text-brand-600 dark:text-brand-300 font-bold text-xs flex items-center justify-center gap-1.5 transition-all";
        billingAnnual.className =
          "billing-btn py-2.5 px-3 rounded-xl border border-border dark:border-border-dark bg-surface-alt dark:bg-surface-dark-alt text-text-muted dark:text-text-dark-muted font-medium text-xs flex items-center justify-center gap-1.5 hover:border-brand-500 transition-all";
        calculateCosts();
      });

      reqSSO.addEventListener("change", calculateCosts);
      reqSCIM.addEventListener("change", calculateCosts);
      reqCLI.addEventListener("change", calculateCosts);
      reqSelfHost.addEventListener("change", calculateCosts);

      // Copy summary button
      copyBtn.addEventListener("click", function () {
        const sso = reqSSO.checked ? "Yes" : "No";
        const scim = reqSCIM.checked ? "Yes" : "No";
        const selfHost = reqSelfHost.checked ? "Yes" : "No";
        let text = "Enterprise Password Manager Cost Comparison (PraveenTechWorld)\n";
        text += "===============================================================\n";
        text += "Team Seats: " + currentSeats + "\n";
        text += "Billing Cycle: " + (isAnnual ? "Annual" : "Monthly") + "\n";
        text += "Requirements: SAML SSO: " + sso + " | SCIM: " + scim + " | Self-Host: " + selfHost + "\n\n";

        providers.forEach((p) => {
          let rate = p.teamsRate;
          if (reqSSO.checked || reqSCIM.checked) {
            rate = p.enterpriseRate + (p.hasSSOAddon ? p.ssoAddonRate : 0);
          }
          const mult = isAnnual ? 1.0 : 1.2;
          const ann = Math.round(rate * mult * currentSeats * 12);
          text += p.name + ": $" + ann.toLocaleString() + " / yr ($" + (rate * mult).toFixed(2) + "/user/mo)\n";
        });
        text += "\nSource: https://www.praveentechworld.com/tools/password-manager-pricing-calculator\n";

        navigator.clipboard.writeText(text).then(() => {
          copyBtn.innerHTML = "<span>✅ Budget Estimate Copied to Clipboard!</span>";
          setTimeout(() => {
            copyBtn.innerHTML = "<span>📋 Copy Budget Estimate to Clipboard</span>";
          }, 3000);
        });
      });

      // Initial run
      calculateCosts();
    })();
  </script>
</BaseLayout>
