---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  seo={{
    title: "Search Tech Guides, Windows 11 Fixes & AI Tutorials",
    description: "Instant search engine for technical guides, sysadmin scripts, Windows 11 troubleshooting fixes, and AI automation tutorials on PraveenTechWorld.",
  }}
>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <!-- Header -->
    <div class="mb-8 text-center sm:text-left">
      <h1 class="mb-3 text-3xl font-extrabold tracking-tight text-text dark:text-text-dark sm:text-4xl">
        Search Knowledge Base
      </h1>
      <p class="text-base leading-relaxed text-text-muted dark:text-text-dark-muted">
        Instant, zero-latency search across our entire library of verified sysadmin guides, Windows 11 fixes, AI automation tutorials, and interactive tools.
      </p>
    </div>

    <!-- Search Box Form -->
    <div class="relative mb-6">
      <form id="search-form" class="relative flex items-center" onsubmit="return false;" webmcp-action="search_articles">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-text-muted dark:text-text-dark-muted">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.3-4.3" />
          </svg>
        </div>
        <input
          type="search"
          id="search-input"
          name="q"
          placeholder="Search keywords (e.g. audiodg, RAM diagnostics, 0x8024200d, Ollama, VRAM)..."
          autocomplete="off"
          autofocus
          webmcp-parameter="query"
          class="w-full rounded-xl border border-border bg-surface py-3.5 pl-11 pr-24 text-base text-text shadow-sm transition-all focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20 dark:border-border-dark dark:bg-surface-dark-alt dark:text-text-dark dark:focus:border-brand-400"
        />
        <div class="absolute inset-y-0 right-0 flex items-center pr-3 gap-1.5">
          <button
            type="button"
            id="clear-btn"
            class="hidden rounded-lg p-1.5 text-text-muted hover:bg-surface-alt hover:text-text dark:text-text-dark-muted dark:hover:bg-surface-dark dark:hover:text-text-dark"
            aria-label="Clear search"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 6 6 18" />
              <path d="m6 6 12 12" />
            </svg>
          </button>
          <kbd class="hidden sm:inline-flex items-center rounded border border-border px-2 py-0.5 text-[11px] font-mono text-text-muted dark:border-border-dark dark:text-text-dark-muted">
            /
          </kbd>
        </div>
      </form>
    </div>

    <!-- Category Filter Pills -->
    <div class="mb-8 flex flex-wrap items-center gap-2" id="filter-chips">
      <button type="button" data-category="all" class="filter-chip active rounded-full px-3.5 py-1 text-xs font-semibold transition-colors bg-brand-600 text-white dark:bg-brand-500">
        All
      </button>
      <button type="button" data-category="windows-fixes" class="filter-chip rounded-full border border-border px-3.5 py-1 text-xs font-semibold text-text-muted transition-colors hover:border-brand-500 hover:text-brand-600 dark:border-border-dark dark:text-text-dark-muted dark:hover:border-brand-400 dark:hover:text-brand-400">
        Windows 11
      </button>
      <button type="button" data-category="ai-automation" class="filter-chip rounded-full border border-border px-3.5 py-1 text-xs font-semibold text-text-muted transition-colors hover:border-brand-500 hover:text-brand-600 dark:border-border-dark dark:text-text-dark-muted dark:hover:border-brand-400 dark:hover:text-brand-400">
        AI & Workflows
      </button>
      <button type="button" data-category="hardware-troubleshooting" class="filter-chip rounded-full border border-border px-3.5 py-1 text-xs font-semibold text-text-muted transition-colors hover:border-brand-500 hover:text-brand-600 dark:border-border-dark dark:text-text-dark-muted dark:hover:border-brand-400 dark:hover:text-brand-400">
        Hardware & GPU
      </button>
      <button type="button" data-category="it-operations" class="filter-chip rounded-full border border-border px-3.5 py-1 text-xs font-semibold text-text-muted transition-colors hover:border-brand-500 hover:text-brand-600 dark:border-border-dark dark:text-text-dark-muted dark:hover:border-brand-400 dark:hover:text-brand-400">
        IT & Sysadmin
      </button>
      <button type="button" data-category="privacy" class="filter-chip rounded-full border border-border px-3.5 py-1 text-xs font-semibold text-text-muted transition-colors hover:border-brand-500 hover:text-brand-600 dark:border-border-dark dark:text-text-dark-muted dark:hover:border-brand-400 dark:hover:text-brand-400">
        Privacy & Security
      </button>
      <button type="button" data-category="tools" class="filter-chip rounded-full border border-border px-3.5 py-1 text-xs font-semibold text-text-muted transition-colors hover:border-brand-500 hover:text-brand-600 dark:border-border-dark dark:text-text-dark-muted dark:hover:border-brand-400 dark:hover:text-brand-400">
        Tools ⚡
      </button>
    </div>

    <!-- Live Search Stats Bar -->
    <div id="search-stats" class="mb-6 flex items-center justify-between text-xs font-medium text-text-muted dark:text-text-dark-muted">
      <span id="results-count">Type a search query above...</span>
      <span id="search-time" class="hidden font-mono">0ms</span>
    </div>

    <!-- Suggested Searches (Shown when input is empty) -->
    <div id="suggested-searches" class="mb-12">
      <h2 class="mb-3 text-xs font-bold uppercase tracking-wider text-text-muted dark:text-text-dark-muted">
        Popular Troubleshooting Topics
      </h2>
      <div class="flex flex-wrap gap-2">
        {
          [
            "audiodg high cpu",
            "RAM diagnostics",
            "VRAM calculator",
            "KB5121003 crash",
            "Ollama FP8 KV cache",
            "0x8024200d update error",
            "Docker volume permission",
            "Bluetooth disappeared",
            "splwow64 32-bit printing",
            "Windows 11 debloat",
          ].map((topic) => (
            <button
              type="button"
              class="suggested-chip inline-flex items-center gap-1.5 rounded-lg border border-border bg-surface-alt/60 px-3 py-1.5 text-xs font-medium text-text transition-colors hover:border-brand-500 hover:text-brand-600 dark:border-border-dark dark:bg-surface-dark-alt/60 dark:text-text-dark dark:hover:border-brand-400 dark:hover:text-brand-400 cursor-pointer"
              data-query={topic}
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-text-muted dark:text-text-dark-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6" />
              </svg>
              {topic}
            </button>
          ))
        }
      </div>
    </div>

    <!-- Live Results Container -->
    <div id="results-container" class="space-y-4" role="feed" aria-busy="false"></div>

    <!-- Empty State Container -->
    <div id="no-results" class="hidden rounded-2xl border border-dashed border-border p-12 text-center dark:border-border-dark">
      <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-surface-alt dark:bg-surface-dark-alt text-text-muted dark:text-text-dark-muted">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
          <line x1="8" y1="11" x2="14" y2="11" />
        </svg>
      </div>
      <h3 class="mb-1 text-lg font-bold text-text dark:text-text-dark">No matching articles found</h3>
      <p class="text-sm text-text-muted dark:text-text-dark-muted">
        Try checking for typos, using broader keywords, or selecting "All" categories.
      </p>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    let searchIndex = [];
    let activeCategory = 'all';
    let isLoaded = false;

    const input = document.getElementById('search-input');
    const clearBtn = document.getElementById('clear-btn');
    const resultsContainer = document.getElementById('results-container');
    const noResults = document.getElementById('no-results');
    const suggestedSection = document.getElementById('suggested-searches');
    const statsText = document.getElementById('results-count');
    const statsTime = document.getElementById('search-time');
    const filterButtons = document.querySelectorAll('.filter-chip');
    const suggestedButtons = document.querySelectorAll('.suggested-chip');

    // Fetch pre-compiled instant search index
    async function loadIndex() {
      try {
        const res = await fetch('/search-index.json');
        if (res.ok) {
          searchIndex = await res.json();
          isLoaded = true;
          
          // If query in URL, trigger search immediately
          const params = new URLSearchParams(window.location.search);
          const initialQuery = params.get('q');
          if (initialQuery) {
            input.value = initialQuery;
            executeSearch(initialQuery);
          }
        }
      } catch (err) {
        console.error('Failed to load search-index.json:', err);
      }
    }

    function escapeHtml(str) {
      if (!str) return '';
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function highlightText(text, query) {
      if (!text || !query) return escapeHtml(text);
      const words = query.trim().split(/\s+/).filter(w => w.length > 1);
      if (words.length === 0) return escapeHtml(text);
      
      const pattern = new RegExp(`(${words.map(w => w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})`, 'gi');
      return escapeHtml(text).replace(pattern, '<mark class="bg-amber-200/60 dark:bg-amber-500/30 text-inherit rounded px-0.5">$1</mark>');
    }

    function formatCategory(cat) {
      if (!cat) return 'General';
      const map = {
        'windows-fixes': 'Windows 11',
        'ai-automation': 'AI & Workflows',
        'ai-workflows': 'AI Workflows',
        'ai-tools': 'AI Tools',
        'ai': 'Artificial Intelligence',
        'hardware-troubleshooting': 'Hardware & GPU',
        'it-operations': 'IT & Sysadmin',
        'privacy': 'Privacy & Security',
        'security': 'Cybersecurity',
        'website-setup': 'Web & SEO',
        'tools': 'Interactive Tool ⚡'
      };
      return map[cat] || cat.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
    }

    function executeSearch(rawQuery) {
      const startTime = performance.now();
      const query = (rawQuery || '').trim().toLowerCase();

      if (query.length > 0) {
        clearBtn.classList.remove('hidden');
        suggestedSection.classList.add('hidden');
      } else {
        clearBtn.classList.add('hidden');
        suggestedSection.classList.remove('hidden');
        resultsContainer.innerHTML = '';
        noResults.classList.add('hidden');
        statsText.innerText = 'Type a search query above...';
        statsTime.classList.add('hidden');
        return;
      }

      if (!isLoaded || searchIndex.length === 0) {
        statsText.innerText = 'Searching...';
        return;
      }

      const queryTokens = query.split(/\s+/).filter(Boolean);

      // Score and rank matches
      const matched = [];
      for (let i = 0; i < searchIndex.length; i++) {
        const item = searchIndex[i];

        // Category filter
        if (activeCategory !== 'all') {
          const itemCat = (item.category || '').toLowerCase();
          if (activeCategory === 'tools' && item.category !== 'tools') continue;
          if (activeCategory === 'windows-fixes' && itemCat !== 'windows-fixes') continue;
          if (activeCategory === 'ai-automation' && !itemCat.startsWith('ai') && itemCat !== 'automation') continue;
          if (activeCategory === 'hardware-troubleshooting' && itemCat !== 'hardware-troubleshooting') continue;
          if (activeCategory === 'it-operations' && itemCat !== 'it-operations') continue;
          if (activeCategory === 'privacy' && itemCat !== 'privacy' && itemCat !== 'security') continue;
        }

        const titleLower = item.title.toLowerCase();
        const descLower = (item.description || '').toLowerCase();
        const tagsLower = (item.tags || []).join(' ').toLowerCase();
        const slugLower = item.slug.toLowerCase();

        let score = 0;
        let matchAll = true;

        for (const token of queryTokens) {
          if (titleLower.includes(token)) {
            score += 15;
            if (titleLower.startsWith(token)) score += 10;
          } else if (tagsLower.includes(token)) {
            score += 8;
          } else if (descLower.includes(token)) {
            score += 4;
          } else if (slugLower.includes(token)) {
            score += 3;
          } else {
            matchAll = false;
            break;
          }
        }

        // Exact phrase bonus
        if (titleLower.includes(query)) score += 25;
        if (descLower.includes(query)) score += 10;

        if (matchAll && score > 0) {
          matched.push({ item, score });
        }
      }

      // Sort by relevance score
      matched.sort((a, b) => b.score - a.score);

      const elapsed = Math.round(performance.now() - startTime);

      // Update Stats Bar
      statsText.innerHTML = `Found <strong class="text-text dark:text-text-dark">${matched.length}</strong> ${matched.length === 1 ? 'article' : 'articles'} for "<span class="text-brand-600 dark:text-brand-400 font-semibold">${escapeHtml(query)}</span>"`;
      statsTime.innerText = `${elapsed}ms`;
      statsTime.classList.remove('hidden');

      if (matched.length === 0) {
        resultsContainer.innerHTML = '';
        noResults.classList.remove('hidden');
        return;
      }

      noResults.classList.add('hidden');

      // Render Cards
      let html = '';
      const limit = Math.min(matched.length, 30);
      for (let i = 0; i < limit; i++) {
        const { item } = matched[i];
        const isTool = item.category === 'tools';
        
        html += `
          <article class="group rounded-xl border border-border bg-surface p-5 transition-all hover:border-brand-500 hover:shadow-md dark:border-border-dark dark:bg-surface-dark dark:hover:border-brand-400">
            <div class="mb-2 flex flex-wrap items-center gap-2">
              <span class="rounded-md ${isTool ? 'bg-amber-500/10 text-amber-600 dark:bg-amber-400/10 dark:text-amber-400' : 'bg-brand-500/10 text-brand-600 dark:bg-brand-400/10 dark:text-brand-400'} px-2.5 py-0.5 text-xs font-semibold">
                ${escapeHtml(formatCategory(item.category))}
              </span>
              ${item.publishDate ? `<time class="text-xs text-text-muted dark:text-text-dark-muted">${escapeHtml(item.publishDate)}</time>` : ''}
            </div>
            <h2 class="mb-2 text-lg font-bold leading-snug text-text transition-colors group-hover:text-brand-600 dark:text-text-dark dark:group-hover:text-brand-400">
              <a href="${escapeHtml(item.url)}" class="focus:outline-none focus:underline">
                ${highlightText(item.title, query)}
              </a>
            </h2>
            <p class="text-sm leading-relaxed text-text-muted dark:text-text-dark-muted line-clamp-2">
              ${highlightText(item.description || item.excerpt, query)}
            </p>
          </article>
        `;
      }

      resultsContainer.innerHTML = html;
    }

    // Event Listeners
    input?.addEventListener('input', (e) => {
      executeSearch(e.target.value);
    });

    clearBtn?.addEventListener('click', () => {
      input.value = '';
      input.focus();
      executeSearch('');
    });

    // Keyboard shortcut '/'
    window.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== input) {
        e.preventDefault();
        input.focus();
        input.select();
      }
      if (e.key === 'Escape' && document.activeElement === input) {
        input.value = '';
        executeSearch('');
      }
    });

    // Filter Chips
    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => {
          b.classList.remove('bg-brand-600', 'text-white', 'dark:bg-brand-500');
          b.classList.add('border', 'border-border', 'text-text-muted', 'dark:border-border-dark', 'dark:text-text-dark-muted');
        });
        btn.classList.remove('border', 'border-border', 'text-text-muted', 'dark:border-border-dark', 'dark:text-text-dark-muted');
        btn.classList.add('bg-brand-600', 'text-white', 'dark:bg-brand-500');
        
        activeCategory = btn.getAttribute('data-category') || 'all';
        executeSearch(input.value);
      });
    });

    // Suggested Searches
    suggestedButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const query = btn.getAttribute('data-query') || '';
        input.value = query;
        input.focus();
        executeSearch(query);
      });
    });

    // Initialize index load
    loadIndex();
  })();
</script>
