---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  seo={{
    title: "About & Contact — Praveen (IT Operations Lead & Web Administrator)",
    description: "Learn about Praveen, Web Administrator & IT Operations Lead based in Dubai. Get in touch directly via WhatsApp, email, or send a message.",
  }}
>
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:py-16">
    
      <!-- Hero / Bio Section -->
      <div class="mb-16 grid gap-10 md:grid-cols-[1fr_auto] md:items-start">
        <div>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-100 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-brand-700 dark:bg-brand-900/40 dark:text-brand-300 mb-2">
            Building in Public • Dubai, UAE
          </span>
          <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-text dark:text-text-dark mb-4">
            Hi, I'm Praveen.
          </h1>
          <p class="text-lg text-text-muted dark:text-text-dark-muted leading-relaxed mb-4">
            I'm a Web Administrator & IT Operations Lead managing 30+ servers, domain DNS, Cloudflare WAF, and automated production pipelines.
          </p>
          <p class="text-base text-text-muted dark:text-text-dark-muted leading-relaxed">
            I use AI tools (DeepSeek, OpenCode, and Python CLI utilities) to build automation workflows, data scripts, and server tools. This site is where I document every real experiment honestly: no fluff.
          </p>
        </div>

        <!-- Social Links -->
        <div class="flex flex-col gap-3 shrink-0">
          <a href="https://wa.me/971562980106" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-5 py-3 text-xs font-bold text-white transition-all hover:bg-emerald-700">
            💬 WhatsApp +971 56 298 0106
          </a>
          <a href="https://x.com/praveenwithapen" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 rounded-xl border border-border px-4 py-2.5 text-xs font-semibold text-text-muted transition-all hover:border-brand-600 hover:text-brand-600">
            @praveenwithapen
          </a>
          <a href="https://www.linkedin.com/in/praveen-kumar-says/" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 rounded-xl border border-border px-4 py-2.5 text-xs font-semibold text-text-muted transition-all hover:border-brand-600 hover:text-brand-600">
            LinkedIn Profile
          </a>
        </div>
      </div>

      <!-- Contact Options Cards -->
      <div class="grid gap-6 md:grid-cols-3 mb-16">
        <!-- WhatsApp -->
        <div class="rounded-2xl border border-emerald-200 bg-emerald-50/50 p-6 dark:border-emerald-800/40 dark:bg-emerald-950/20 flex flex-col justify-between">
          <div>
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-500 text-white text-xl mb-3">💬</span>
            <h3 class="text-base font-bold text-text dark:text-text-dark mb-1">WhatsApp Direct</h3>
            <p class="text-xs text-text-muted dark:text-text-dark-muted mb-4">Fastest response for urgent inquiries or server help.</p>
          </div>
          <a href="https://wa.me/971562980106" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-1.5 rounded-xl bg-emerald-600 px-4 py-2.5 text-xs font-bold text-white transition-all hover:bg-emerald-700">Message Praveen ↗</a>
        </div>

        <!-- Direct Email -->
        <div class="rounded-2xl border border-border bg-surface p-6 dark:border-border-dark dark:bg-surface-dark flex flex-col justify-between">
          <div>
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-100 text-brand-600 dark:bg-brand-900/40 dark:text-brand-400 text-xl mb-3">✉️</span>
            <h3 class="text-base font-bold text-text dark:text-text-dark mb-1">Direct Email</h3>
            <p class="text-xs text-text-muted dark:text-text-dark-muted mb-4">Send technical questions or collaboration ideas.</p>
          </div>
          <a href="mailto:contact@praveentechworld.com" class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-border bg-surface-alt/40 px-4 py-2.5 text-xs font-bold text-text transition-all hover:border-brand-600">contact@praveentechworld.com</a>
        </div>

        <!-- Services -->
        <div class="rounded-2xl border border-indigo-200 bg-indigo-50/50 p-6 dark:border-indigo-800/40 dark:bg-indigo-950/20 flex flex-col justify-between">
          <div>
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-600 text-white text-xl mb-3">🛠️</span>
            <h3 class="text-base font-bold text-text dark:text-text-dark mb-1">Web Admin Services</h3>
            <p class="text-xs text-text-muted dark:text-text-dark-muted mb-4">Need help managing 30+ servers or Cloudflare WAF?</p>
          </div>
          <a href="https://services.praveentechworld.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-1.5 rounded-xl bg-indigo-600 px-4 py-2.5 text-xs font-bold text-white transition-all hover:bg-indigo-700">services.praveentechworld.com ↗</a>
        </div>
      </div>

      <!-- Message Form Section -->
      <div class="rounded-3xl border border-border bg-surface-alt/20 p-6 dark:border-border-dark dark:bg-surface-dark-alt/10 md:p-10">
        <h2 class="text-2xl font-extrabold text-text dark:text-text-dark mb-2">Send a Message</h2>
        <p class="text-sm text-text-muted dark:text-text-dark-muted mb-8 max-w-xl">Fill out the form below to send a direct message.</p>

        <form id="contact-form" action="https://formspree.io/f/xbdejjpr" method="POST" class="space-y-6 max-w-2xl">
          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="name" class="mb-2 block text-xs font-bold uppercase tracking-wider text-text dark:text-text-dark">Full Name *</label>
              <input type="text" id="name" name="name" required class="w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-text placeholder:text-text-muted focus:border-brand-600 focus:outline-none dark:border-border-dark" placeholder="e.g. Alex Smith" />
            </div>
            <div>
              <label for="email" class="mb-2 block text-xs font-bold uppercase tracking-wider text-text dark:text-text-dark">Email Address *</label>
              <input type="email" id="email" name="email" required class="w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-text placeholder:text-text-muted focus:border-brand-600 focus:outline-none dark:border-border-dark" placeholder="alex@company.com" />
            </div>
          </div>

          <div>
            <label for="subject" class="mb-2 block text-xs font-bold uppercase tracking-wider text-text dark:text-text-dark">Subject / Topic</label>
            <select id="subject" name="subject" class="w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-text focus:border-brand-600 focus:outline-none dark:border-border-dark dark:bg-surface-dark dark:text-text-dark-muted">
              <option value="General Inquiry">General Inquiry</option>
              <option value="Server Admin & Services">Web Server & Cloud Hosting Services</option>
              <option value="AI Script or Article Feedback">AI Script / Article Feedback</option>
              <option value="Bug Report">Bug Report / Broken Instruction</option>
            </select>
          </div>

          <div>
            <label for="message" class="mb-2 block text-xs font-bold uppercase tracking-wider text-text dark:text-text-dark">Message Details *</label>
            <textarea id="message" name="message" rows="5" required class="w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-text placeholder:text-text-muted focus:border-brand-600 focus:outline-none dark:border-border-dark" placeholder="Describe your question or message..."></textarea>
          </div>

          <!-- Cloudflare Turnstile Security Widget -->
          <div id="contact-turnstile-wrapper" class="my-4 min-h-[65px] flex justify-start items-center">
            <div id="contact-turnstile-container" class="cf-turnstile" data-sitekey="0x4AAAAAAECkhL7KWrcngk0L" data-action="turnstile-spin-v2" data-theme="auto"></div>
          </div>

          <div id="form-status" class="hidden rounded-xl p-4 text-sm font-medium"></div>

          <button type="submit" id="submit-btn" class="inline-flex items-center justify-center gap-2 rounded-xl bg-brand-600 px-8 py-3.5 text-sm font-bold text-white transition-all hover:bg-brand-700">Send Message 🚀</button>
        </form>
      </div>
  </div>

  <!-- Cloudflare Turnstile Script (load at runtime) -->
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <script>
    const form = document.getElementById('contact-form');
    const statusDiv = document.getElementById('form-status');
    const submitBtn = document.getElementById('submit-btn');

    // Safe Turnstile Render Fallback + explicit widget id
    let turnstileWidgetId = null;

    function initTurnstileWidget() {
      const container = document.getElementById('contact-turnstile-container');
      if (!container) return;

      // If iframe already rendered by Cloudflare auto-script, do nothing
      if (container.querySelector('iframe')) return;

      if (window.turnstile && typeof window.turnstile.render === 'function') {
        try {
          // capture returned widget id so we can get/reset tokens explicitly
          turnstileWidgetId = window.turnstile.render('#contact-turnstile-container', {
            sitekey: '0x4AAAAAAECkhL7KWrcngk0L',
            action: 'turnstile-spin-v2',
            theme: 'auto'
          });
        } catch (err) {
          console.warn('Turnstile render notice:', err);
        }
      }
    }

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      setTimeout(initTurnstileWidget, 200);
      setTimeout(initTurnstileWidget, 1000);
    } else {
      window.addEventListener('load', () => {
        setTimeout(initTurnstileWidget, 200);
        setTimeout(initTurnstileWidget, 1000);
      });
    }

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        submitBtn.disabled = true;
        submitBtn.innerText = 'Sending...';
        statusDiv.className = 'hidden';

        const data = new FormData(form);

        // Try to attach Turnstile token explicitly to FormData
        try {
          if (window.turnstile && turnstileWidgetId !== null) {
            const token = window.turnstile.getResponse(turnstileWidgetId);
            if (token) data.set('cf-turnstile-response', token);
          }
        } catch (err) {
          console.warn('Turnstile token retrieval failed', err);
        }

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: data,
            headers: { 'Accept': 'application/json' }
          });

          if (response.ok) {
            statusDiv.className = 'rounded-xl p-4 text-sm font-medium bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300';
            statusDiv.innerText = '✅ Thank you! Your message has been sent successfully.';
            form.reset();
            if (window.turnstile && turnstileWidgetId !== null) window.turnstile.reset(turnstileWidgetId);
          } else {
            const result = await response.json();
            statusDiv.className = 'rounded-xl p-4 text-sm font-medium bg-rose-100 text-rose-800 dark:bg-rose-900/40 dark:text-rose-300';
            statusDiv.innerText = result.error || '❌ Error sending message. Please use WhatsApp or email.';
            if (window.turnstile && turnstileWidgetId !== null) window.turnstile.reset(turnstileWidgetId);
          }
        } catch (err) {
          statusDiv.className = 'rounded-xl p-4 text-sm font-medium bg-rose-100 text-rose-800 dark:bg-rose-900/40 dark:text-rose-300';
          statusDiv.innerText = '❌ Network error. Message on WhatsApp (+971 56 298 0106) or contact@praveentechworld.com.';
          if (window.turnstile && turnstileWidgetId !== null) window.turnstile.reset(turnstileWidgetId);
        } finally {
          submitBtn.disabled = false;
          submitBtn.innerText = 'Send Message 🚀';
        }
      });
    }
  </script>
</BaseLayout>
