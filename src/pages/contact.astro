---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  seo={{
    title: "Contact Us — Get in Touch with PraveenTechWorld",
    description: "Have a question, feedback, or need help with server administration or IT automation? Reach out directly via WhatsApp, Email, or our message form.",
  }}
>
  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:py-16">
    
    <!-- Header -->
    <div class="max-w-2xl mb-12">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-100 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-brand-700 dark:bg-brand-900/40 dark:text-brand-300 mb-4">
        Direct Contact & Support
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-text dark:text-text-dark mb-4">
        Get in Touch
      </h1>
      <p class="text-base text-text-muted dark:text-text-dark-muted leading-relaxed">
        Based in Dubai, UAE. Whether you found a broken link, need help with a script, have feedback on an article, or want to discuss server administration, I respond to every message.
      </p>
    </div>

    <!-- Contact Channels Grid -->
    <div class="grid gap-6 md:grid-cols-3 mb-16">
      
      <!-- WhatsApp Direct Chat -->
      <div class="relative overflow-hidden rounded-2xl border border-emerald-200 bg-emerald-50/50 p-6 dark:border-emerald-800/40 dark:bg-emerald-950/20 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-500 text-white text-xl">💬</span>
            <span class="inline-flex items-center gap-1 rounded-full bg-emerald-100 px-2.5 py-0.5 text-[11px] font-bold text-emerald-800 dark:bg-emerald-900/60 dark:text-emerald-300">
              Fastest Response
            </span>
          </div>
          <h3 class="text-lg font-bold text-text dark:text-text-dark mb-1">WhatsApp Direct</h3>
          <p class="text-xs text-text-muted dark:text-text-dark-muted mb-4">
            Chat directly with Praveen for urgent inquiries, server help, or technical ops.
          </p>
        </div>
        <a
          href="https://wa.me/971562980106"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-4 py-2.5 text-xs font-bold text-white transition-all hover:bg-emerald-700 hover:shadow-lg hover:shadow-emerald-600/20"
        >
          Message +971 56 298 0106 ↗
        </a>
      </div>

      <!-- Direct Email -->
      <div class="relative overflow-hidden rounded-2xl border border-border bg-surface p-6 dark:border-border-dark dark:bg-surface-dark flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-100 text-brand-600 dark:bg-brand-900/40 dark:text-brand-400 text-xl">✉️</span>
            <span class="text-xs font-medium text-text-muted dark:text-text-dark-muted">1-2 Business Days</span>
          </div>
          <h3 class="text-lg font-bold text-text dark:text-text-dark mb-1">Email Inquiries</h3>
          <p class="text-xs text-text-muted dark:text-text-dark-muted mb-4">
            Send detailed technical questions, error logs, or collaboration requests.
          </p>
        </div>
        <a
          href="mailto:contact@praveentechworld.com"
          class="inline-flex items-center justify-center gap-2 rounded-xl border border-border bg-surface-alt/40 px-4 py-2.5 text-xs font-bold text-text transition-all hover:border-brand-600 hover:text-brand-600 dark:border-border-dark dark:bg-surface-dark-alt/30 dark:text-text-dark dark:hover:border-brand-400 dark:hover:text-brand-400"
        >
          contact@praveentechworld.com
        </a>
      </div>

      <!-- Services Subdomain Portal -->
      <div class="relative overflow-hidden rounded-2xl border border-indigo-200 bg-indigo-50/50 p-6 dark:border-indigo-800/40 dark:bg-indigo-950/20 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-600 text-white text-xl">🛠️</span>
            <span class="inline-flex items-center gap-1 rounded-full bg-indigo-100 px-2.5 py-0.5 text-[11px] font-bold text-indigo-800 dark:bg-indigo-900/60 dark:text-indigo-300">
              Web Admin Hub
            </span>
          </div>
          <h3 class="text-lg font-bold text-text dark:text-text-dark mb-1">Client Services</h3>
          <p class="text-xs text-text-muted dark:text-text-dark-muted mb-4">
            Looking for 30+ server administration, Cloudflare WAF setup, or e-commerce ops?
          </p>
        </div>
        <a
          href="https://services.praveentechworld.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-xs font-bold text-white transition-all hover:bg-indigo-700 hover:shadow-lg hover:shadow-indigo-600/20"
        >
          services.praveentechworld.com ↗
        </a>
      </div>

    </div>

    <!-- Message Form Section -->
    <div class="rounded-3xl border border-border bg-surface-alt/20 p-6 dark:border-border-dark dark:bg-surface-dark-alt/10 md:p-10">
      <h2 class="text-2xl font-extrabold text-text dark:text-text-dark mb-2">Send a Message</h2>
      <p class="text-sm text-text-muted dark:text-text-dark-muted mb-8 max-w-xl">
        Fill out the form below. Messages are delivered directly to Praveen's inbox.
      </p>

      <form
        id="contact-form"
        action="https://formspree.io/f/xbdejjpr"
        method="POST"
        class="space-y-6 max-w-2xl"
      >
        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="name" class="mb-2 block text-xs font-bold uppercase tracking-wider text-text dark:text-text-dark">Full Name *</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-text placeholder:text-text-muted focus:border-brand-600 focus:outline-none dark:border-border-dark dark:bg-surface-dark dark:text-text-dark dark:placeholder:text-text-dark-muted"
              placeholder="e.g. Alex Smith"
            />
          </div>
          <div>
            <label for="email" class="mb-2 block text-xs font-bold uppercase tracking-wider text-text dark:text-text-dark">Email Address *</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-text placeholder:text-text-muted focus:border-brand-600 focus:outline-none dark:border-border-dark dark:bg-surface-dark dark:text-text-dark dark:placeholder:text-text-dark-muted"
              placeholder="alex@company.com"
            />
          </div>
        </div>

        <div>
          <label for="subject" class="mb-2 block text-xs font-bold uppercase tracking-wider text-text dark:text-text-dark">Subject / Topic</label>
          <select
            id="subject"
            name="subject"
            class="w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-text focus:border-brand-600 focus:outline-none dark:border-border-dark dark:bg-surface-dark dark:text-text-dark"
          >
            <option value="General Inquiry">General Inquiry</option>
            <option value="Server Admin & Services">Web Server & Cloud Hosting Services</option>
            <option value="AI Script or Article Feedback">AI Script / Article Feedback</option>
            <option value="Bug Report">Bug Report / Broken Instruction</option>
          </select>
        </div>

        <div>
          <label for="message" class="mb-2 block text-xs font-bold uppercase tracking-wider text-text dark:text-text-dark">Message Details *</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-text placeholder:text-text-muted focus:border-brand-600 focus:outline-none dark:border-border-dark dark:bg-surface-dark dark:text-text-dark dark:placeholder:text-text-dark-muted"
            placeholder="Describe your question or message with as much detail as possible..."
          ></textarea>
        </div>

        <div id="form-status" class="hidden rounded-xl p-4 text-sm font-medium"></div>

        <button
          type="submit"
          id="submit-btn"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-brand-600 px-8 py-3.5 text-sm font-bold text-white transition-all hover:bg-brand-700 hover:shadow-lg hover:shadow-brand-600/25 disabled:opacity-50"
        >
          Send Message 🚀
        </button>
      </form>
    </div>

  </div>

  <script is:inline>
    const form = document.getElementById('contact-form');
    const statusDiv = document.getElementById('form-status');
    const submitBtn = document.getElementById('submit-btn');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        submitBtn.disabled = true;
        submitBtn.innerText = 'Sending...';
        statusDiv.className = 'hidden';

        try {
          const data = new FormData(form);
          const response = await fetch(form.action, {
            method: 'POST',
            body: data,
            headers: {
              'Accept': 'application/json'
            }
          });

          if (response.ok) {
            statusDiv.className = 'rounded-xl p-4 text-sm font-medium bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300';
            statusDiv.innerText = '✅ Thank you! Your message has been sent successfully. I will get back to you shortly.';
            form.reset();
          } else {
            const result = await response.json();
            statusDiv.className = 'rounded-xl p-4 text-sm font-medium bg-rose-100 text-rose-800 dark:bg-rose-900/40 dark:text-rose-300';
            statusDiv.innerText = result.error || '❌ Oops! There was an issue sending your message. Please try WhatsApp or email directly.';
          }
        } catch (err) {
          statusDiv.className = 'rounded-xl p-4 text-sm font-medium bg-rose-100 text-rose-800 dark:bg-rose-900/40 dark:text-rose-300';
          statusDiv.innerText = '❌ Network error. Please message directly on WhatsApp (+971 56 298 0106) or email contact@praveentechworld.com.';
        } finally {
          submitBtn.disabled = false;
          submitBtn.innerText = 'Send Message 🚀';
        }
      });
    }
  </script>
</BaseLayout>
