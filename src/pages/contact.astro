---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  seo={{
    title: "About & Contact — Praveen (IT Operations Lead & Web Administrator)",
    description: "Learn about Praveen, Web Administrator & IT Operations Lead based in Dubai. Get in touch directly via WhatsApp, email, or send a message.",
  }}
>
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:py-16">
    
    <!-- Hero / Bio Section -->
    <div class="mb-16 grid gap-10 md:grid-cols-[1fr_auto] md:items-start">
      <div>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-100 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-brand-700 dark:bg-brand-900/40 dark:text-brand-300 mb-4">
          Building in Public • Dubai, UAE
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-text dark:text-text-dark mb-4">
          Hi, I'm Praveen.
        </h1>
        <p class="text-lg text-text-muted dark:text-text-dark-muted leading-relaxed mb-4">
          I'm a Web Administrator & IT Operations Lead managing 30+ servers, domain DNS, Cloudflare WAF, and automated production pipelines.
        </p>
        <p class="text-base text-text-muted dark:text-text-dark-muted leading-relaxed">
          I use AI tools (DeepSeek, OpenCode, and Python CLI utilities) to build automation workflows, data scripts, and server tools. This site is where I document every real experiment honestly: what worked, what broke, and how it was resolved.
        </p>
      </div>

      <!-- Social Links -->
      <div class="flex flex-col gap-3 shrink-0">
        <a
          href="https://wa.me/971562980106"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-5 py-3 text-xs font-bold text-white transition-all hover:bg-emerald-700 hover:shadow-lg hover:shadow-emerald-600/20"
        >
          💬 WhatsApp +971 56 298 0106
        </a>
        <a
          href="https://x.com/praveenwithapen"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 rounded-xl border border-border px-4 py-2.5 text-xs font-semibold text-text-muted transition-all hover:border-brand-600 hover:text-brand-600 dark:border-border-dark dark:text-text-dark-muted dark:hover:border-brand-400 dark:hover:text-brand-400"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          @praveenwithapen
        </a>
        <a
          href="https://www.linkedin.com/in/praveen-kumar-says/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 rounded-xl border border-border px-4 py-2.5 text-xs font-semibold text-text-muted transition-all hover:border-brand-600 hover:text-brand-600 dark:border-border-dark dark:text-text-dark-muted dark:hover:border-brand-400 dark:hover:text-brand-400"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          LinkedIn Profile
        </a>
      </div>
    </div>

    <!-- Contact Options Cards -->
    <div class="grid gap-6 md:grid-cols-3 mb-16">
      
      <!-- WhatsApp Direct Chat -->
      <div class="rounded-2xl border border-emerald-200 bg-emerald-50/50 p-6 dark:border-emerald-800/40 dark:bg-emerald-950/20 flex flex-col justify-between">
        <div>
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-500 text-white text-xl mb-3">💬</span>
          <h3 class="text-base font-bold text-text dark:text-text-dark mb-1">WhatsApp Direct</h3>
          <p class="text-xs text-text-muted dark:text-text-dark-muted mb-4">Fastest response for urgent inquiries or server help.</p>
        </div>
        <a
          href="https://wa.me/971562980106"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-1.5 rounded-xl bg-emerald-600 px-4 py-2.5 text-xs font-bold text-white transition-all hover:bg-emerald-700"
        >
          Message Praveen ↗
        </a>
      </div>

      <!-- Direct Email -->
      <div class="rounded-2xl border border-border bg-surface p-6 dark:border-border-dark dark:bg-surface-dark flex flex-col justify-between">
        <div>
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-100 text-brand-600 dark:bg-brand-900/40 dark:text-brand-400 text-xl mb-3">✉️</span>
          <h3 class="text-base font-bold text-text dark:text-text-dark mb-1">Direct Email</h3>
          <p class="text-xs text-text-muted dark:text-text-dark-muted mb-4">Send technical questions or collaboration ideas.</p>
        </div>
        <a
          href="mailto:contact@praveentechworld.com"
          class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-border bg-surface-alt/40 px-4 py-2.5 text-xs font-bold text-text transition-all hover:border-brand-600 hover:text-brand-600 dark:border-border-dark dark:bg-surface-dark-alt/30 dark:text-text-dark"
        >
          contact@praveentechworld.com
        </a>
      </div>

      <!-- Web Admin Services Subdomain -->
      <div class="rounded-2xl border border-indigo-200 bg-indigo-50/50 p-6 dark:border-indigo-800/40 dark:bg-indigo-950/20 flex flex-col justify-between">
        <div>
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-600 text-white text-xl mb-3">🛠️</span>
          <h3 class="text-base font-bold text-text dark:text-text-dark mb-1">Web Admin Services</h3>
          <p class="text-xs text-text-muted dark:text-text-dark-muted mb-4">Need help managing 30+ servers or Cloudflare WAF?</p>
        </div>
        <a
          href="https://services.praveentechworld.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-1.5 rounded-xl bg-indigo-600 px-4 py-2.5 text-xs font-bold text-white transition-all hover:bg-indigo-700"
        >
          services.praveentechworld.com ↗
        </a>
      </div>

    </div>

    <!-- Message Form Section -->
    <div class="rounded-3xl border border-border bg-surface-alt/20 p-6 dark:border-border-dark dark:bg-surface-dark-alt/10 md:p-10">
      <h2 class="text-2xl font-extrabold text-text dark:text-text-dark mb-2">Send a Message</h2>
      <p class="text-sm text-text-muted dark:text-text-dark-muted mb-8 max-w-xl">
        Fill out the form below to send a direct message.
      </p>

      <form
        id="contact-form"
        action="https://formspree.io/f/xbdejjpr"
        method="POST"
        class="space-y-6 max-w-2xl"
      >
        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="name" class="mb-2 block text-xs font-bold uppercase tracking-wider text-text dark:text-text-dark">Full Name *</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-text placeholder:text-text-muted focus:border-brand-600 focus:outline-none dark:border-border-dark dark:bg-surface-dark dark:text-text-dark dark:placeholder:text-text-dark-muted"
              placeholder="e.g. Alex Smith"
            />
          </div>
          <div>
            <label for="email" class="mb-2 block text-xs font-bold uppercase tracking-wider text-text dark:text-text-dark">Email Address *</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-text placeholder:text-text-muted focus:border-brand-600 focus:outline-none dark:border-border-dark dark:bg-surface-dark dark:text-text-dark dark:placeholder:text-text-dark-muted"
              placeholder="alex@company.com"
            />
          </div>
        </div>

        <div>
          <label for="subject" class="mb-2 block text-xs font-bold uppercase tracking-wider text-text dark:text-text-dark">Subject / Topic</label>
          <select
            id="subject"
            name="subject"
            class="w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-text focus:border-brand-600 focus:outline-none dark:border-border-dark dark:bg-surface-dark dark:text-text-dark"
          >
            <option value="General Inquiry">General Inquiry</option>
            <option value="Server Admin & Services">Web Server & Cloud Hosting Services</option>
            <option value="AI Script or Article Feedback">AI Script / Article Feedback</option>
            <option value="Bug Report">Bug Report / Broken Instruction</option>
          </select>
        </div>

        <div>
          <label for="message" class="mb-2 block text-xs font-bold uppercase tracking-wider text-text dark:text-text-dark">Message Details *</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-text placeholder:text-text-muted focus:border-brand-600 focus:outline-none dark:border-border-dark dark:bg-surface-dark dark:text-text-dark dark:placeholder:text-text-dark-muted"
            placeholder="Describe your question or message..."
          ></textarea>
        </div>

        <!-- Cloudflare Turnstile Security Widget -->
        <div id="contact-turnstile-wrapper" class="my-4 min-h-[65px]">
          <div
            id="contact-turnstile-container"
            class="cf-turnstile"
            data-sitekey="0x4AAAAAAECdrXzclXfWcMEd"
            data-action="turnstile-spin-v2"
            data-theme="auto"
          ></div>
        </div>

        <div id="form-status" class="hidden rounded-xl p-4 text-sm font-medium"></div>

        <button
          type="submit"
          id="submit-btn"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-brand-600 px-8 py-3.5 text-sm font-bold text-white transition-all hover:bg-brand-700 hover:shadow-lg hover:shadow-brand-600/25 disabled:opacity-50"
        >
          Send Message 🚀
        </button>
      </form>
    </div>

  </div>

  <!-- Turnstile Script -->
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <script is:inline>
    const form = document.getElementById('contact-form');
    const statusDiv = document.getElementById('form-status');
    const submitBtn = document.getElementById('submit-btn');

    // Explicit Turnstile Render Fallback
    function ensureTurnstileRender() {
      if (window.turnstile && document.getElementById('contact-turnstile-container')) {
        try {
          if (!document.querySelector('#contact-turnstile-container iframe')) {
            window.turnstile.render('#contact-turnstile-container', {
              sitekey: '0x4AAAAAAECdrXzclXfWcMEd',
              action: 'turnstile-spin-v2',
              theme: 'auto'
            });
          }
        } catch (e) {
          console.log('Turnstile auto-rendered by script tag');
        }
      }
    }

    if (document.readyState === 'complete') {
      setTimeout(ensureTurnstileRender, 300);
    } else {
      window.addEventListener('load', () => setTimeout(ensureTurnstileRender, 300));
    }

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        submitBtn.disabled = true;
        submitBtn.innerText = 'Sending...';
        statusDiv.className = 'hidden';

        try {
          const data = new FormData(form);
          const response = await fetch(form.action, {
            method: 'POST',
            body: data,
            headers: {
              'Accept': 'application/json'
            }
          });

          if (response.ok) {
            statusDiv.className = 'rounded-xl p-4 text-sm font-medium bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300';
            statusDiv.innerText = '✅ Thank you! Your message has been sent successfully.';
            form.reset();
            if (window.turnstile) window.turnstile.reset();
          } else {
            const result = await response.json();
            statusDiv.className = 'rounded-xl p-4 text-sm font-medium bg-rose-100 text-rose-800 dark:bg-rose-900/40 dark:text-rose-300';
            statusDiv.innerText = result.error || '❌ Error sending message. Please use WhatsApp or email.';
            if (window.turnstile) window.turnstile.reset();
          }
        } catch (err) {
          statusDiv.className = 'rounded-xl p-4 text-sm font-medium bg-rose-100 text-rose-800 dark:bg-rose-900/40 dark:text-rose-300';
          statusDiv.innerText = '❌ Network error. Message on WhatsApp (+971 56 298 0106) or contact@praveentechworld.com.';
          if (window.turnstile) window.turnstile.reset();
        } finally {
          submitBtn.disabled = false;
          submitBtn.innerText = 'Send Message 🚀';
        }
      });
    }
  </script>
</BaseLayout>
