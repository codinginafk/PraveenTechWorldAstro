---
import BaseLayout from "@layouts/BaseLayout.astro";
import Icon from "@components/common/Icon.astro";
---

<BaseLayout
  seo={{
    title: "Contact & About Praveen | IT Operations Lead",
    description: "Learn about Praveen, Web Administrator & IT Operations Lead based in Dubai. Get in touch directly via WhatsApp, email, or send a message.",
  }}
>
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:py-16">
    
      <!-- Hero / Bio Section -->
      <div class="mb-16 grid gap-10 md:grid-cols-[1fr_auto] md:items-start">
        <div>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-100 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-brand-700 dark:bg-brand-900/40 dark:text-brand-300 mb-2">
            Building in Public • Dubai, UAE
          </span>
          <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-text dark:text-text-dark mb-4">
            Hi, I'm Praveen.
          </h1>
          <p class="text-lg text-text-muted dark:text-text-dark-muted leading-relaxed mb-4">
            I'm a Web Administrator & IT Operations Lead managing 30+ servers, domain DNS, Cloudflare WAF, and automated production pipelines.
          </p>
          <p class="text-base text-text-muted dark:text-text-dark-muted leading-relaxed">
            I use AI tools (DeepSeek, OpenCode, and Python CLI utilities) to build automation workflows, data scripts, and server tools. This site is where I document every real experiment honestly: no fluff.
          </p>
        </div>

        <!-- Social Links -->
        <div class="flex flex-col gap-3 shrink-0">
          <a href="https://wa.me/971562980106" target="_blank" rel="nofollow noopener noreferrer" class="flex items-center justify-center gap-2 rounded-xl bg-accent-700 px-5 py-3 text-xs font-bold text-white transition-all hover:bg-accent-800">
            <Icon name="chat" class="w-4 h-4" /> WhatsApp +971 56 298 0106
          </a>
          <a href="https://x.com/praveenwithapen" target="_blank" rel="nofollow noopener noreferrer" class="flex items-center justify-center gap-2 rounded-xl border border-border px-4 py-2.5 text-xs font-semibold text-text-muted transition-all hover:border-brand-600 hover:text-brand-700">
            @praveenwithapen
          </a>
          <a href="https://www.linkedin.com/in/praveen-kumar-says/" target="_blank" rel="nofollow noopener noreferrer" class="flex items-center justify-center gap-2 rounded-xl border border-border px-4 py-2.5 text-xs font-semibold text-text-muted transition-all hover:border-brand-600 hover:text-brand-700">
            LinkedIn Profile
          </a>
        </div>
      </div>

      <!-- Contact Options Cards -->
      <h2 class="text-xl font-bold text-text dark:text-text-dark mb-6">Direct Consultation & Inquiries</h2>
      <div class="grid gap-6 md:grid-cols-3 mb-16">
        <!-- WhatsApp -->
        <div class="rounded-2xl border border-brand-200 bg-brand-50/50 p-6 dark:border-brand-800/40 dark:bg-brand-950/20 flex flex-col justify-between">
          <div>
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-accent-700 text-white mb-3"><Icon name="chat" class="w-5 h-5" /></span>
            <h3 class="text-base font-bold text-text dark:text-text-dark mb-1">WhatsApp Direct</h3>
            <p class="text-xs text-text-muted dark:text-text-dark-muted mb-4">Fastest response for urgent inquiries or server help.</p>
          </div>
          <a href="https://wa.me/971562980106" target="_blank" rel="nofollow noopener noreferrer" class="inline-flex items-center justify-center gap-1.5 rounded-xl bg-accent-700 px-4 py-2.5 text-xs font-bold text-white transition-all hover:bg-accent-800">Message Praveen ↗</a>
        </div>

        <!-- Direct Email -->
        <div class="rounded-2xl border border-border bg-surface p-6 dark:border-border-dark dark:bg-surface-dark flex flex-col justify-between">
          <div>
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-100 text-brand-700 dark:bg-brand-900/40 dark:text-brand-300 mb-3"><Icon name="mail" class="w-5 h-5" /></span>
            <h3 class="text-base font-bold text-text dark:text-text-dark mb-1">Direct Email</h3>
            <p class="text-xs text-text-muted dark:text-text-dark-muted mb-4">Send technical questions or collaboration ideas.</p>
          </div>
          <!--email_off--><a href="mailto:contact@praveentechworld.com" class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-border bg-surface-alt/40 px-4 py-2.5 text-xs font-bold text-text transition-all hover:border-brand-600">contact@praveentechworld.com</a><!--/email_off-->
        </div>

        <!-- Services -->
        <div class="rounded-2xl border border-border bg-surface p-6 dark:border-border-dark dark:bg-surface-dark flex flex-col justify-between">
          <div>
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-100 text-brand-700 dark:bg-brand-900/40 dark:text-brand-300 mb-3"><Icon name="wrench" class="w-5 h-5" /></span>
            <h3 class="text-base font-bold text-text dark:text-text-dark mb-1">Web Admin Services</h3>
            <p class="text-xs text-text-muted dark:text-text-dark-muted mb-4">Need help managing 30+ servers or Cloudflare WAF?</p>
          </div>
          <a href="https://services.praveentechworld.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-1.5 rounded-xl bg-accent-700 px-4 py-2.5 text-xs font-bold text-white transition-all hover:bg-accent-800">services.praveentechworld.com ↗</a>
        </div>
      </div>

      <!-- Message Form Section -->
      <div class="rounded-3xl border border-border bg-surface-alt/20 p-6 dark:border-border-dark dark:bg-surface-dark-alt/10 md:p-10">
        <h2 class="text-2xl font-extrabold text-text dark:text-text-dark mb-2">Send a Message</h2>
        <p class="text-sm text-text-muted dark:text-text-dark-muted mb-8 max-w-xl">Fill out the form below to send a direct message.</p>

        <form id="contact-form" action="https://formspree.io/f/xbdejjpr" method="POST" class="space-y-6 max-w-2xl">
          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="name" class="mb-2 block text-xs font-bold uppercase tracking-wider text-text dark:text-text-dark">Full Name *</label>
              <input type="text" id="name" name="name" required class="w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-text placeholder:text-text-muted focus:border-brand-600 focus:outline-none dark:border-border-dark" placeholder="Your Full Name" />
            </div>
            <div>
              <label for="email" class="mb-2 block text-xs font-bold uppercase tracking-wider text-text dark:text-text-dark">Email Address *</label>
              <input type="email" id="email" name="email" required class="w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-text placeholder:text-text-muted focus:border-brand-600 focus:outline-none dark:border-border-dark" placeholder="Enter your email address" />
            </div>
          </div>

          <div>
            <label for="subject" class="mb-2 block text-xs font-bold uppercase tracking-wider text-text dark:text-text-dark">Subject / Topic</label>
            <select id="subject" name="subject" class="w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-text focus:border-brand-600 focus:outline-none dark:border-border-dark dark:bg-surface-dark dark:text-text-dark-muted">
              <option value="General Inquiry">General Inquiry</option>
              <option value="Server Admin & Services">Web Server & Cloud Hosting Services</option>
              <option value="AI Script or Article Feedback">AI Script / Article Feedback</option>
              <option value="Bug Report">Bug Report / Broken Instruction</option>
            </select>
          </div>

          <div>
            <label for="message" class="mb-2 block text-xs font-bold uppercase tracking-wider text-text dark:text-text-dark">Message Details *</label>
            <textarea id="message" name="message" rows="5" required class="w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-text placeholder:text-text-muted focus:border-brand-600 focus:outline-none dark:border-border-dark" placeholder="Describe your question or message..."></textarea>
          </div>

          <!-- Cloudflare Turnstile Security Widget -->
          <div id="contact-turnstile-wrapper" class="my-4 min-h-[65px] flex flex-col justify-start items-start gap-1">
            <div id="contact-turnstile-container"></div>
            <p id="turnstile-status-msg" class="hidden text-xs text-amber-600 dark:text-amber-400 font-medium"></p>
          </div>

          <div id="form-status" class="hidden rounded-xl p-4 text-sm font-medium"></div>

          <button type="submit" id="submit-btn" class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent-700 px-8 py-3.5 text-sm font-bold text-white transition-all hover:bg-accent-800"><Icon name="send" class="w-4 h-4" /> Send Message</button>
        </form>
      </div>

      <!-- Contact Expectations & Lab Inquiries -->
      <div class="mt-12 grid gap-6 md:grid-cols-2 text-text dark:text-text-dark">
        <div class="rounded-2xl border border-border bg-surface p-6 dark:border-border-dark dark:bg-surface-dark">
          <h3 class="text-base font-bold mb-2 flex items-center gap-2">
            <Icon name="clock" class="w-4.5 h-4.5 text-brand-700 dark:text-brand-300 shrink-0" /> Response Times & Lab Availability
          </h3>
          <p class="text-sm text-text-muted dark:text-text-dark-muted leading-relaxed">
            Our engineering team reviews all incoming messages during Gulf Standard Time (GST, UTC+4) business hours. We reply to all genuine technical questions within 24 to 48 hours. For critical server outages or urgent Cloudflare WAF issues, reach out via WhatsApp for direct routing.
          </p>
        </div>

        <div class="rounded-2xl border border-border bg-surface p-6 dark:border-border-dark dark:bg-surface-dark">
          <h3 class="text-base font-bold mb-2 flex items-center gap-2">
            <Icon name="flask" class="w-4.5 h-4.5 text-brand-700 dark:text-brand-300 shrink-0" /> Test Bench Reproduction Requests
          </h3>
          <p class="text-sm text-text-muted dark:text-text-dark-muted leading-relaxed">
            Did a recent Windows update, GPU driver release, or Linux kernel patch cause an unexplained crash on your setup? Submit your minidump codes and Event Viewer log IDs. When issues are reproducible, our team replicates them on bare-metal test rigs and publishes step-by-step solutions.
          </p>
        </div>

        <div class="rounded-2xl border border-border bg-surface p-6 dark:border-border-dark dark:bg-surface-dark">
          <h3 class="text-base font-bold mb-2 flex items-center gap-2">
            <Icon name="shield" class="w-4.5 h-4.5 text-brand-700 dark:text-brand-300 shrink-0" /> Security & Vulnerability Reporting
          </h3>
          <p class="text-sm text-text-muted dark:text-text-dark-muted leading-relaxed">
            We practice responsible disclosure for all security research, CVE triage, and network telemetry audits. If you identify a security defect or wish to submit packet captures for our open research benchmarks, please include clear reproduction steps and payload hashes.
          </p>
        </div>

        <div class="rounded-2xl border border-border bg-surface p-6 dark:border-border-dark dark:bg-surface-dark">
          <h3 class="text-base font-bold mb-2 flex items-center gap-2">
            <Icon name="pen" class="w-4.5 h-4.5 text-brand-700 dark:text-brand-300 shrink-0" /> Editorial Corrections & Feedback
          </h3>
          <p class="text-sm text-text-muted dark:text-text-dark-muted leading-relaxed">
            Every PowerShell script, registry tweak, and operational runbook on PraveenTechWorld is tested in our lab. If a new OS release modifies a command syntax or invalidates a workaround, let us know so we can update the live documentation and credit your contribution.
          </p>
        </div>
      </div>
  </div>

  <!-- Cloudflare Turnstile Script (explicit rendering) -->
  <script is:inline>
    window.onTurnstileLoaded = function() {
      if (typeof window.__initContactTurnstile === 'function') {
        window.__initContactTurnstile();
      }
    };
  </script>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onTurnstileLoaded&render=explicit" async defer></script>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const statusDiv = document.getElementById('form-status') as HTMLElement | null;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const turnstileMsg = document.getElementById('turnstile-status-msg') as HTMLElement | null;

    let turnstileWidgetId: string | null = null;
    let turnstileToken: string | null = null;

    function initContactTurnstile() {
      const container = document.getElementById('contact-turnstile-container');
      if (!container || !window.turnstile || turnstileWidgetId !== null || container.children.length > 0) return;

      try {
        turnstileWidgetId = window.turnstile.render(container, {
          sitekey: '0x4AAAAAAECkhL7KWrcngk0L',
          theme: 'auto',
          callback: (token: string) => {
            turnstileToken = token;
            if (turnstileMsg) {
              turnstileMsg.classList.add('hidden');
              turnstileMsg.innerText = '';
            }
            if (statusDiv && statusDiv.innerText.includes('security verification')) {
              statusDiv.classList.add('hidden');
              statusDiv.innerText = '';
            }
          },
          'expired-callback': () => {
            turnstileToken = null;
          },
          'error-callback': () => {
            turnstileToken = null;
            if (turnstileMsg) {
              turnstileMsg.classList.remove('hidden');
              turnstileMsg.innerText = 'Security verification failed to load. Please refresh the page.';
            }
          }
        });
      } catch (err) {
        console.warn('Turnstile render notice:', err);
      }
    }

    (window as any).__initContactTurnstile = initContactTurnstile;
    if (window.turnstile) {
      initContactTurnstile();
    }

    if (form && statusDiv && submitBtn) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // 1. Validate Turnstile token before sending
        let token = turnstileToken;
        if (!token && window.turnstile && turnstileWidgetId !== null) {
          try {
            token = window.turnstile.getResponse(turnstileWidgetId);
          } catch (err) {}
        }
        if (!token) {
          const hiddenInput = form.querySelector('input[name="cf-turnstile-response"]') as HTMLInputElement | null;
          if (hiddenInput && hiddenInput.value) token = hiddenInput.value;
        }

        if (!token) {
          if (turnstileMsg) {
            turnstileMsg.classList.remove('hidden');
            turnstileMsg.innerText = 'Please check the verification box above before sending.';
          }
          statusDiv.className = 'rounded-xl p-4 text-sm font-medium bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300';
          statusDiv.innerText = 'Please complete the Cloudflare security verification above.';
          return;
        }

        submitBtn.disabled = true;
        submitBtn.innerText = 'Sending...';
        statusDiv.className = 'hidden';
        if (turnstileMsg) {
          turnstileMsg.classList.add('hidden');
          turnstileMsg.innerText = '';
        }

        const data = new FormData(form);
        data.set('cf-turnstile-response', token);

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: data,
            headers: { 'Accept': 'application/json' }
          });

          if (response.ok) {
            statusDiv.className = 'rounded-xl p-4 text-sm font-medium bg-brand-100 text-brand-800 dark:bg-brand-900/40 dark:text-brand-300';
            statusDiv.innerText = 'Thank you! Your message has been sent successfully.';
            form.reset();
            turnstileToken = null;
            if (window.turnstile && turnstileWidgetId !== null) {
              window.turnstile.reset(turnstileWidgetId);
            }
          } else {
            const result = await response.json().catch(() => ({}));
            statusDiv.className = 'rounded-xl p-4 text-sm font-medium bg-rose-100 text-rose-800 dark:bg-rose-900/40 dark:text-rose-300';
            statusDiv.innerText = result.error || 'Error sending message. Please use WhatsApp or email.';
            turnstileToken = null;
            if (window.turnstile && turnstileWidgetId !== null) {
              window.turnstile.reset(turnstileWidgetId);
            }
          }
        } catch (err) {
          statusDiv.className = 'rounded-xl p-4 text-sm font-medium bg-rose-100 text-rose-800 dark:bg-rose-900/40 dark:text-rose-300';
          statusDiv.innerText = 'Network error. Message on WhatsApp (+971 56 298 0106) or contact@praveentechworld.com.';
          turnstileToken = null;
          if (window.turnstile && turnstileWidgetId !== null) {
            window.turnstile.reset(turnstileWidgetId);
          }
        } finally {
          submitBtn.disabled = false;
          submitBtn.innerText = 'Send Message';
        }
      });
    }
  </script>
</BaseLayout>
