---
import BaseLayout from "@layouts/BaseLayout.astro";
import SchemaOrg from "@components/seo/SchemaOrg.astro";
import { getPublishedArticles } from "@lib/content/posts";
import { getCollection } from "astro:content";
import ArticleCard from "@components/content/ArticleCard.astro";
import { formatDate } from "@lib/utils/dateFormat";
import { calculateReadingTime } from "@lib/utils/readingTime";

const homeFaqItems = [
  {
    question: "What is PraveenTechWorld?",
    answer: "PraveenTechWorld is an independent engineering and sysadmin knowledge base founded by Praveen Kumar. Our team publishes field-tested Windows troubleshooting guides, Linux and WSL runbooks, local AI deployment benchmarks, and practical DevOps automation scripts.",
  },
  {
    question: "How does your team test and verify technical guides before publishing?",
    answer: "Every diagnostic step, registry edit, and PowerShell script is physically verified in our hardware workbench lab on bare-metal workstations and isolated Hyper-V/Proxmox virtual machines running Windows 11 and Linux. We verify error reproduction, capture Event Viewer logs, test the fix, and confirm zero system regression before documentation.",
  },
  {
    question: "Are the PowerShell commands and scripts safe to run on production machines?",
    answer: "Yes. All scripts are designed with defensive defaults, non-destructive validation flags, and error-handling try/catch blocks. We provide exact manual verification commands alongside automated one-liners so sysadmins can inspect every parameter before execution.",
  },
  {
    question: "How do I calculate GPU VRAM requirements before running local LLMs?",
    answer: "You can use our free interactive LLM VRAM Calculator at /tools/vram-calculator. It models exact model weight sizes across FP16, Q8, Q4_K_M, and FP8 precision formats, adding real-world KV cache allocations, CUDA context overhead, and OS display memory buffers.",
  },
  {
    question: "Can I request a custom troubleshooting guide or report an issue?",
    answer: "Yes. You can contact our engineering team directly through our contact page (/contact) or via our Dubai direct WhatsApp desk. We frequently turn reader support requests and exotic enterprise crash logs into comprehensive, step-by-step diagnostic runbooks.",
  },
];

const allArticles = await getPublishedArticles();
const categories = await getCollection("categories");
const recentCutoff = new Date();
recentCutoff.setDate(recentCutoff.getDate() - 30);
const recentArticles = allArticles.filter((article) => new Date(article.data.publishDate) >= recentCutoff);

// Get 9 latest articles for the homepage
const latestArticles = allArticles.slice(0, 9);
const heroArticle = latestArticles[0];
const secondaryArticles = latestArticles.slice(1, 3);
const gridArticles = latestArticles.slice(3, 9);

// Count articles per category
const categoryCounts: Record<string, number> = {};
allArticles.forEach(a => {
  categoryCounts[a.data.category] = (categoryCounts[a.data.category] || 0) + 1;
});

const categoryMeta: Record<string, { icon: string; color: string; gradient: string }> = {
  "website-setup":   { icon: "🌐", color: "text-blue-600 dark:text-blue-400", gradient: "from-blue-600/15 to-cyan-500/10" },
  "windows-fixes":   { icon: "🛠️", color: "text-orange-600 dark:text-orange-400", gradient: "from-orange-600/15 to-amber-500/10" },
  "hosting-infra":   { icon: "☁️", color: "text-sky-600 dark:text-sky-400", gradient: "from-sky-600/15 to-indigo-500/10" },
  "ai-websites":     { icon: "🤖", color: "text-violet-600 dark:text-violet-400", gradient: "from-violet-600/15 to-purple-500/10" },
  "ai-automation":   { icon: "⚙️", color: "text-emerald-600 dark:text-emerald-400", gradient: "from-emerald-600/15 to-teal-500/10" },
  "it-operations":   { icon: "🖥️", color: "text-rose-600 dark:text-rose-400", gradient: "from-rose-600/15 to-pink-500/10" },
  "build-in-public": { icon: "📢", color: "text-amber-600 dark:text-amber-400", gradient: "from-amber-600/15 to-yellow-500/10" },
  "android-fixes":   { icon: "📱", color: "text-green-600 dark:text-green-400", gradient: "from-green-600/15 to-lime-500/10" },
  "productivity":    { icon: "📊", color: "text-indigo-600 dark:text-indigo-400", gradient: "from-indigo-600/15 to-blue-500/10" },
  "privacy":         { icon: "🔒", color: "text-red-600 dark:text-red-400", gradient: "from-red-600/15 to-rose-500/10" },
  "career-growth":   { icon: "🚀", color: "text-fuchsia-600 dark:text-fuchsia-400", gradient: "from-fuchsia-600/15 to-purple-500/10" },
};
---

<BaseLayout
  seo={{
    title: "PraveenTechWorld: AI Automation, IT Ops, Windows Guides",
    description:
      "Practical Windows troubleshooting, AI automation, and IT operations guides from an IT Ops Lead. Clear steps, safer fixes, and evidence you can follow.",
  }}
>
  <SchemaOrg type="faq" faqItems={homeFaqItems} />

  <!-- ═══ HERO ═══ -->
  <section class="relative overflow-hidden">
    <!-- Subtle background pattern -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_50%_at_50%_-20%,rgba(99,102,241,0.08),transparent)] dark:bg-[radial-gradient(ellipse_80%_50%_at_50%_-20%,rgba(99,102,241,0.15),transparent)]"></div>
    
    <div class="relative mx-auto max-w-6xl px-6 pt-16 pb-12 md:pt-24 md:pb-16">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-brand-700 dark:border-brand-800/40 dark:bg-brand-900/20 dark:text-brand-400 mb-6">
          <span class="inline-block w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
          Building in Public
        </span>
        <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl md:text-6xl mb-6 text-text dark:text-text-dark leading-[1.1]">
          Fix Windows. Automate IT.
          <span class="bg-gradient-to-r from-brand-600 via-brand-500 to-brand-400 dark:from-brand-400 dark:via-brand-300 dark:to-accent-400 bg-clip-text text-transparent"> Ship with AI.</span>
        </h1>
        <p class="text-lg text-text-muted dark:text-text-dark-muted max-w-2xl leading-relaxed mb-8">
          Python scripts, Windows fixes, SEO guides, and AI automation workflows. These are tested and documented by an IT Operations Lead, providing real code that actually runs without any fluff.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/blog" class="group inline-flex items-center gap-2 rounded-xl bg-brand-600 px-6 py-3 text-sm font-semibold text-white transition-all hover:bg-brand-700 hover:shadow-lg hover:shadow-brand-600/25 hover:-translate-y-0.5">
            Browse Articles
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </a>
          <a href="/guides" class="inline-flex items-center gap-2 rounded-xl border border-border px-6 py-3 text-sm font-semibold text-text transition-all hover:border-brand-600 hover:text-brand-600 hover:-translate-y-0.5 dark:border-border-dark dark:text-text-dark dark:hover:border-brand-400 dark:hover:text-brand-400">
            Step-by-Step Guides
          </a>
        </div>
      </div>

      <!-- Stats row -->
      <div class="mt-14 grid grid-cols-2 sm:grid-cols-4 gap-4">
        {[
          { num: `${allArticles.length}`, label: "Published guides" },
          { num: `${Object.keys(categoryCounts).length}`, label: "Topic categories" },
          { num: `${recentArticles.length}`, label: "Published in 30 days" },
          { num: "Clear", label: "Troubleshooting first" },
        ].map(stat => (
          <div class="rounded-2xl border border-border/60 dark:border-border-dark/60 bg-surface/60 dark:bg-surface-dark/60 backdrop-blur-sm p-4 text-center">
            <p class="text-2xl font-extrabold bg-gradient-to-br from-brand-600 to-brand-400 dark:from-brand-400 dark:to-brand-300 bg-clip-text text-transparent mb-0.5">{stat.num}</p>
            <p class="text-xs font-medium text-text-muted dark:text-text-dark-muted">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FEATURED ARTICLES ═══ -->
  <section class="border-t border-border/60 dark:border-border-dark/60 bg-surface-alt/30 dark:bg-surface-dark-alt/20">
    <div class="mx-auto max-w-6xl px-6 py-14">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-extrabold tracking-tight text-text dark:text-text-dark">Featured</h2>
        <a href="/blog" class="text-sm font-semibold text-brand-600 dark:text-brand-400 hover:underline">View all →</a>
      </div>

      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        
        <!-- Hero article (large, spans 2 cols on lg) -->
        {heroArticle && (
          <a href={`/blog/${heroArticle.id}`} class="group lg:col-span-2 lg:row-span-2 relative overflow-hidden rounded-2xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark flex flex-col transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:border-brand-600/50 dark:hover:border-brand-400/50">
            <div class="relative overflow-hidden aspect-video lg:aspect-auto lg:h-full lg:min-h-[420px]">
              {heroArticle.data.coverImage ? (
                <img
                  src={heroArticle.data.coverImage}
                  alt={heroArticle.data.imageAlt || heroArticle.data.title}
                  width="800" height="400"
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="eager"
                  fetchpriority="high"
                />
              ) : (
                <div class="w-full h-full bg-gradient-to-br from-brand-600/10 via-brand-500/5 to-transparent flex items-center justify-center">
                  <svg class="w-16 h-16 text-brand-600/20 dark:text-brand-400/15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" /></svg>
                </div>
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
              <div class="absolute bottom-0 left-0 right-0 p-6 lg:p-8 pb-14 lg:pb-16">
                <span class="inline-block px-3 py-1 bg-brand-600 text-white rounded-full text-xs font-bold uppercase tracking-wider mb-3">
                  {heroArticle.data.category.replace(/-/g, " ")}
                </span>
                <h3 class="text-xl lg:text-2xl xl:text-3xl font-extrabold text-white mb-2 leading-tight">
                  {heroArticle.data.seoTitle || heroArticle.data.title}
                </h3>
                <p class="text-sm text-white/80 line-clamp-2 max-w-lg mb-3">
                  {heroArticle.data.description}
                </p>
                <div class="flex items-center gap-3 text-xs text-white/60">
                  <time>{formatDate(heroArticle.data.publishDate)}</time>
                  <span class="w-1 h-1 rounded-full bg-white/40"></span>
                  <span>{heroArticle.data.readingTime || calculateReadingTime(heroArticle.body || heroArticle.data.description)} min read</span>
                </div>
              </div>
            </div>
          </a>
        )}

        <!-- Secondary articles (stacked on the right) -->
        {secondaryArticles.map((article) => (
          <a href={`/blog/${article.id}`} class="group relative overflow-hidden rounded-2xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark flex flex-col transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-brand-600/50 dark:hover:border-brand-400/50">
            <div class="relative overflow-hidden h-40">
              {article.data.coverImage ? (
                <img
                  src={article.data.coverImage}
                  alt={article.data.imageAlt || article.data.title}
                  width="800" height="400"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="eager"
                  fetchpriority="high"
                />
              ) : (
                <div class="w-full h-full bg-gradient-to-br from-brand-600/10 via-brand-500/5 to-transparent flex items-center justify-center">
                  <svg class="w-10 h-10 text-brand-600/20 dark:text-brand-400/15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" /></svg>
                </div>
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
              <span class="absolute top-3 left-3 px-2.5 py-0.5 bg-black/40 backdrop-blur-sm text-white rounded-full text-[10px] font-bold uppercase tracking-wider">
                {article.data.category.replace(/-/g, " ")}
              </span>
            </div>
            <div class="p-5 flex flex-col flex-grow">
                <h3 class="text-base font-bold text-text dark:text-text-dark group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors mb-2">
                {article.data.seoTitle || article.data.title}
              </h3>
              <p class="text-xs text-text-muted dark:text-text-dark-muted line-clamp-2 mb-3">
                {article.data.description}
              </p>
              <div class="mt-auto flex items-center gap-2 text-xs text-text-muted dark:text-text-dark-muted">
                <time>{formatDate(article.data.publishDate)}</time>
                <span class="w-1 h-1 rounded-full bg-border dark:bg-border-dark"></span>
                <span>{article.data.readingTime || calculateReadingTime(article.body || article.data.description)} min read</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ CORNERSTONE ENGINEERING HUBS (PILLAR PROTECTION) ═══ -->
  <section class="border-t border-border/60 dark:border-border-dark/60 bg-surface dark:bg-surface-dark py-14">
    <div class="mx-auto max-w-6xl px-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-2">
        <div>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-500/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-brand-600 dark:text-brand-400 mb-2">
            Flagship Hubs
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-text dark:text-text-dark">
            Cornerstone Engineering Guides
          </h2>
        </div>
        <p class="text-xs sm:text-sm text-text-muted dark:text-text-dark-muted max-w-md">
          Deep-dive workbench audits, protocol benchmarks, and verifiable deployment runbooks.
        </p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {[
          {
            title: "DeGoogle Starter Pack: 2026 Telemetry Audit",
            description: "We audited 3,400+ packets and tested open-source replacements for Search, Mail, Drive, and Android.",
            href: "/blog/degoogle-starter-pack-complete-guide",
            badge: "Privacy & Sovereignty",
            icon: "🔒",
            color: "border-red-500/30 hover:border-red-500/60"
          },
          {
            title: "Windows 11 25H2 Upgrade & CBS Servicing Fix",
            description: "Empirical benchmarks across 10 test rigs, memory overhead tests, and automated CBS repair runbooks.",
            href: "/blog/windows-11-25h2-upgrade-features-kb5124008-fix",
            badge: "Windows Diagnostics",
            icon: "🪟",
            color: "border-orange-500/30 hover:border-orange-500/60"
          },
          {
            title: "Ollama vs vLLM vs LM Studio: Local LLM Benchmark",
            description: "Tokens-per-second, VRAM overhead, and latency benchmarks across RTX 4090 and WSL2 setups.",
            href: "/blog/ollama-vs-vllm-vs-lm-studio-windows-11-wsl2-benchmark",
            badge: "AI Infrastructure",
            icon: "🤖",
            color: "border-purple-500/30 hover:border-purple-500/60"
          },
          {
            title: "GA4 Realtime vs Standard Reports Diagnostics",
            description: "Step-by-step triage for event delays, Consent Mode v2 payload drops, and BigQuery streaming exports.",
            href: "/blog/ga4-shows-realtime-users-but-reports-blank-fix-processing",
            badge: "Web Analytics",
            icon: "📊",
            color: "border-blue-500/30 hover:border-blue-500/60"
          }
        ].map(hub => (
          <a
            href={hub.href}
            class={`group flex flex-col justify-between rounded-2xl border ${hub.color} bg-surface-alt/40 dark:bg-surface-dark-alt/40 p-5 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg`}
          >
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-2xl">{hub.icon}</span>
                <span class="text-[10px] font-bold uppercase tracking-wider text-text-muted dark:text-text-dark-muted bg-surface dark:bg-surface-dark px-2 py-0.5 rounded-full border border-border/50 dark:border-border-dark/50">
                  {hub.badge}
                </span>
              </div>
              <h3 class="text-sm font-bold text-text dark:text-text-dark group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors mb-2 leading-snug">
                {hub.title}
              </h3>
              <p class="text-xs text-text-muted dark:text-text-dark-muted leading-relaxed line-clamp-3">
                {hub.description}
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-border/40 dark:border-border-dark/40 flex items-center justify-between text-xs font-semibold text-brand-600 dark:text-brand-400">
              <span>Read Pillar Guide</span>
              <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ CATEGORY CARDS ═══ -->
  <section class="mx-auto max-w-6xl px-6 py-14">
    <h2 class="text-2xl font-extrabold tracking-tight text-text dark:text-text-dark text-center mb-3">Explore by Topic</h2>
    <p class="text-sm text-text-muted dark:text-text-dark-muted text-center mb-10 max-w-lg mx-auto">Pick a category to dive deep into guides, tutorials, and real-world experiments.</p>
    <div class="grid gap-4 grid-cols-2 sm:grid-cols-3 lg:grid-cols-4">
      {categories
        .sort((a, b) => a.data.order - b.data.order)
        .map((cat) => {
          const meta = categoryMeta[cat.id] || { icon: "📄", color: "text-brand-600 dark:text-brand-400", gradient: "from-brand-600/15 to-brand-400/10" };
          const count = categoryCounts[cat.id] || 0;
          return (
            <a
              href={`/guides/${cat.id}`}
              class={`group relative overflow-hidden rounded-2xl border border-border dark:border-border-dark p-5 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:border-brand-600/40 dark:hover:border-brand-400/40 bg-gradient-to-br ${meta.gradient} dark:from-transparent dark:to-transparent dark:bg-surface-dark`}
            >
              <span class="text-3xl mb-3 block">{meta.icon}</span>
              <h3 class="text-sm font-bold text-text dark:text-text-dark mb-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">{cat.data.name}</h3>
              <p class="text-xs text-text-muted dark:text-text-dark-muted">{count} {count === 1 ? "article" : "articles"}</p>
              <svg class="absolute top-4 right-4 w-4 h-4 text-text-muted/30 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-all group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
            </a>
          );
        })}
    </div>
  </section>

  <!-- ═══ INTERACTIVE ENGINEERING TOOLS & CALCULATORS ═══ -->
  <section class="border-t border-border/60 dark:border-border-dark/60 bg-gradient-to-b from-surface-alt/40 via-surface/60 to-surface-alt/30 dark:from-surface-dark-alt/30 dark:via-surface-dark/40 dark:to-surface-dark-alt/20 py-16">
    <div class="mx-auto max-w-6xl px-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-3">
        <div>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 mb-2">
            Free Developer Utilities
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-text dark:text-text-dark">
            Interactive Tools & Diagnostics
          </h2>
        </div>
        <a href="/tools" class="inline-flex items-center gap-1.5 text-sm font-bold text-brand-600 dark:text-brand-400 hover:underline">
          Browse all tools →
        </a>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {[
          {
            name: "LLM VRAM Calculator",
            description: "Calculate exact GPU VRAM headroom, context size limits, and KV cache consumption for quantized models.",
            href: "/tools/vram-calculator",
            icon: "🧠",
            tag: "Local AI & GPU",
            badgeColor: "text-violet-600 dark:text-violet-400 bg-violet-500/10"
          },
          {
            name: "Windows Error Fixer",
            description: "Instant stop-code triage for 0x800f081f, WHEA 0x124, KMODE crashes, and stuck CBS update loops.",
            href: "/tools/windows-error-fixer",
            icon: "🛠️",
            tag: "BSOD & Update Repair",
            badgeColor: "text-orange-600 dark:text-orange-400 bg-orange-500/10"
          },
          {
            name: "WSL2 .wslconfig Generator",
            description: "Generate tuned memory limits, swap caps, and automatic VHD shrinking configurations to stop vmmem memory leaks.",
            href: "/tools/wsl-config-generator",
            icon: "⚡",
            tag: "DevOps & Linux",
            badgeColor: "text-amber-600 dark:text-amber-400 bg-amber-500/10"
          },
          {
            name: "Password Manager TCO",
            description: "Compare 5-year enterprise licensing, per-user rates, and hidden SSO fees across Bitwarden, 1Password, and Keeper.",
            href: "/tools/password-manager-pricing-calculator",
            icon: "🔐",
            tag: "Security TCO",
            badgeColor: "text-emerald-600 dark:text-emerald-400 bg-emerald-500/10"
          }
        ].map(tool => (
          <a
            href={tool.href}
            class="group flex flex-col justify-between rounded-2xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-brand-600/50 dark:hover:border-brand-400/50"
          >
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-3xl">{tool.icon}</span>
                <span class={`text-[11px] font-bold px-2.5 py-0.5 rounded-full ${tool.badgeColor}`}>
                  {tool.tag}
                </span>
              </div>
              <h3 class="text-base font-bold text-text dark:text-text-dark group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors mb-2">
                {tool.name}
              </h3>
              <p class="text-xs text-text-muted dark:text-text-dark-muted leading-relaxed">
                {tool.description}
              </p>
            </div>
            <div class="mt-5 pt-3 border-t border-border/40 dark:border-border-dark/40 flex items-center justify-between text-xs font-bold text-brand-600 dark:text-brand-400">
              <span>Launch Calculator</span>
