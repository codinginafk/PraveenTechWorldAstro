---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection, getEntry } from "astro:content";
import { getPublishedArticles } from "@lib/content/posts";
import ArticleCard from "@components/content/ArticleCard.astro";
import SchemaOrg from "@components/seo/SchemaOrg.astro";

export async function getStaticPaths() {
  const authors = await getCollection("authors");
  return authors.map((author) => ({
    params: { slug: author.id },
    props: { authorSlug: author.id },
  }));
}

const { authorSlug } = Astro.props;
const author = await getEntry("authors", authorSlug);
const allArticles = await getPublishedArticles();
const authorArticles = allArticles.filter(
  (a) => a.data.author === authorSlug
);
const isThinAuthor = authorArticles.length < 2;
const authorBio = author?.data.bio || `Articles by ${author?.data.name}.`;
const authorDescription = authorBio.length > 150 ? `${authorBio.slice(0, 147)}...` : authorBio;
const authorPageTitle = `${author?.data.name || "Author"} — Tech Guides`.slice(0, 58);
const SITE_URL = "https://www.praveentechworld.com";
---

<BaseLayout
  noindex={isThinAuthor}
  seo={{
    title: authorPageTitle,
    description: authorDescription,
    noindex: isThinAuthor,
  }}
>
  <SchemaOrg
    type="person"
    personData={{
      name: author?.data.name || "",
      description: author?.data.bio || "",
      url: `${SITE_URL}/author/${authorSlug}`,
      sameAs: [author?.data.twitter, author?.data.linkedin].filter(
        (value): value is string => Boolean(value)
      ),
    }}
  />
  <div class="mx-auto max-w-6xl px-4 py-16">
    <div class="mb-12 rounded-2xl border border-border bg-card p-6 sm:p-8 dark:border-border-dark dark:bg-card-dark">
      <nav class="mb-6 text-sm text-text-muted dark:text-text-dark-muted">
        <a href="/" class="hover:text-brand-700 dark:hover:text-brand-300">Home</a>
        <span class="mx-2">/</span>
        <span>Authors</span>
        <span class="mx-2">/</span>
        <span class="text-text dark:text-text-dark font-medium">{author?.data.name}</span>
      </nav>

      <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
        <div class="flex h-20 w-20 shrink-0 items-center justify-center rounded-2xl bg-brand-100 text-3xl font-bold text-brand-700 shadow-inner dark:bg-brand-900/40 dark:text-brand-300">
          {author?.data.name?.charAt(0)}
        </div>
        <div class="flex-1">
          <div class="flex flex-wrap items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight text-text dark:text-text-dark">{author?.data.name}</h1>
            <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 border border-emerald-200 dark:bg-emerald-950/40 dark:border-emerald-800 dark:text-emerald-300">
              <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Verified Systems Engineer
            </span>
          </div>
          <p class="mt-3 text-base leading-relaxed text-text-muted dark:text-text-dark-muted">{author?.data.bio}</p>

          <!-- E-E-A-T Credential Highlights -->
          <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-3">
            <div class="rounded-xl border border-border/80 bg-background/50 p-3 text-xs dark:border-border-dark/80 dark:bg-background-dark/50">
              <span class="font-semibold text-text dark:text-text-dark block">Hardware Test Lab</span>
              <span class="text-text-muted dark:text-text-dark-muted">Physical Intel, AMD, and isolated GrapheneOS testbeds</span>
            </div>
            <div class="rounded-xl border border-border/80 bg-background/50 p-3 text-xs dark:border-border-dark/80 dark:bg-background-dark/50">
              <span class="font-semibold text-text dark:text-text-dark block">Kernel & BSOD Triage</span>
              <span class="text-text-muted dark:text-text-dark-muted">WinDbg minidump analysis & ACPI/driver diagnostics</span>
            </div>
            <div class="rounded-xl border border-border/80 bg-background/50 p-3 text-xs dark:border-border-dark/80 dark:bg-background-dark/50">
              <span class="font-semibold text-text dark:text-text-dark block">Sovereign Privacy</span>
              <span class="text-text-muted dark:text-text-dark-muted">Self-hosted Docker stacks & Zero-Knowledge tools</span>
            </div>
          </div>

          <div class="mt-5 flex items-center gap-4">
            {author?.data.twitter && (
              <a href={author.data.twitter} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm font-medium text-text-muted hover:text-brand-700 dark:text-text-dark-muted dark:hover:text-brand-300">
                <span>X (Twitter)</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            )}
            {author?.data.linkedin && (
              <a href={author.data.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm font-medium text-text-muted hover:text-brand-700 dark:text-text-dark-muted dark:hover:text-brand-300">
                <span>LinkedIn</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            )}
          </div>
        </div>
      </div>
    </div>

    <!-- Featured Workbench Benchmarks -->
    <div class="mb-12">
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-xl font-bold tracking-tight text-text dark:text-text-dark">Featured Laboratory Benchmarks</h2>
        <span class="text-xs text-text-muted dark:text-text-dark-muted">Empirical Workbench Testing</span>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <a href="/blog/degoogle-starter-pack-complete-guide" class="group block rounded-xl border border-border bg-card p-4 transition-all hover:border-brand-500/50 hover:shadow-md dark:border-border-dark dark:bg-card-dark">
          <span class="text-xs font-semibold text-brand-600 dark:text-brand-400">Pillar Benchmark</span>
          <h3 class="mt-1 font-semibold text-text group-hover:text-brand-600 dark:text-text-dark dark:group-hover:text-brand-400">DeGoogle Starter Pack: 2026 Sovereign Stack</h3>
          <p class="mt-1 text-xs text-text-muted dark:text-text-dark-muted">3,400+ background phone connections measured across 72 hours of network packet logging.</p>
        </a>
        <a href="/blog/google-photos-alternatives-immich-ente-photos-migration-guide" class="group block rounded-xl border border-border bg-card p-4 transition-all hover:border-brand-500/50 hover:shadow-md dark:border-border-dark dark:bg-card-dark">
          <span class="text-xs font-semibold text-brand-600 dark:text-brand-400">Migration Lab</span>
          <h3 class="mt-1 font-semibold text-text group-hover:text-brand-600 dark:text-text-dark dark:group-hover:text-brand-400">Immich vs. Google Photos: 82k Photo Test</h3>
          <p class="mt-1 text-xs text-text-muted dark:text-text-dark-muted">Full Takeout metadata salvage, immich-go CLI triage, and local facial recognition benchmarks.</p>
        </a>
        <a href="/blog/windows-11-24h2-telemetry-network-fixes" class="group block rounded-xl border border-border bg-card p-4 transition-all hover:border-brand-500/50 hover:shadow-md dark:border-border-dark dark:bg-card-dark">
          <span class="text-xs font-semibold text-brand-600 dark:text-brand-400">Telemetry Audit</span>
          <h3 class="mt-1 font-semibold text-text group-hover:text-brand-600 dark:text-text-dark dark:group-hover:text-brand-400">Windows 11 24H2 Telemetry: 7 Network Fixes</h3>
          <p class="mt-1 text-xs text-text-muted dark:text-text-dark-muted">168-hour router audit verifying silent telemetry endpoints and firewall drop rules.</p>
        </a>
      </div>
    </div>

    <!-- Article Index -->
    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-2xl font-bold tracking-tight text-text dark:text-text-dark">Published Runbooks ({authorArticles.length})</h2>
      <span class="text-sm text-text-muted dark:text-text-dark-muted">Step-by-step verified tutorials</span>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {authorArticles.map((article) => (
        <ArticleCard article={article} />
      ))}
    </div>

    {authorArticles.length === 0 && (
      <p class="py-12 text-center text-text-muted dark:text-text-dark-muted">
        No articles published yet.
      </p>
    )}
  </div>
</BaseLayout>
