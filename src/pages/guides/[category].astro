---
import BaseLayout from "@layouts/BaseLayout.astro";
import SchemaOrg from "@components/seo/SchemaOrg.astro";
import { getCollection } from "astro:content";
import { getPublishedArticles } from "@lib/content/posts";

export async function getStaticPaths() {
  const categories = await getCollection("categories");
  return categories.map((cat) => ({
    params: { category: cat.id },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const allArticles = await getPublishedArticles();
const catArticles = allArticles.filter((a) => a.data.category === category.id);
const catName = category.data.name;
const catDescription = category.data.description;
const catIntro = category.data.intro || "";
const catIcon = category.data.icon || "📘";

const priorityArticleIds: Record<string, string[]> = {
  "windows-fixes": [
    "does-resetting-windows-remove-viruses-completely",
    "windows-11-volume-control-not-working-8-proven-fixes-for-2026",
    "how-to-fix-windows-11-kb5121003-inpoutx64-crash",
    "how-to-fix-nvlddmkm-sys-event-id-13-gpu-driver-crashes-windows-11",
    "how-to-fix-kmode-exception-not-handled-0x1e-blue-screen",
    "how-to-fix-windows-11-update-error-0x8024200d",
  ],
  "hardware-troubleshooting": [
    "how-to-fix-nvlddmkm-event-id-153-gpu-crashes",
    "how-to-fix-clock-watchdog-timeout-0x101-blue-screen-error-windows-11",
    "pc-keeps-crashing-how-to-tell-if-it-s-a-ram-issue-or-a-bad-driver",
  ],
  "ai": [
    "google-gemini-spark-mode-features-guide",
    "gemini-spark-remote-browser-vs-local-chrome-fix",
    "how-to-run-deepseek-r1-locally-on-8gb-vram",
  ],
  "website-setup": [
    "how-to-fix-sitemap-errors-in-google-search-console",
    "how-to-add-your-website-to-google-search-step-by-step-guide",
  ],
  "it-operations": [
    "deepseek-powershell-log-triage-windows-server",
    "windows-11-24h2-debloat-gpo-telemetry-guide",
  ],
};
const priorityArticles = (priorityArticleIds[category.id] || [])
  .map((id) => catArticles.find((article) => article.id === id))
  .filter((article): article is (typeof catArticles)[number] => Boolean(article));

const cats = await getCollection("categories");
const otherCats = cats.filter((c) => c.id !== category.id).sort((a, b) => a.data.order - b.data.order);
const isThinHub = catArticles.length === 0;

const categoryFaqItems = [
  {
    question: `What topics are covered in the ${catName} series?`,
    answer: `We share step-by-step guides for fixing bugs, running tools, and setting up systems. Every article solves a specific problem with clear steps.`,
  },
  {
    question: `How often are these ${catName} guides updated?`,
    answer: `We update these articles whenever Microsoft, Google, or software makers ship new patches. We re-test our steps on physical machines to make sure they still work.`,
  },
  {
    question: `Can I run these ${catName} commands safely on my system?`,
    answer: `Yes. We test every script on real hardware before sharing it. We focus on safe, non-destructive fixes and always include rollback steps.`,
  },
];
---

<BaseLayout
  noindex={isThinHub}
  seo={{
    title: `${catName} Guides and Tutorials`,
    description: `Browse ${catName.toLowerCase()} guides. ${catDescription}`.slice(0, 150),
    noindex: isThinHub,
  }}
>
  <SchemaOrg type="faq" faqItems={categoryFaqItems} />
  <div class="mx-auto max-w-6xl px-4 py-16">
    <nav class="mb-4 text-sm text-text-muted dark:text-text-dark-muted">
      <a href="/" class="hover:text-brand-600 dark:hover:text-brand-400">Home</a>
      <span class="mx-2">/</span>
      <a href="/guides" class="hover:text-brand-600 dark:hover:text-brand-400">Guides</a>
      <span class="mx-2">/</span>
      <span>{catName}</span>
    </nav>

    <div class="mb-12">
      <span class="mb-2 block text-4xl">{catIcon}</span>
      <h1 class="mb-4 text-3xl font-bold">{catName} Guide Series</h1>
      <p class="max-w-3xl text-lg text-text-muted dark:text-text-dark-muted">
        {catDescription}
      </p>
      {catIntro && (
        <p class="mt-4 max-w-3xl text-base text-text-muted dark:text-text-dark-muted">
          {catIntro}
        </p>
      )}

      <div class="mt-8 rounded-xl border border-border bg-surface-alt/50 p-6 dark:border-border-dark dark:bg-surface-dark-alt/50 max-w-3xl">
        <h2 class="mb-3 text-lg font-bold text-text dark:text-text-dark">About the {catName} Knowledge Base</h2>
        <p class="text-sm leading-relaxed text-text-muted dark:text-text-dark-muted">
          Welcome to our {catName} guide collection. Our team tests real solutions on physical hardware. We share clear steps, proven scripts, and practical fixes. You get exact terminal commands without fluff or guesswork.
        </p>
        <p class="mt-3 text-sm leading-relaxed text-text-muted dark:text-text-dark-muted">
          Each guide helps you fix a specific issue or speed up your daily workflow. Browse the tutorials below to find working fixes, benchmark data, and verified code.
        </p>
      </div>

      {priorityArticles.length > 0 && (
        <section class="mt-8 max-w-5xl" aria-labelledby="start-here-heading">
          <h2 id="start-here-heading" class="mb-2 text-xl font-bold text-text dark:text-text-dark">Common {catName} Problems & Recommended Fixes</h2>
          <p class="mb-5 max-w-3xl text-sm text-text-muted dark:text-text-dark-muted">
            These guides tackle the issues readers run into most often. Check your symptoms against the titles below to find the right fix quickly.
          </p>
          <div class="grid gap-4 md:grid-cols-3">
            {priorityArticles.map((article) => (
              <a
                href={`/blog/${article.id}`}
                class="group rounded-xl border border-border bg-surface p-5 transition-all hover:-translate-y-0.5 hover:border-brand-600 hover:shadow-md dark:border-border-dark dark:bg-surface-dark dark:hover:border-brand-400"
              >
                <h3 class="font-semibold leading-snug group-hover:text-brand-600 dark:group-hover:text-brand-400">
                  {article.data.seoTitle || article.data.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-text-muted dark:text-text-dark-muted">
                  {article.data.description}
                </p>
                <span class="mt-4 inline-block text-sm font-medium text-brand-600 group-hover:underline dark:text-brand-400">Read the fix →</span>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>

    {catArticles.length === 0 && (
      <p class="py-12 text-center text-text-muted dark:text-text-dark-muted">
        No guides in this series yet. Check back soon.
      </p>
    )}

    <div class="mb-6">
      <h2 class="text-2xl font-bold text-text dark:text-text-dark">All {catName} Guides & Technical Runbooks</h2>
    </div>

    <div class="space-y-6">
      {catArticles.sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()).map((article, i) => (
        <a
          href={`/blog/${article.id}`}
          class="group block rounded-xl border border-border bg-surface p-6 transition-all hover:-translate-y-0.5 hover:border-brand-600 hover:shadow-md dark:border-border-dark dark:bg-surface-dark dark:hover:border-brand-400"
        >
          <div class="flex items-start gap-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-sm font-bold text-brand-700 dark:bg-brand-900/30 dark:text-brand-300">
              {i + 1}
            </span>
            <div class="min-w-0 flex-1">
              <h3 class="text-lg font-semibold group-hover:text-brand-600 dark:group-hover:text-brand-400">
                {article.data.seoTitle || article.data.title}
              </h3>
              <p class="mt-1 text-sm text-text-muted dark:text-text-dark-muted">
                {article.data.description}
              </p>
              <div class="mt-2 flex flex-wrap items-center gap-3 text-xs text-text-muted dark:text-text-dark-muted">
                <span>{new Date(article.data.publishDate).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</span>
                {article.data.readingTime && <span>{article.data.readingTime} min read</span>}
                {article.data.tags.length > 0 && (
                  <span class="flex flex-wrap gap-1">
                    {article.data.tags.slice(0, 3).map((tag) => (
                      <span class="rounded-full bg-surface-alt px-2 py-0.5 text-xs dark:bg-surface-dark-alt">{tag}</span>
                    ))}
                  </span>
                )}
              </div>
            </div>
            <svg class="mt-1 h-5 w-5 shrink-0 text-text-muted transition-transform group-hover:translate-x-1 group-hover:text-brand-600 dark:group-hover:text-brand-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
            </svg>
          </div>
        </a>
      ))}
    </div>

    <section class="mt-16 rounded-2xl border border-border bg-surface-alt/40 p-8 dark:border-border-dark dark:bg-surface-dark-alt/30">
      <h2 class="mb-6 text-2xl font-bold text-text dark:text-text-dark">Frequently Asked Questions: {catName}</h2>
      <div class="space-y-4">
        {categoryFaqItems.map((item, index) => (
          <details open={index === 0} class="group border border-border dark:border-border-dark rounded-xl bg-surface dark:bg-surface-dark p-5 transition-colors duration-200">
            <summary class="list-none flex items-center justify-between font-bold text-base text-text dark:text-text-dark cursor-pointer select-none">
              <span>{item.question}</span>
              <span class="text-brand-600 dark:text-brand-400 group-open:rotate-180 transition-transform duration-200 shrink-0 ml-4">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <div class="mt-3 pt-3 border-t border-border/50 dark:border-border-dark/50 text-text-muted dark:text-text-dark-muted text-sm leading-relaxed">
              {item.answer}
            </div>
          </details>
        ))}
      </div>
    </section>

    {otherCats.length > 0 && (
      <div class="mt-16 border-t border-border pt-10 dark:border-border-dark">
        <h2 class="mb-6 text-xl font-bold">Explore Additional Technical Domains</h2>
        <div class="flex flex-wrap gap-3">
          {otherCats.map((c) => (
            <a
              href={`/guides/${c.id}`}
              class="rounded-full border border-border bg-surface px-5 py-2 text-sm font-medium transition-all hover:border-brand-600 hover:text-brand-600 dark:border-border-dark dark:bg-surface-dark dark:hover:border-brand-400 dark:hover:text-brand-400"
            >
              {c.data.icon && <span class="mr-1">{c.data.icon}</span>}
              {c.data.name}
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
