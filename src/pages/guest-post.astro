---
import BaseLayout from "@layouts/BaseLayout.astro";
import Icon from "@components/common/Icon.astro";
---

<BaseLayout
  seo={{
    title: "Write for Us: Guest Guidelines & Pitch Intake",
    description: "Submit a guest pitch to PraveenTechWorld. We accept firsthand guides on IT operations, Windows troubleshooting, AI scripts, and technical SEO.",
  }}
>
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:py-16">
    
    <!-- Hero / Title -->
    <div class="mb-12">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-100 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-brand-700 dark:bg-brand-900/40 dark:text-brand-300 mb-4">
        Editorial Intake & Guidelines
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-text dark:text-text-dark mb-4">
        Write for PraveenTechWorld
      </h1>
      <p class="text-base sm:text-lg text-text-muted dark:text-text-dark-muted leading-relaxed max-w-3xl">
        We publish hands-on, real-world technical guides written by IT practitioners, sysadmins, and automation engineers. We do not publish generic AI-generated fluff or sponsored link-farming articles.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 mb-16">
      <div class="rounded-2xl border border-brand-200 bg-brand-50/50 p-6 dark:border-brand-800/40 dark:bg-brand-950/20">
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-700 text-white text-xs font-bold mb-3">1</span>
        <h2 class="text-lg font-bold text-text dark:text-text-dark mb-2">Submit a pitch</h2>
        <p class="text-sm text-text-muted dark:text-text-dark-muted leading-relaxed">Send the problem, your proposed approach, and a short outline. Do not write a full article before the idea is approved.</p>
      </div>
      <div class="rounded-2xl border border-brand-200 bg-brand-50/50 p-6 dark:border-brand-800/40 dark:bg-brand-950/20">
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-700 text-white text-xs font-bold mb-3">2</span>
        <h2 class="text-lg font-bold text-text dark:text-text-dark mb-2">Write and verify</h2>
        <p class="text-sm text-text-muted dark:text-text-dark-muted leading-relaxed">Approved drafts must include working commands, honest limitations, and evidence from a real test or reproducible setup.</p>
      </div>
    </div>

    <div class="rounded-3xl border border-border bg-surface p-6 dark:border-border-dark dark:bg-surface-dark mb-16 md:p-8">
      <h2 class="text-2xl font-extrabold text-text dark:text-text-dark mb-6">What we accept</h2>
      <div class="grid gap-8 md:grid-cols-2">
        <div>
          <h3 class="text-base font-bold text-brand-700 dark:text-brand-300 mb-3">Topics we welcome</h3>
          <ul class="space-y-2 text-sm text-text-muted dark:text-text-dark-muted">
            <li>IT operations, sysadmin work, Docker, PowerShell, and Bash.</li>
            <li>Windows troubleshooting, update errors, registry, and GPO fixes.</li>
            <li>Practical AI automation, Python scripts, and CLI utilities.</li>
            <li>Technical SEO, Cloudflare, performance, and web infrastructure.</li>
          </ul>
        </div>
        <div>
          <h3 class="text-base font-bold text-rose-600 dark:text-rose-400 mb-3">What we decline</h3>
          <ul class="space-y-2 text-sm text-text-muted dark:text-text-dark-muted">
            <li>Unverified AI rewrites or generic software listicles.</li>
            <li>Link-farming, gambling, crypto, or sponsored promotion.</li>
            <li>Commands that have not been tested or explained.</li>
            <li>Claims presented as firsthand evidence without a reproducible basis.</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="rounded-3xl border border-border bg-surface-alt/20 p-6 dark:border-border-dark dark:bg-surface-dark-alt/10 md:p-10">
      <h2 class="text-2xl font-extrabold text-text dark:text-text-dark mb-2">Submit your guest pitch</h2>
      <p class="text-sm text-text-muted dark:text-text-dark-muted mb-8">Pitches are reviewed by the editorial team. Please include enough detail for us to understand what is original and verifiable.</p>

      <form id="pitch-form" action="https://formspree.io/f/xbdejjpr" method="POST" class="space-y-6 max-w-2xl">
        <input type="text" name="website_hp" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />

        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="name" class="mb-2 block text-xs font-bold uppercase tracking-wider text-text dark:text-text-dark">Author name *</label>
            <input type="text" id="name" name="name" required maxlength="120" autocomplete="name" class="w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-text placeholder:text-text-muted focus:border-brand-600 focus:outline-none dark:border-border-dark dark:bg-surface-dark dark:text-text-dark" placeholder="Alex Rivera" />
          </div>
          <div>
            <label for="email" class="mb-2 block text-xs font-bold uppercase tracking-wider text-text dark:text-text-dark">Author email *</label>
            <input type="email" id="email" name="email" required maxlength="254" autocomplete="email" class="w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-text placeholder:text-text-muted focus:border-brand-600 focus:outline-none dark:border-border-dark dark:bg-surface-dark dark:text-text-dark" placeholder="alex@example.com" />
          </div>
        </div>

        <div>
          <label for="topic" class="mb-2 block text-xs font-bold uppercase tracking-wider text-text dark:text-text-dark">Proposed topic *</label>
          <input type="text" id="topic" name="topic" required maxlength="180" class="w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-text placeholder:text-text-muted focus:border-brand-600 focus:outline-none dark:border-border-dark dark:bg-surface-dark dark:text-text-dark" placeholder="How to Fix Docker Volume Permission Errors on Debian 12" />
        </div>

        <div>
          <label for="outline" class="mb-2 block text-xs font-bold uppercase tracking-wider text-text dark:text-text-dark">Outline and problem solved *</label>
          <textarea id="outline" name="outline" rows="5" required maxlength="5000" class="w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-text placeholder:text-text-muted focus:border-brand-600 focus:outline-none dark:border-border-dark dark:bg-surface-dark dark:text-text-dark" placeholder="1. The error scenario&#10;2. Diagnostics and evidence&#10;3. Verified fix and limitations"></textarea>
        </div>

        <div>
          <label for="doc_url" class="mb-2 block text-xs font-bold uppercase tracking-wider text-text dark:text-text-dark">Draft or supporting document *</label>
          <input type="url" id="doc_url" name="doc_url" required maxlength="1000" class="w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-text placeholder:text-text-muted focus:border-brand-600 focus:outline-none dark:border-border-dark dark:bg-surface-dark dark:text-text-dark" placeholder="https://docs.google.com/document/d/..." />
        </div>

        <div id="turnstile-wrapper" class="my-4 min-h-[65px] flex flex-col justify-start items-start gap-1">
          <div id="turnstile-container"></div>
          <p id="pitch-turnstile-msg" class="hidden text-xs text-amber-600 dark:text-amber-400 font-medium"></p>
        </div>

        <div id="pitch-status" class="hidden rounded-xl p-4 text-sm font-medium" role="status" aria-live="polite"></div>

        <button type="submit" id="pitch-submit-btn" class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent-700 px-8 py-3.5 text-sm font-bold text-white transition-all hover:bg-accent-800 hover:shadow-lg hover:shadow-accent-600/25 disabled:opacity-50">
          <Icon name="send" class="w-4 h-4" /> Submit pitch for review
        </button>
      </form>
    </div>
  </div>

  <!-- Cloudflare Turnstile Script (explicit rendering) -->
  <script is:inline>
    window.onTurnstileLoadedGuestPost = function() {
      if (typeof window.__initGuestPostTurnstile === 'function') {
        window.__initGuestPostTurnstile();
      }
    };
  </script>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onTurnstileLoadedGuestPost&render=explicit" async defer></script>

  <!-- Submission Handler with Turnstile Verification -->
  <script>
    const pitchForm = document.getElementById('pitch-form') as HTMLFormElement | null;
    const statusDiv = document.getElementById('pitch-status') as HTMLElement | null;
    const submitBtn = document.getElementById('pitch-submit-btn') as HTMLButtonElement | null;
    const turnstileMsg = document.getElementById('pitch-turnstile-msg') as HTMLElement | null;

    let turnstileWidgetId: string | null = null;
    let turnstileToken: string | null = null;

    function initGuestPostTurnstile() {
      const container = document.getElementById('turnstile-container');
      if (!container || !window.turnstile || turnstileWidgetId !== null || container.children.length > 0) return;

      try {
        turnstileWidgetId = window.turnstile.render(container, {
          sitekey: '0x4AAAAAAECkhL7KWrcngk0L',
          theme: 'auto',
          callback: (token: string) => {
            turnstileToken = token;
            if (turnstileMsg) {
              turnstileMsg.classList.add('hidden');
              turnstileMsg.innerText = '';
            }
            if (statusDiv && statusDiv.innerText.includes('security verification')) {
              statusDiv.classList.add('hidden');
              statusDiv.innerText = '';
            }
          },
          'expired-callback': () => {
            turnstileToken = null;
          },
          'error-callback': () => {
            turnstileToken = null;
            if (turnstileMsg) {
              turnstileMsg.classList.remove('hidden');
              turnstileMsg.innerText = 'Security verification failed to load. Please refresh the page.';
            }
          }
        });
      } catch (err) {
        console.warn('Turnstile render notice:', err);
      }
    }

    (window as any).__initGuestPostTurnstile = initGuestPostTurnstile;
    if (window.turnstile) {
      initGuestPostTurnstile();
    }

    if (pitchForm && statusDiv && submitBtn) {
      pitchForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Honeypot check
        const formData = new FormData(pitchForm);
        if (formData.get('website_hp')) {
          statusDiv.className = 'rounded-xl p-4 text-sm font-medium bg-brand-100 text-brand-800 dark:bg-brand-900/40 dark:text-brand-300';
          statusDiv.innerText = 'Thank you! Your pitch has been submitted successfully.';
          pitchForm.reset();
          turnstileToken = null;
          if (window.turnstile && turnstileWidgetId !== null) window.turnstile.reset(turnstileWidgetId);
          return;
        }

        // Validate Turnstile token before sending
        let token = turnstileToken;
        if (!token && window.turnstile && turnstileWidgetId !== null) {
          try {
            token = window.turnstile.getResponse(turnstileWidgetId);
          } catch (err) {}
        }
        if (!token) {
          const hiddenInput = pitchForm.querySelector('input[name="cf-turnstile-response"]') as HTMLInputElement | null;
          if (hiddenInput && hiddenInput.value) token = hiddenInput.value;
        }

        if (!token) {
          if (turnstileMsg) {
            turnstileMsg.classList.remove('hidden');
            turnstileMsg.innerText = 'Please check the verification box above before submitting your pitch.';
          }
          statusDiv.className = 'rounded-xl p-4 text-sm font-medium bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300';
          statusDiv.innerText = 'Please complete the Cloudflare security verification above.';
          return;
        }

        submitBtn.disabled = true;
        submitBtn.innerText = 'Submitting Pitch...';
        statusDiv.className = 'hidden';
        if (turnstileMsg) {
          turnstileMsg.classList.add('hidden');
          turnstileMsg.innerText = '';
        }

        formData.set('cf-turnstile-response', token);

        try {
          // Submit via Formspree API (Guaranteed Delivery)
          const response = await fetch(pitchForm.action, {
            method: 'POST',
            body: formData,
            headers: {
              'Accept': 'application/json'
            }
          });

          if (response.ok) {
            statusDiv.className = 'rounded-xl p-4 text-sm font-medium bg-brand-100 text-brand-800 dark:bg-brand-900/40 dark:text-brand-300';
            statusDiv.innerText = 'Pitch submitted successfully! Our editorial team will review your outline within 48 hours.';
            pitchForm.reset();
            turnstileToken = null;
            if (window.turnstile && turnstileWidgetId !== null) window.turnstile.reset(turnstileWidgetId);
          } else {
            const result = await response.json().catch(() => ({}));
            statusDiv.className = 'rounded-xl p-4 text-sm font-medium bg-rose-100 text-rose-800 dark:bg-rose-900/40 dark:text-rose-300';
            statusDiv.innerText = result.error || 'Submission error. Please email contact@praveentechworld.com directly.';
            turnstileToken = null;
            if (window.turnstile && turnstileWidgetId !== null) window.turnstile.reset(turnstileWidgetId);
          }
        } catch (err) {
          statusDiv.className = 'rounded-xl p-4 text-sm font-medium bg-rose-100 text-rose-800 dark:bg-rose-900/40 dark:text-rose-300';
          statusDiv.innerText = 'Network error submitting pitch. Please email contact@praveentechworld.com directly.';
          turnstileToken = null;
          if (window.turnstile && turnstileWidgetId !== null) window.turnstile.reset(turnstileWidgetId);
        } finally {
          submitBtn.disabled = false;
          submitBtn.innerText = 'Submit pitch for review';
        }
      });
    }
  </script>
</BaseLayout>
