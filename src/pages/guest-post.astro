---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  seo={{
    title: "Write for Us — Guest Author Guidelines & Pitch Intake | PraveenTechWorld",
    description: "Submit a guest article pitch to PraveenTechWorld. We accept real hands-on guides for IT Operations, Windows troubleshooting, AI automation scripts, and Technical SEO.",
  }}
>
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:py-16">
    
    <!-- Hero / Title -->
    <div class="mb-12">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-100 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-brand-700 dark:bg-brand-900/40 dark:text-brand-300 mb-[...]
        Editorial Intake & Guidelines
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-text dark:text-text-dark mb-4">
        Write for PraveenTechWorld
      </h1>
      <p class="text-base sm:text-lg text-text-muted dark:text-text-dark-muted leading-relaxed max-w-3xl">
        We publish hands-on, real-world technical guides written by IT practitioners, sysadmins, and automation engineers. We do not publish generic AI-generated fluff or sponsored link-farming ar[...]
      </p>
    </div>

[truncated for brevity]

  <!-- Cloudflare Turnstile Script (load at runtime) -->
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <!-- Submission Handler with Turnstile Verification -->
  <script>
    const pitchForm = document.getElementById('pitch-form');
    const statusDiv = document.getElementById('pitch-status');
    const submitBtn = document.getElementById('pitch-submit-btn');

    // Safe Turnstile Render Fallback + explicit widget id
    let turnstileWidgetId = null;

    function initTurnstileWidget() {
      const container = document.getElementById('turnstile-container');
      if (!container) return;

      // If iframe already rendered by Cloudflare auto-script, do nothing
      if (container.querySelector('iframe')) return;

      if (window.turnstile && typeof window.turnstile.render === 'function') {
        try {
          // capture returned widget id so we can get/reset tokens explicitly
          turnstileWidgetId = window.turnstile.render('#turnstile-container', {
            sitekey: '0x4AAAAAAECdrXzclXfWcMEd',
            action: 'turnstile-spin-v2',
            theme: 'auto'
          });
        } catch (err) {
          console.warn('Turnstile render notice:', err);
        }
      }
    }

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      setTimeout(initTurnstileWidget, 200);
      setTimeout(initTurnstileWidget, 1000);
    } else {
      window.addEventListener('load', () => {
        setTimeout(initTurnstileWidget, 200);
        setTimeout(initTurnstileWidget, 1000);
      });
    }


    if (pitchForm) {
      pitchForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        // Honeypot check
        const formData = new FormData(pitchForm);
        if (formData.get('website_hp')) {
          // Bot detected - simulate silent success
          statusDiv.className = 'rounded-xl p-4 text-sm font-medium bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300';
          statusDiv.innerText = '✅ Thank you! Your pitch has been submitted successfully.';
          pitchForm.reset();
          if (window.turnstile && turnstileWidgetId !== null) window.turnstile.reset(turnstileWidgetId);
          return;
        }

        // Ensure Turnstile token is attached explicitly
        try {
          if (window.turnstile && turnstileWidgetId !== null) {
            const token = window.turnstile.getResponse(turnstileWidgetId);
            if (token) formData.set('cf-turnstile-response', token);
          }
        } catch (err) {
          console.warn('Turnstile token retrieval failed', err);
        }

        submitBtn.disabled = true;
        submitBtn.innerText = 'Submitting Pitch...';
        statusDiv.className = 'hidden';

        try {
          // Submit via Formspree API (Guaranteed Delivery)
          const response = await fetch(pitchForm.action, {
            method: 'POST',
            body: formData,
            headers: {
              'Accept': 'application/json'
            }
          });

          if (response.ok) {
            statusDiv.className = 'rounded-xl p-4 text-sm font-medium bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300';
            statusDiv.innerText = '✅ Pitch submitted successfully! Our editorial team will review your outline within 48 hours.';
            pitchForm.reset();
            if (window.turnstile && turnstileWidgetId !== null) window.turnstile.reset(turnstileWidgetId);
          } else {
            const result = await response.json();
            statusDiv.className = 'rounded-xl p-4 text-sm font-medium bg-rose-100 text-rose-800 dark:bg-rose-900/40 dark:text-rose-300';
            statusDiv.innerText = result.error || '❌ Submission error. Please email contact@praveentechworld.com directly.';
            if (window.turnstile && turnstileWidgetId !== null) window.turnstile.reset(turnstileWidgetId);
          }
        } catch (err) {
          statusDiv.className = 'rounded-xl p-4 text-sm font-medium bg-rose-100 text-rose-800 dark:bg-rose-900/40 dark:text-rose-300';
          statusDiv.innerText = '❌ Network error submitting pitch. Please email contact@praveentechworld.com directly.';
          if (window.turnstile && turnstileWidgetId !== null) window.turnstile.reset(turnstileWidgetId);
        } finally {
          submitBtn.disabled = false;
          submitBtn.innerText = 'Submit Pitch for Review 🚀';
        }
      });
    }
  </script>
</BaseLayout>
