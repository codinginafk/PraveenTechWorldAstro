---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  seo={{
    title: "Write for Us — Guest Author Guidelines & Pitch Intake | PraveenTechWorld",
    description: "Submit a guest article pitch to PraveenTechWorld. We accept real hands-on guides for IT Operations, Windows troubleshooting, AI automation scripts, and Technical SEO.",
  }}
>
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:py-16">
    
    <!-- Hero / Title -->
    <div class="mb-12">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-100 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-brand-700 dark:bg-brand-900/40 dark:text-brand-300 mb-4">
        Editorial Intake & Guidelines
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-text dark:text-text-dark mb-4">
        Write for PraveenTechWorld
      </h1>
      <p class="text-base sm:text-lg text-text-muted dark:text-text-dark-muted leading-relaxed max-w-3xl">
        We publish hands-on, real-world technical guides written by IT practitioners, sysadmins, and automation engineers. We do not publish generic AI-generated fluff or sponsored link-farming articles.
      </p>
    </div>

    <!-- Two-Stage Process Cards -->
    <div class="grid gap-6 md:grid-cols-2 mb-16">
      <div class="rounded-2xl border border-brand-200 bg-brand-50/50 p-6 dark:border-brand-800/40 dark:bg-brand-950/20">
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-600 text-white text-xs font-bold mb-3">1</span>
        <h3 class="text-lg font-bold text-text dark:text-text-dark mb-2">Stage 1: Submit Your Pitch</h3>
        <p class="text-sm text-text-muted dark:text-text-dark-muted leading-relaxed">
          Do not write a full draft upfront. Send your proposed topic, a 3-bullet outline, and a link to a Google Doc or outline draft. Our editorial team reviews pitches within 48 hours.
        </p>
      </div>

      <div class="rounded-2xl border border-emerald-200 bg-emerald-50/50 p-6 dark:border-emerald-800/40 dark:bg-emerald-950/20">
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-600 text-white text-xs font-bold mb-3">2</span>
        <h3 class="text-lg font-bold text-text dark:text-text-dark mb-2">Stage 2: Write & Review Draft</h3>
        <p class="text-sm text-text-muted dark:text-text-dark-muted leading-relaxed">
          Once approved, complete your draft in a Google Doc with "Anyone with link can comment" access. Approved posts are staged, verified, and scheduled for production release.
        </p>
      </div>
    </div>

    <!-- Editorial Guidelines -->
    <div class="rounded-3xl border border-border bg-surface p-6 dark:border-border-dark dark:bg-surface-dark mb-16 md:p-8">
      <h2 class="text-2xl font-extrabold text-text dark:text-text-dark mb-6">What We Accept & Editorial Standards</h2>
      
      <div class="grid gap-8 md:grid-cols-2 mb-8">
        <div>
          <h3 class="text-base font-bold text-emerald-600 dark:text-emerald-400 mb-3 flex items-center gap-2">
            <span>✅</span> Topics We Welcome
          </h3>
          <ul class="space-y-2 text-sm text-text-muted dark:text-text-dark-muted">
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">•</span>
              <span><strong>IT Operations & Sysadmin:</strong> Server health checks, Nginx/Apache configs, Docker, PowerShell/Bash.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">•</span>
              <span><strong>Windows Troubleshooting:</strong> Fixing Windows 11/10 update errors, registry/GPO fixes, memory leaks.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">•</span>
              <span><strong>AI Automation Scripts:</strong> Practical Python automation, LLM API tools (DeepSeek/Gemini), CLI utilities.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">•</span>
              <span><strong>Technical SEO & Infrastructure:</strong> GSC 301 redirect fixes, Cloudflare WAF rules, performance tuning.</span>
            </li>
          </ul>
        </div>

        <div>
          <h3 class="text-base font-bold text-rose-600 dark:text-rose-400 mb-3 flex items-center gap-2">
            <span>❌</span> What We Immediately Decline
          </h3>
          <ul class="space-y-2 text-sm text-text-muted dark:text-text-dark-muted">
            <li class="flex items-start gap-2">
              <span class="text-rose-500 font-bold">•</span>
              <span>Pure AI-generated fluff or unverified ChatGPT/DeepSeek rewrites.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-rose-500 font-bold">•</span>
              <span>Link-farming articles or promotional posts for casinos/crypto/gambling.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-rose-500 font-bold">•</span>
              <span>Generic listicles with non-working terminal instructions.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-rose-500 font-bold">•</span>
              <span>Raw zip/image attachments (Google Doc URLs required).</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="rounded-2xl bg-surface-alt/60 p-4 dark:bg-surface-dark-alt/40 border border-border/60 dark:border-border-dark/60">
        <p class="text-xs text-text-muted dark:text-text-dark-muted leading-relaxed">
          💡 <strong>E-E-A-T Requirement:</strong> Every article published on PraveenTechWorld must share firsthand experience, tested code snippets, and actual error tracebacks. We document what worked, what failed, and how it was resolved on real machines.
        </p>
      </div>
    </div>

    <!-- Pitch Submission Form -->
    <div class="rounded-3xl border border-border bg-surface-alt/20 p-6 dark:border-border-dark dark:bg-surface-dark-alt/10 md:p-10">
      <h2 class="text-2xl font-extrabold text-text dark:text-text-dark mb-2">Submit Your Guest Pitch</h2>
      <p class="text-sm text-text-muted dark:text-text-dark-muted mb-8">
        Pitches are queued in our Cloudflare Edge KV buffer and synchronized directly to our editorial board.
      </p>

      <form id="pitch-form" action="https://formspree.io/f/xbdejjpr" method="POST" class="space-y-6 max-w-2xl">
        
        <!-- Honeypot Anti-Spam (Hidden from humans) -->
        <input type="text" name="website_hp" style="display:none !important;" tabindex="-1" autocomplete="off" />

        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="name" class="mb-2 block text-xs font-bold uppercase tracking-wider text-text dark:text-text-dark">Author Name *</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-text placeholder:text-text-muted focus:border-brand-600 focus:outline-none dark:border-border-dark dark:bg-surface-dark dark:text-text-dark dark:placeholder:text-text-dark-muted"
              placeholder="e.g. Alex Rivera"
            />
          </div>
          <div>
            <label for="email" class="mb-2 block text-xs font-bold uppercase tracking-wider text-text dark:text-text-dark">Author Email *</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-text placeholder:text-text-muted focus:border-brand-600 focus:outline-none dark:border-border-dark dark:bg-surface-dark dark:text-text-dark dark:placeholder:text-text-dark-muted"
              placeholder="alex@example.com"
            />
          </div>
        </div>

        <div>
          <label for="topic" class="mb-2 block text-xs font-bold uppercase tracking-wider text-text dark:text-text-dark">Proposed Topic / Working Headline *</label>
          <input
            type="text"
            id="topic"
            name="topic"
            required
            class="w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-text placeholder:text-text-muted focus:border-brand-600 focus:outline-none dark:border-border-dark dark:bg-surface-dark dark:text-text-dark dark:placeholder:text-text-dark-muted"
            placeholder="e.g. How to Fix Docker Volume Permission Denied Errors on Debian 12"
          />
        </div>

        <div>
          <label for="outline" class="mb-2 block text-xs font-bold uppercase tracking-wider text-text dark:text-text-dark">3-Bullet Pitch Outline & Problem Solved *</label>
          <textarea
            id="outline"
            name="outline"
            rows="4"
            required
            class="w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-text placeholder:text-text-muted focus:border-brand-600 focus:outline-none dark:border-border-dark dark:bg-surface-dark dark:text-text-dark dark:placeholder:text-text-dark-muted"
            placeholder="1. The exact error scenario encountered&#10;2. Terminal diagnostics & log commands&#10;3. Verified 3-step fix with permissions script"
          ></textarea>
        </div>

        <div>
          <label for="doc_url" class="mb-2 block text-xs font-bold uppercase tracking-wider text-text dark:text-text-dark">Google Doc / Outline Link *</label>
          <input
            type="url"
            id="doc_url"
            name="doc_url"
            required
            class="w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-text placeholder:text-text-muted focus:border-brand-600 focus:outline-none dark:border-border-dark dark:bg-surface-dark dark:text-text-dark dark:placeholder:text-text-dark-muted"
            placeholder="https://docs.google.com/document/d/... (Set to Anyone with link can comment)"
          />
        </div>

        <!-- Cloudflare Turnstile Security Widget -->
        <div id="turnstile-wrapper" class="my-4 min-h-[65px] flex justify-start items-center">
          <div
            id="turnstile-container"
            class="cf-turnstile"
            data-sitekey="0x4AAAAAAECdrXzclXfWcMEd"
            data-action="turnstile-spin-v2"
            data-theme="auto"
          ></div>
        </div>

        <div id="pitch-status" class="hidden rounded-xl p-4 text-sm font-medium"></div>

        <button
          type="submit"
          id="pitch-submit-btn"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-brand-600 px-8 py-3.5 text-sm font-bold text-white transition-all hover:bg-brand-700 hover:shadow-lg hover:shadow-brand-600/25 disabled:opacity-50"
        >
          Submit Pitch for Review 🚀
        </button>
      </form>
    </div>

  </div>

  <!-- Cloudflare Turnstile Script with is:inline -->
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <!-- Submission Handler with Turnstile Verification -->
  <script is:inline>
    const pitchForm = document.getElementById('pitch-form');
    const statusDiv = document.getElementById('pitch-status');
    const submitBtn = document.getElementById('pitch-submit-btn');

    // Safe Turnstile Render Fallback
    function initTurnstileWidget() {
      const container = document.getElementById('turnstile-container');
      if (!container) return;

      // If iframe already rendered by Cloudflare auto-script, do nothing
      if (container.querySelector('iframe')) return;

      if (window.turnstile && typeof window.turnstile.render === 'function') {
        try {
          window.turnstile.render('#turnstile-container', {
            sitekey: '0x4AAAAAAECdrXzclXfWcMEd',
            action: 'turnstile-spin-v2',
            theme: 'auto'
          });
        } catch (err) {
          console.warn('Turnstile render notice:', err);
        }
      }
    }

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      setTimeout(initTurnstileWidget, 200);
      setTimeout(initTurnstileWidget, 1000);
    } else {
      window.addEventListener('load', () => {
        setTimeout(initTurnstileWidget, 200);
        setTimeout(initTurnstileWidget, 1000);
      });
    }


    if (pitchForm) {
      pitchForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        // Honeypot check
        const formData = new FormData(pitchForm);
        if (formData.get('website_hp')) {
          // Bot detected - simulate silent success
          statusDiv.className = 'rounded-xl p-4 text-sm font-medium bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300';
          statusDiv.innerText = '✅ Thank you! Your pitch has been submitted successfully.';
          pitchForm.reset();
          return;
        }

        submitBtn.disabled = true;
        submitBtn.innerText = 'Submitting Pitch...';
        statusDiv.className = 'hidden';

        try {
          // Submit via Formspree API (Guaranteed Delivery)
          const response = await fetch(pitchForm.action, {
            method: 'POST',
            body: formData,
            headers: {
              'Accept': 'application/json'
            }
          });

          if (response.ok) {
            statusDiv.className = 'rounded-xl p-4 text-sm font-medium bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300';
            statusDiv.innerText = '✅ Pitch submitted successfully! Our editorial team will review your outline within 48 hours.';
            pitchForm.reset();
          } else {
            const result = await response.json();
            statusDiv.className = 'rounded-xl p-4 text-sm font-medium bg-rose-100 text-rose-800 dark:bg-rose-900/40 dark:text-rose-300';
            statusDiv.innerText = result.error || '❌ Submission error. Please email contact@praveentechworld.com directly.';
          }
        } catch (err) {
          statusDiv.className = 'rounded-xl p-4 text-sm font-medium bg-rose-100 text-rose-800 dark:bg-rose-900/40 dark:text-rose-300';
          statusDiv.innerText = '❌ Network error submitting pitch. Please email contact@praveentechworld.com directly.';
        } finally {
          submitBtn.disabled = false;
          submitBtn.innerText = 'Submit Pitch for Review 🚀';
        }
      });
    }
  </script>
</BaseLayout>
