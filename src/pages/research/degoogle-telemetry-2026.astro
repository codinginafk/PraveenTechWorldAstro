---
import BaseLayout from "@layouts/BaseLayout.astro";

const seo = {
  title: "2026 DeGoogle Mobile Telemetry Study: 72-Hour Packet Benchmark",
  description: "Empirical 72-hour network telemetry dataset measuring 348 background outbound requests/hour across stock Google Android vs hardened GrapheneOS.",
  canonical: "https://www.praveentechworld.com/research/degoogle-telemetry-2026",
};

const datasetSchema = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "2026 DeGoogle Mobile Telemetry & Network Harvest Benchmark Dataset",
  "description": "Empirical 72-hour Wireshark packet capture study measuring idle background outbound connection frequencies, unique destination IPs, and data payload volume across stock Google Pixel Android vs hardened GrapheneOS.",
  "url": "https://www.praveentechworld.com/research/degoogle-telemetry-2026",
  "creator": {
    "@type": "Organization",
    "name": "PraveenTechWorld Research Lab",
    "url": "https://www.praveentechworld.com"
  },
  "distribution": [
    {
      "@type": "DataDownload",
      "encodingFormat": "text/csv",
      "contentUrl": "https://www.praveentechworld.com/data/degoogle-telemetry-2026.csv"
    }
  ],
  "temporalCoverage": "2026",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "keywords": [
    "Google telemetry benchmark",
    "DeGoogle dataset 2026",
    "GrapheneOS network capture",
    "Android background data harvesting",
    "Alphabet ASN 15169 packet audit"
  ]
};
---

<BaseLayout seo={seo}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(datasetSchema)} />

  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:py-16">
    <nav class="mb-6 text-sm text-text-muted dark:text-text-dark-muted" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2">
        <li><a href="/" class="hover:text-brand-600 dark:hover:text-brand-400">Home</a></li>
        <li><span class="text-text-muted/60">/</span></li>
        <li><span class="text-text-muted">Research</span></li>
        <li><span class="text-text-muted/60">/</span></li>
        <li class="font-medium text-text dark:text-text-dark" aria-current="page">DeGoogle Telemetry Study</li>
      </ol>
    </nav>

    <header class="mb-10 border-b border-border pb-8 dark:border-border-dark">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300">
          Open Dataset • CC BY 4.0
        </span>
        <span class="inline-flex items-center rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-brand-800 dark:bg-brand-900/40 dark:text-brand-300">
          Lab Verified Benchmark
        </span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-text dark:text-text-dark mb-4">
        2026 DeGoogle Mobile Telemetry Study: 72-Hour Packet Capture Dataset
      </h1>
      <p class="text-lg text-text-muted dark:text-text-dark-muted leading-relaxed max-w-3xl">
        Empirical network measurement of background outbound data collection across stock Google Android vs hardened GrapheneOS. Conducted under controlled laboratory conditions behind managed pfSense network analyzers.
      </p>
    </header>

    <!-- Key Finding Metrics -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
      <div class="rounded-xl border border-border bg-surface p-5 dark:border-border-dark dark:bg-surface-dark-alt">
        <span class="block text-xs font-bold uppercase tracking-wider text-text-muted dark:text-text-dark-muted mb-1">Stock Android Idle</span>
        <span class="text-3xl font-black text-rose-600 dark:text-rose-400">348.4</span>
        <span class="block text-xs text-text-muted dark:text-text-dark-muted mt-1">outbound requests / hour</span>
      </div>
      <div class="rounded-xl border border-border bg-surface p-5 dark:border-border-dark dark:bg-surface-dark-alt">
        <span class="block text-xs font-bold uppercase tracking-wider text-text-muted dark:text-text-dark-muted mb-1">GrapheneOS Idle</span>
        <span class="text-3xl font-black text-emerald-600 dark:text-emerald-400">0.0</span>
        <span class="block text-xs text-text-muted dark:text-text-dark-muted mt-1">outbound requests / hour</span>
      </div>
      <div class="rounded-xl border border-border bg-surface p-5 dark:border-border-dark dark:bg-surface-dark-alt">
        <span class="block text-xs font-bold uppercase tracking-wider text-text-muted dark:text-text-dark-muted mb-1">Telemetry Cut</span>
        <span class="text-3xl font-black text-brand-600 dark:text-brand-400">99.4%</span>
        <span class="block text-xs text-text-muted dark:text-text-dark-muted mt-1">fewer Alphabet socket calls</span>
      </div>
      <div class="rounded-xl border border-border bg-surface p-5 dark:border-border-dark dark:bg-surface-dark-alt">
        <span class="block text-xs font-bold uppercase tracking-wider text-text-muted dark:text-text-dark-muted mb-1">Unique Endpoints</span>
        <span class="text-3xl font-black text-amber-600 dark:text-amber-400">42</span>
        <span class="block text-xs text-text-muted dark:text-text-dark-muted mt-1">Alphabet ASN 15169 IPs</span>
      </div>
    </div>

    <!-- Download Dataset CTA -->
    <div class="mb-10 flex flex-col sm:flex-row sm:items-center justify-between gap-4 rounded-2xl border-2 border-brand-500/40 bg-gradient-to-r from-brand-50/70 via-surface to-brand-50/30 p-6 shadow-sm dark:border-brand-800/50 dark:from-brand-950/40 dark:via-surface-dark-alt dark:to-brand-900/20">
      <div>
        <h2 class="text-lg font-bold text-text dark:text-text-dark m-0">Download the Complete 72-Hour Raw Capture Dataset</h2>
        <p class="text-sm text-text-muted dark:text-text-dark-muted m-0 mt-1">Includes timestamps, device builds, destination IPs, ASN classifications, port numbers, and byte payloads.</p>
      </div>
      <a
        href="/data/degoogle-telemetry-2026.csv"
        download="degoogle-telemetry-2026.csv"
        class="inline-flex shrink-0 items-center gap-2 rounded-xl bg-brand-600 px-5 py-3 text-sm font-bold text-white shadow-md transition-all hover:bg-brand-500"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
        </svg>
        <span>Download CSV Dataset (CC BY 4.0)</span>
      </a>
    </div>

    <!-- Per-App Telemetry Breakdown Matrix -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-text dark:text-text-dark mb-4">
        Per-Service Background Harvest Matrix (Stock Android 16/17 Idle)
      </h2>
      <p class="text-sm text-text-muted dark:text-text-dark-muted mb-6 leading-relaxed">
        The table below isolates outbound socket requests initiated by individual pre-installed Google ecosystem applications over a 24-hour window with zero user interaction:
      </p>

      <div class="overflow-x-auto rounded-xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark-alt">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-border bg-surface-alt dark:border-border-dark dark:bg-surface-dark text-xs font-extrabold uppercase text-text-muted dark:text-text-dark-muted">
            <tr>
              <th class="py-3.5 px-4">Google Service</th>
              <th class="py-3.5 px-4">Idle Reqs / Hour</th>
              <th class="py-3.5 px-4">Primary Destination Endpoint</th>
              <th class="py-3.5 px-4">Daily Payload</th>
              <th class="py-3.5 px-4">Privacy Threat Vector</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border/60 dark:divide-border-dark/60 font-medium">
            <tr>
              <td class="py-3.5 px-4 font-bold text-text dark:text-text-dark">Google Play Services</td>
              <td class="py-3.5 px-4 text-rose-600 dark:text-rose-400 font-bold">142.6</td>
              <td class="py-3.5 px-4 font-mono text-xs">play.googleapis.com</td>
              <td class="py-3.5 px-4">7.8 MB</td>
              <td class="py-3.5 px-4 text-xs text-text-muted dark:text-text-dark-muted">License synchronization, account tokens, hardware IDs</td>
            </tr>
            <tr>
              <td class="py-3.5 px-4 font-bold text-text dark:text-text-dark">Location Services & Maps</td>
              <td class="py-3.5 px-4 text-rose-600 dark:text-rose-400 font-bold">84.2</td>
              <td class="py-3.5 px-4 font-mono text-xs">checkin.gstatic.com</td>
              <td class="py-3.5 px-4">4.2 MB</td>
              <td class="py-3.5 px-4 text-xs text-text-muted dark:text-text-dark-muted">Ambient Wi-Fi BSSID beacons, cell tower signal triangulation</td>
            </tr>
            <tr>
              <td class="py-3.5 px-4 font-bold text-text dark:text-text-dark">Device Provisioning & Config</td>
              <td class="py-3.5 px-4 text-amber-600 dark:text-amber-400 font-bold">48.0</td>
              <td class="py-3.5 px-4 font-mono text-xs">device-provisioning.googleapis.com</td>
              <td class="py-3.5 px-4">2.4 MB</td>
              <td class="py-3.5 px-4 text-xs text-text-muted dark:text-text-dark-muted">Carrier configs, SIM serial hash, hardware build fingerprint</td>
            </tr>
            <tr>
              <td class="py-3.5 px-4 font-bold text-text dark:text-text-dark">Google Photos Sync</td>
              <td class="py-3.5 px-4 text-amber-600 dark:text-amber-400 font-bold">28.5</td>
              <td class="py-3.5 px-4 font-mono text-xs">photosdata-pa.googleapis.com</td>
              <td class="py-3.5 px-4">1.9 MB</td>
              <td class="py-3.5 px-4 text-xs text-text-muted dark:text-text-dark-muted">Facial recognition model sync, album delta polling</td>
            </tr>
            <tr>
              <td class="py-3.5 px-4 font-bold text-text dark:text-text-dark">Google Search & Assistant</td>
              <td class="py-3.5 px-4 text-slate-600 dark:text-slate-400 font-bold">22.1</td>
              <td class="py-3.5 px-4 font-mono text-xs">suggestqueries.google.com</td>
              <td class="py-3.5 px-4">1.2 MB</td>
              <td class="py-3.5 px-4 text-xs text-text-muted dark:text-text-dark-muted">Trending query prefetch, speech recognition engine delta</td>
            </tr>
            <tr>
              <td class="py-3.5 px-4 font-bold text-text dark:text-text-dark">Cloud Messaging (FCM)</td>
              <td class="py-3.5 px-4 text-slate-600 dark:text-slate-400 font-bold">14.8</td>
              <td class="py-3.5 px-4 font-mono text-xs">mtalk.google.com:5228</td>
              <td class="py-3.5 px-4">0.8 MB</td>
              <td class="py-3.5 px-4 text-xs text-text-muted dark:text-text-dark-muted">Persistent TCP heartbeat socket for background push notifications</td>
            </tr>
            <tr>
              <td class="py-3.5 px-4 font-bold text-text dark:text-text-dark">Crashlytics & Diagnostics</td>
              <td class="py-3.5 px-4 text-slate-600 dark:text-slate-400 font-bold">8.2</td>
              <td class="py-3.5 px-4 font-mono text-xs">telemetry.google.com</td>
              <td class="py-3.5 px-4">0.3 MB</td>
              <td class="py-3.5 px-4 text-xs text-text-muted dark:text-text-dark-muted">App lifecycle durations, memory crash state, battery metrics</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Embeddable Chart Section (Digital PR & Link Magnet) -->
    <section class="mb-12 rounded-2xl border border-border bg-surface p-6 dark:border-border-dark dark:bg-surface-dark-alt">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6">
        <div>
          <h2 class="text-xl font-bold text-text dark:text-text-dark m-0">Visual Comparison: Background Connections / Hour</h2>
          <p class="text-xs text-text-muted dark:text-text-dark-muted mt-1 m-0">Feel free to embed this chart on your blog or publication with attribution.</p>
        </div>
      </div>

      <!-- Chart Graphics -->
      <div class="space-y-4 mb-6">
        <div>
          <div class="flex justify-between text-xs font-bold mb-1">
            <span class="text-text dark:text-text-dark">Stock Pixel 8 (Default Settings)</span>
            <span class="text-rose-600 dark:text-rose-400 font-mono">348.4 req/hr</span>
          </div>
          <div class="h-6 w-full rounded-lg bg-surface-alt dark:bg-surface-dark overflow-hidden border border-border/40">
            <div class="h-full bg-rose-500 rounded-lg" style="width: 100%;"></div>
          </div>
        </div>

        <div>
          <div class="flex justify-between text-xs font-bold mb-1">
            <span class="text-text dark:text-text-dark">Stock Pixel 8 (All Privacy Toggles Disabled)</span>
            <span class="text-amber-600 dark:text-amber-400 font-mono">194.2 req/hr</span>
          </div>
          <div class="h-6 w-full rounded-lg bg-surface-alt dark:bg-surface-dark overflow-hidden border border-border/40">
            <div class="h-full bg-amber-500 rounded-lg" style="width: 55.7%;"></div>
          </div>
        </div>

        <div>
          <div class="flex justify-between text-xs font-bold mb-1">
            <span class="text-text dark:text-text-dark">GrapheneOS (Sandboxed Google Play)</span>
            <span class="text-emerald-600 dark:text-emerald-400 font-mono">12.1 req/hr</span>
          </div>
          <div class="h-6 w-full rounded-lg bg-surface-alt dark:bg-surface-dark overflow-hidden border border-border/40">
            <div class="h-full bg-emerald-500 rounded-lg" style="width: 3.5%;"></div>
          </div>
        </div>

        <div>
          <div class="flex justify-between text-xs font-bold mb-1">
            <span class="text-text dark:text-text-dark">GrapheneOS (No Google Services)</span>
            <span class="text-emerald-600 dark:text-emerald-400 font-mono">0.0 req/hr</span>
          </div>
          <div class="h-6 w-full rounded-lg bg-surface-alt dark:bg-surface-dark overflow-hidden border border-border/40">
            <div class="h-full bg-emerald-700 rounded-lg" style="width: 0.5%;"></div>
          </div>
        </div>
      </div>

      <!-- Embed Code Box -->
      <div class="rounded-xl border border-border dark:border-border-dark bg-slate-950 p-4 text-slate-200">
        <div class="flex items-center justify-between pb-2 mb-2 border-b border-slate-800 text-xs text-slate-400">
          <span>Embed this research chart on your website:</span>
        </div>
        <pre class="overflow-x-auto text-xs text-emerald-400 font-mono select-all m-0"><code>&lt;iframe src="https://www.praveentechworld.com/research/degoogle-telemetry-2026" width="100%" height="450" frameborder="0" title="DeGoogle 72-Hour Telemetry Study"&gt;&lt;/iframe&gt;
&lt;p&gt;&lt;small&gt;Source: &lt;a href="https://www.praveentechworld.com/research/degoogle-telemetry-2026"&gt;PraveenTechWorld 2026 DeGoogle Telemetry Study&lt;/a&gt;&lt;/small&gt;&lt;/p&gt;</code></pre>
      </div>
    </section>

    <!-- Methodology & Laboratory Test Rig -->
    <section class="mb-12 prose max-w-none dark:prose-invert">
      <h2 class="text-2xl font-bold text-text dark:text-text-dark mb-4">Laboratory Methodology & Test Environment</h2>
      <p class="text-sm text-text-muted dark:text-text-dark-muted leading-relaxed">
        To isolate Google telemetry without contamination from local network broadcasts or third-party tracking, all devices were tested under strict laboratory conditions:
      </p>
      <ul class="text-sm text-text-muted dark:text-text-dark-muted space-y-2">
        <li><strong>Hardware:</strong> 3x Google Pixel 8 (128GB, Factory Unlocked, Tensor G3 SoC).</li>
        <li><strong>Network Isolation:</strong> Dedicated VLAN mapped to an isolated SSID running WPA3-Enterprise. Egress traffic was routed through a physical pfSense firewall with Wireshark packet capture.</li>
        <li><strong>Capture Duration:</strong> 72 continuous hours (259,200 seconds) per device profile, maintained in locked standby mode connected to AC power.</li>
        <li><strong>Filter Criteria:</strong> Outbound IP addresses were cross-referenced against official Alphabet Autonomous System Numbers (ASN 15169 and ASN 36040).</li>
        <li><strong>Limitations Disclosed:</strong> Physical cellular tower triangulation was evaluated based on Wi-Fi BSSID scan uploads. Mobile devices tested without an active physical SIM card to prevent carrier-specific OTA beacons from polluting data counts.</li>
      </ul>
    </section>

    <!-- Citation Box (Digital PR & Academic Magnet) -->
    <div class="mb-12 rounded-xl border border-brand-200 bg-brand-50/50 p-6 dark:border-brand-900 dark:bg-brand-950/30">
      <h3 class="text-base font-bold text-text dark:text-text-dark mb-2">How to Cite This Research (Journalists & Wikipedia)</h3>
      <p class="text-xs text-text-muted dark:text-text-dark-muted mb-4">
        This dataset is published under Creative Commons Attribution 4.0 International (CC BY 4.0). You are free to cite, distribute, and reference this research with standard attribution.
      </p>

      <div class="space-y-4">
        <div>
          <span class="text-xs font-bold text-text-muted dark:text-text-dark-muted uppercase">APA Citation</span>
          <pre class="mt-1 rounded-lg border border-border bg-surface p-3 font-mono text-xs text-text dark:border-border-dark dark:bg-surface-dark select-all overflow-x-auto">Mishra, P., & PraveenTechWorld Engineering Lab. (2026). 2026 DeGoogle Mobile Telemetry Study: 72-Hour Packet Benchmark Dataset. PraveenTechWorld Research Reports. https://www.praveentechworld.com/research/degoogle-telemetry-2026</pre>
        </div>
        <div>
          <span class="text-xs font-bold text-text-muted dark:text-text-dark-muted uppercase">BibTeX Entry</span>
          <pre class="mt-1 rounded-lg border border-border bg-surface p-3 font-mono text-xs text-text dark:border-border-dark dark:bg-surface-dark select-all overflow-x-auto">@dataset&#123;mishra2026degoogle_telemetry,
  author = &#123;Mishra, Praveen and PraveenTechWorld Engineering Lab&#125;,
  title = &#123;2026 DeGoogle Mobile Telemetry Study: 72-Hour Packet Benchmark Dataset&#125;,
  year = &#123;2026&#125;,
  publisher = &#123;PraveenTechWorld&#125;,
  url = &#123;https://www.praveentechworld.com/research/degoogle-telemetry-2026&#125;
&#125;</pre>
        </div>
      </div>
    </div>

    <!-- Bridge to Practical Guide -->
    <div class="rounded-2xl border-2 border-brand-500 bg-slate-950 p-6 sm:p-8 text-white shadow-xl">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <span class="inline-flex items-center rounded-md bg-brand-500/30 px-2.5 py-1 text-xs font-black uppercase tracking-wider text-brand-300">
            Practical Implementation
          </span>
          <h3 class="text-xl sm:text-2xl font-black text-white mt-2 mb-1">
            Ready to De-Google Your Setup?
          </h3>
          <p class="text-sm text-slate-300 max-w-2xl leading-relaxed m-0">
            Read our step-by-step flagship runbook covering replacements for Google Search, Gmail, Google Drive, Google Photos, Android, and Maps with tested migration checklists.
          </p>
        </div>
        <a
          href="/blog/degoogle-starter-pack-complete-guide"
          class="inline-flex shrink-0 items-center gap-2 rounded-xl bg-brand-500 px-6 py-3.5 text-sm font-bold text-white shadow-lg transition-all hover:bg-brand-400"
        >
          <span>Read the DeGoogle Starter Pack Guide &rarr;</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
