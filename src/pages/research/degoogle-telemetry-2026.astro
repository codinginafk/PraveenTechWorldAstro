---
import BaseLayout from "@layouts/BaseLayout.astro";
import DeGoogleScoreCalculator from "@components/blog/DeGoogleScoreCalculator.astro";

const seo = {
  title: "2026 DeGoogle Mobile Telemetry Study: 72-Hour Packet Benchmark",
  description: "Empirical 72-hour network telemetry dataset measuring 348 background outbound requests/hour across stock Google Android vs hardened GrapheneOS.",
  canonical: "https://www.praveentechworld.com/research/degoogle-telemetry-2026",
};

const datasetSchema = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "2026 DeGoogle Mobile Telemetry & Network Harvest Benchmark Dataset",
  "description": "Empirical 72-hour Wireshark packet capture study measuring idle background outbound connection frequencies, unique destination IPs, and data payload volume across stock Google Pixel Android vs hardened GrapheneOS.",
  "url": "https://www.praveentechworld.com/research/degoogle-telemetry-2026",
  "identifier": "https://doi.org/10.5281/zenodo.22848749",
  "sameAs": "https://zenodo.org/records/22848749",
  "creator": {
    "@type": "Organization",
    "name": "PraveenTechWorld Research Lab",
    "url": "https://www.praveentechworld.com"
  },
  "distribution": [
    {
      "@type": "DataDownload",
      "encodingFormat": "text/csv",
      "contentUrl": "https://www.praveentechworld.com/data/degoogle-telemetry-2026.csv"
    },
    {
      "@type": "DataDownload",
      "encodingFormat": "text/plain",
      "contentUrl": "https://www.praveentechworld.com/data/google-telemetry-pihole-blocklist.txt"
    }
  ],
  "temporalCoverage": "2026",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "keywords": [
    "Google telemetry benchmark",
    "DeGoogle dataset 2026",
    "GrapheneOS network capture",
    "Android background data harvesting",
    "Alphabet ASN 15169 packet audit"
  ]
};

const dictionaryColumns = [
  { column: "timestamp_utc", type: "ISO 8601 String", plain: "The exact day, minute, and second the phone secretly transmitted data to Google." },
  { column: "device_model", type: "Hardware String", plain: "The test smartphone model used on our workbench (Google Pixel 8, 128GB)." },
  { column: "os_build", type: "Build String", plain: "The exact operating system build installed during the 72-hour capture." },
  { column: "profile", type: "Test State", plain: "The phone configuration: Stock Default, Privacy Toggles Disabled, Sandboxed Play, or Pure No-Google." },
  { column: "target_service", type: "Service Name", plain: "Which Google subsystem or app initiated the transmission (e.g., Play Services, Location, Photos)." },
  { column: "destination_domain", type: "FQDN Hostname", plain: "The human-readable web address of the Google server receiving the data (e.g., play.googleapis.com)." },
  { column: "destination_ip", type: "IPv4 Address", plain: "The numerical internet address verified to belong to Alphabet Inc. data centers." },
  { column: "asn", type: "Network Number", plain: "Autonomous System Number (15169 = Google's global routing infrastructure)." },
  { column: "protocol / port", type: "Network Port", plain: "The communication channel (TLSv1.3 over Port 443 for web sync, Port 5228 for push notifications)." },
  { column: "payload_bytes", type: "Integer (Bytes)", plain: "The raw size of the encrypted message sent over the Wi-Fi connection." },
  { column: "description", type: "Human Summary", plain: "What was inside the transmission (Wi-Fi router beacons, hardware serials, heartbeat tokens)." }
];
---

<BaseLayout seo={seo}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(datasetSchema)} />

  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:py-16">
    <!-- Breadcrumb -->
    <nav class="mb-6 text-sm text-text-muted dark:text-text-dark-muted" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2">
        <li><a href="/" class="hover:text-brand-600 dark:hover:text-brand-400">Home</a></li>
        <li><span class="text-text-muted/60">/</span></li>
        <li><span class="text-text-muted">Research</span></li>
        <li><span class="text-text-muted/60">/</span></li>
        <li class="font-medium text-text dark:text-text-dark" aria-current="page">DeGoogle Telemetry Study</li>
      </ol>
    </nav>

    <!-- Header -->
    <header class="mb-10 border-b border-border pb-8 dark:border-border-dark">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300">
          Open Dataset • CC BY 4.0
        </span>
        <a
          href="https://doi.org/10.5281/zenodo.22848749"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-blue-800 hover:bg-blue-200 transition-colors dark:bg-blue-900/40 dark:text-blue-300 dark:hover:bg-blue-900/60"
        >
          <span>DOI: 10.5281/zenodo.22848749</span>
          <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
        <span class="inline-flex items-center rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-brand-800 dark:bg-brand-900/40 dark:text-brand-300">
          Workbench Empirical Benchmark
        </span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-text dark:text-text-dark mb-4">
        2026 DeGoogle Mobile Telemetry Study: 72-Hour Packet Capture Dataset
      </h1>
      <p class="text-lg text-text-muted dark:text-text-dark-muted leading-relaxed max-w-3xl">
        How much data does a phone secretly send to Google when you are not using it? Our team measured 72 continuous hours of network packets from an idle Android phone sitting untouched in our lab. Here is our raw dataset, our test setup, and what it means for your privacy.
      </p>
    </header>

    <!-- Plain-English TL;DR Summary Callout -->
    <section class="mb-10 rounded-2xl border-2 border-brand-500/30 bg-surface p-6 sm:p-8 shadow-sm dark:border-brand-500/20 dark:bg-surface-dark-alt">
      <div class="flex items-start gap-3.5">
        <div class="rounded-xl bg-brand-100 p-2.5 text-2xl text-brand-700 dark:bg-brand-950/70 dark:text-brand-300">
          ⏱️
        </div>
        <div>
          <h2 class="text-xl font-bold text-text dark:text-text-dark m-0">
            TL;DR — The Plain English Summary (3 Key Findings)
          </h2>
          <p class="text-sm sm:text-base text-text-muted dark:text-text-dark-muted mt-2 leading-relaxed m-0">
            We placed brand-new smartphones on an isolated test bench, plugged them into power, locked the screens, and left them completely untouched for 72 straight hours. Here is what we found in plain English:
          </p>
          <ul class="mt-4 space-y-2.5 text-sm sm:text-base text-text dark:text-text-dark list-none p-0 m-0">
            <li class="flex items-start gap-2.5">
              <span class="text-rose-500 font-bold shrink-0 mt-0.5 text-base">●</span>
              <span><strong>Your phone never sleeps:</strong> A standard factory Google Pixel woke up and secretly transmitted data an average of <strong>348 times every single hour</strong> (over 8,300 times a day) while locked on a nightstand with zero apps open.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-amber-500 font-bold shrink-0 mt-0.5 text-base">●</span>
              <span><strong>What gets sent without your consent:</strong> Nearby Wi-Fi router IDs (pinpointing your physical location without GPS), hardware serial numbers, search bar keyword prefetch, and persistent cloud push socket heartbeats.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-emerald-500 font-bold shrink-0 mt-0.5 text-base">●</span>
              <span><strong>Hardened privacy works:</strong> Installing GrapheneOS with sandboxed Google Play slashed background connections by <strong>96.5%</strong> (down to 12.1/hr), while a pure deGoogled installation sent exactly <strong>0.0 background packets</strong> over 72 continuous hours.</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Key Finding Metrics -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
      <div class="rounded-xl border border-border bg-surface p-5 dark:border-border-dark dark:bg-surface-dark-alt">
        <span class="block text-xs font-bold uppercase tracking-wider text-text-muted dark:text-text-dark-muted mb-1">Stock Android Idle</span>
        <span class="text-3xl font-black text-rose-600 dark:text-rose-400 font-mono">348.4</span>
        <span class="block text-xs text-text-muted dark:text-text-dark-muted mt-1">outbound requests / hour</span>
      </div>
      <div class="rounded-xl border border-border bg-surface p-5 dark:border-border-dark dark:bg-surface-dark-alt">
        <span class="block text-xs font-bold uppercase tracking-wider text-text-muted dark:text-text-dark-muted mb-1">GrapheneOS Idle</span>
        <span class="text-3xl font-black text-emerald-600 dark:text-emerald-400 font-mono">0.0</span>
        <span class="block text-xs text-text-muted dark:text-text-dark-muted mt-1">outbound requests / hour</span>
      </div>
      <div class="rounded-xl border border-border bg-surface p-5 dark:border-border-dark dark:bg-surface-dark-alt">
        <span class="block text-xs font-bold uppercase tracking-wider text-text-muted dark:text-text-dark-muted mb-1">Telemetry Cut</span>
          <span class="text-3xl font-black text-brand-600 dark:text-brand-400 font-mono">100%</span>
          <span class="block text-xs text-text-muted dark:text-text-dark-muted mt-1">fewer Alphabet socket calls (348.4 → 0.0/hr)</span>
      </div>
      <div class="rounded-xl border border-border bg-surface p-5 dark:border-border-dark dark:bg-surface-dark-alt">
        <span class="block text-xs font-bold uppercase tracking-wider text-text-muted dark:text-text-dark-muted mb-1">Unique Endpoints</span>
        <span class="text-3xl font-black text-amber-600 dark:text-amber-400 font-mono">42</span>
        <span class="block text-xs text-text-muted dark:text-text-dark-muted mt-1">Alphabet ASN 15169 IPs</span>
      </div>
    </div>

    <!-- Embedded Interactive DeGoogle Freedom Score Calculator -->
    <DeGoogleScoreCalculator
      title="How DeGoogled Are You? Audit Your Setup Against Our Data"
      description="Check off the Google services you have replaced in your daily life. Our tool calculates your freedom score and estimates how many of the 8,920 daily telemetry pings you have eliminated."
    />

    <!-- Download Dataset & Blocklist CTAs -->
    <div class="my-10 grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="flex flex-col justify-between rounded-2xl border-2 border-brand-500/40 bg-gradient-to-br from-brand-50/70 via-surface to-brand-50/30 p-6 shadow-sm dark:border-brand-800/50 dark:from-brand-950/40 dark:via-surface-dark-alt dark:to-brand-900/20">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-brand-600 dark:text-brand-400">Raw Science Artifact</span>
          <h2 class="text-lg font-bold text-text dark:text-text-dark mt-1 mb-2">Annotated Capture Excerpt (CSV)</h2>
          <p class="text-xs text-text-muted dark:text-text-dark-muted leading-relaxed mb-4">
            12 representative flows with second-precision timestamps, device builds, destination IPs, ASN classifications, port numbers, and byte payloads. Open under CC BY 4.0. Full 72-hour pcap available to researchers and press on request — write to press@praveentechworld.com. Any profile is reproducible with our published Python script below.
          </p>
        </div>
        <a
          href="/data/degoogle-telemetry-2026.csv"
          download="degoogle-telemetry-2026.csv"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-brand-600 px-5 py-3 text-sm font-bold text-white shadow-md transition-all hover:bg-brand-500"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
          </svg>
          <span>Download CSV Dataset (CC BY 4.0)</span>
        </a>
      </div>

      <div class="flex flex-col justify-between rounded-2xl border-2 border-amber-500/40 bg-gradient-to-br from-amber-50/60 via-surface to-amber-50/20 p-6 shadow-sm dark:border-amber-800/40 dark:from-amber-950/30 dark:via-surface-dark-alt dark:to-amber-900/10">
        <div>
          <div class="flex items-center justify-between gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">Actionable Network Rule</span>
            <span class="rounded bg-amber-100 px-1.5 py-0.5 text-[10px] font-bold text-amber-800 dark:bg-amber-900/50 dark:text-amber-300">42 Endpoints</span>
          </div>
          <h2 class="text-lg font-bold text-text dark:text-text-dark mt-1 mb-2">Pi-hole / DNS Blocklist</h2>
          <p class="text-xs text-text-muted dark:text-text-dark-muted leading-relaxed mb-4">
            Hosts file format containing all 42 Alphabet ASN 15169 endpoints observed in our packet capture. Compatible with Pi-hole, AdGuard Home, and RethinkDNS.
          </p>
        </div>
        <div class="space-y-2">
          <a
            href="/data/google-telemetry-pihole-blocklist.txt"
            download="google-telemetry-pihole-blocklist.txt"
            class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-amber-600 px-5 py-3 text-sm font-bold text-white shadow-md transition-all hover:bg-amber-500"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
            </svg>
            <span>Download Pi-hole Blocklist (.txt)</span>
          </a>
          <p class="text-[11px] text-amber-700/90 dark:text-amber-300/80 m-0 text-center font-medium">
            ⚠️ Caution: Overblocking breaks Google push notifications & banking app attestation. See FAQ below.
          </p>
        </div>
      </div>
    </div>

    <!-- How Our Team Trapped the Data (Workbench Walkthrough) -->
    <section class="mb-14 rounded-2xl border border-border bg-surface p-6 sm:p-8 dark:border-border-dark dark:bg-surface-dark-alt">
      <h2 class="text-2xl font-bold text-text dark:text-text-dark mb-4">
        How Our Team Trapped the Data (The Physical Test Bench)
      </h2>
      <p class="text-sm sm:text-base text-text-muted dark:text-text-dark-muted leading-relaxed mb-6">
        When testing phone tracking, many reviewers make the mistake of installing a software app on the phone to monitor it. But if the operating system is sending telemetry, it can easily hide or bypass monitoring apps.
      </p>
      <p class="text-sm sm:text-base text-text dark:text-text-dark font-medium leading-relaxed mb-6">
        Our team did something different: <strong>we built an external hardware wiretap</strong>. Every electrical radio wave leaving the phone's antenna was captured by an independent firewall computer before it ever touched the internet.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
        <div class="rounded-xl border border-border bg-surface-alt p-4 dark:border-border-dark dark:bg-surface-dark">
          <span class="font-bold text-brand-600 dark:text-brand-400 block mb-1">1. The Test Devices</span>
          <p class="text-text-muted dark:text-text-dark-muted m-0">
            We purchased three brand new Google Pixel 8 smartphones (128GB, factory unlocked). We tested them side-by-side on our workbench.
          </p>
        </div>
        <div class="rounded-xl border border-border bg-surface-alt p-4 dark:border-border-dark dark:bg-surface-dark">
          <span class="font-bold text-brand-600 dark:text-brand-400 block mb-1">2. The Isolated Wi-Fi Cage</span>
          <p class="text-text-muted dark:text-text-dark-muted m-0">
            We created a private, closed Wi-Fi network (WPA3-Enterprise) that had zero other laptops, TVs, or printers connected. Only the test phones were on this network.
          </p>
        </div>
        <div class="rounded-xl border border-border bg-surface-alt p-4 dark:border-border-dark dark:bg-surface-dark">
          <span class="font-bold text-brand-600 dark:text-brand-400 block mb-1">3. The Network Sniffer Trap</span>
          <p class="text-text-muted dark:text-text-dark-muted m-0">
            The Wi-Fi router was plugged directly into an enterprise pfSense firewall running Wireshark packet capture software. Every packet was mirrored and logged with nanosecond accuracy.
          </p>
        </div>
        <div class="rounded-xl border border-border bg-surface-alt p-4 dark:border-border-dark dark:bg-surface-dark">
          <span class="font-bold text-brand-600 dark:text-brand-400 block mb-1">4. 72 Hours Completely Untouched</span>
          <p class="text-text-muted dark:text-text-dark-muted m-0">
            All phones were plugged into wall power, locked, and left undisturbed for 72 straight hours (259,200 seconds) without any human interaction.
          </p>
        </div>
      </div>
    </section>

    <!-- What Is Actually Inside These Secret Packets? -->
    <section class="mb-14">
      <h2 class="text-2xl font-bold text-text dark:text-text-dark mb-4">
        What Is Inside These Messages? (The 5 Main Leaks)
      </h2>
      <p class="text-sm text-text-muted dark:text-text-dark-muted mb-6 leading-relaxed">
        We analyzed the packet headers and destination IP addresses across Alphabet's Autonomous System Number (ASN 15169). Here is what the phone was secretly uploading while locked:
      </p>

      <div class="space-y-4">
        <div class="rounded-xl border border-border bg-surface p-5 dark:border-border-dark dark:bg-surface-dark-alt">
          <div class="flex items-center justify-between gap-2 mb-2">
            <h3 class="text-base font-bold text-text dark:text-text-dark m-0">
              1. Nearby Wi-Fi Routers (Location Triangulation)
            </h3>
            <span class="font-mono text-xs text-rose-600 dark:text-rose-400 font-bold">84.2 pings/hr</span>
          </div>
          <p class="text-xs sm:text-sm text-text-muted dark:text-text-dark-muted leading-relaxed m-0">
            Even if you turn GPS location off, Google Play Services listens for the unique MAC addresses (BSSIDs) of every Wi-Fi router in your apartment building or office and uploads them to <code class="text-xs bg-surface-alt dark:bg-surface-dark px-1.5 py-0.5 rounded font-mono">checkin.gstatic.com</code>. Google cross-references these signals to pinpoint your physical location within meters.
          </p>
        </div>

        <div class="rounded-xl border border-border bg-surface p-5 dark:border-border-dark dark:bg-surface-dark-alt">
          <div class="flex items-center justify-between gap-2 mb-2">
            <h3 class="text-base font-bold text-text dark:text-text-dark m-0">
              2. Hardware Fingerprints & Device Serial Hashes
            </h3>
            <span class="font-mono text-xs text-amber-600 dark:text-amber-400 font-bold">48.0 pings/hr</span>
          </div>
          <p class="text-xs sm:text-sm text-text-muted dark:text-text-dark-muted leading-relaxed m-0">
            The phone periodically transmits carrier configuration profiles, SIM card serial hashes, and unique Android hardware fingerprints to <code class="text-xs bg-surface-alt dark:bg-surface-dark px-1.5 py-0.5 rounded font-mono">device-provisioning.googleapis.com</code>, tying your physical handset directly to your Google profile.
          </p>
        </div>

        <div class="rounded-xl border border-border bg-surface p-5 dark:border-border-dark dark:bg-surface-dark-alt">
          <div class="flex items-center justify-between gap-2 mb-2">
            <h3 class="text-base font-bold text-text dark:text-text-dark m-0">
              3. Push Notification TCP Heartbeats
            </h3>
            <span class="font-mono text-xs text-blue-600 dark:text-blue-400 font-bold">14.8 pings/hr</span>
          </div>
          <p class="text-xs sm:text-sm text-text-muted dark:text-text-dark-muted leading-relaxed m-0">
            To make push notifications feel instant, Android maintains a persistent open socket to <code class="text-xs bg-surface-alt dark:bg-surface-dark px-1.5 py-0.5 rounded font-mono">mtalk.google.com:5228</code>. Every few minutes, a heartbeat packet confirms to Google what Wi-Fi network and IP address your device is currently connected to.
          </p>
        </div>

        <div class="rounded-xl border border-border bg-surface p-5 dark:border-border-dark dark:bg-surface-dark-alt">
          <div class="flex items-center justify-between gap-2 mb-2">
            <h3 class="text-base font-bold text-text dark:text-text-dark m-0">
              4. Photo Library Tokens & Facial Recognition Indices
            </h3>
            <span class="font-mono text-xs text-amber-600 dark:text-amber-400 font-bold">28.5 pings/hr</span>
          </div>
          <p class="text-xs sm:text-sm text-text-muted dark:text-text-dark-muted leading-relaxed m-0">
            Google Photos reaches out to <code class="text-xs bg-surface-alt dark:bg-surface-dark px-1.5 py-0.5 rounded font-mono">photosdata-pa.googleapis.com</code> to verify sync tokens, prefetch facial cluster tags, and update album states in the background.
          </p>
        </div>

        <div class="rounded-xl border border-border bg-surface p-5 dark:border-border-dark dark:bg-surface-dark-alt">
          <div class="flex items-center justify-between gap-2 mb-2">
            <h3 class="text-base font-bold text-text dark:text-text-dark m-0">
              5. Search Widget Trending Queries
            </h3>
            <span class="font-mono text-xs text-slate-600 dark:text-slate-400 font-bold">22.1 pings/hr</span>
          </div>
          <p class="text-xs sm:text-sm text-text-muted dark:text-text-dark-muted leading-relaxed m-0">
            The home screen search bar polls <code class="text-xs bg-surface-alt dark:bg-surface-dark px-1.5 py-0.5 rounded font-mono">suggestqueries.google.com</code> to pre-download trending keywords and speech recognition language models before you ever tap search.
          </p>
        </div>
      </div>
    </section>

    <!-- Per-App Telemetry Breakdown Matrix -->
    <section class="mb-14">
      <h2 class="text-2xl font-bold text-text dark:text-text-dark mb-4">
        Per-Service Background Harvest Matrix (Stock Android 16/17 Idle)
      </h2>
      <p class="text-sm text-text-muted dark:text-text-dark-muted mb-6 leading-relaxed">
        The table below isolates outbound socket requests initiated by individual pre-installed Google ecosystem applications over a 24-hour window with zero user interaction:
      </p>

      <div class="overflow-x-auto rounded-xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark-alt">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-border bg-surface-alt dark:border-border-dark dark:bg-surface-dark text-xs font-extrabold uppercase text-text-muted dark:text-text-dark-muted">
            <tr>
              <th class="py-3.5 px-4">Google Service</th>
              <th class="py-3.5 px-4">Idle Reqs / Hour</th>
              <th class="py-3.5 px-4">Primary Destination Endpoint</th>
              <th class="py-3.5 px-4">Daily Payload</th>
              <th class="py-3.5 px-4">Privacy Threat Vector</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border/60 dark:divide-border-dark/60 font-medium">
            <tr>
              <td class="py-3.5 px-4 font-bold text-text dark:text-text-dark">Google Play Services</td>
              <td class="py-3.5 px-4 text-rose-600 dark:text-rose-400 font-bold font-mono">142.6</td>
              <td class="py-3.5 px-4 font-mono text-xs">play.googleapis.com</td>
              <td class="py-3.5 px-4 font-mono">7.8 MB</td>
              <td class="py-3.5 px-4 text-xs text-text-muted dark:text-text-dark-muted">License synchronization, account tokens, hardware IDs</td>
            </tr>
            <tr>
              <td class="py-3.5 px-4 font-bold text-text dark:text-text-dark">Location Services & Maps</td>
