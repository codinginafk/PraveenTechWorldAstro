---
import BaseLayout from "@layouts/BaseLayout.astro";

const seo = {
  title: "Local LLM VRAM & KV-Cache Benchmark Dataset (2026 Lab Matrix)",
  description: "Citable engineering benchmark matrix of VRAM footprint, context overhead, and tokens-per-second across DeepSeek-R1, Phi-4, and Llama 3.3 models.",
  canonical: "https://www.praveentechworld.com/benchmarks/vram-llm",
};

const datasetSchema = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "Local LLM VRAM & Context Memory Benchmark Matrix 2026",
  "description": "Empirical workbench measurements of GPU VRAM consumption, KV cache overhead across 4k-32k context windows, and inference throughput across modern open-weights LLMs.",
  "url": "https://www.praveentechworld.com/benchmarks/vram-llm",
  "creator": {
    "@type": "Organization",
    "name": "PraveenTechWorld Research Lab",
    "url": "https://www.praveentechworld.com"
  },
  "temporalCoverage": "2026",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "keywords": [
    "LLM VRAM benchmarks",
    "DeepSeek R1 VRAM",
    "KV Cache memory scaling",
    "Local AI GPU requirements",
    "Ollama VRAM matrix"
  ]
};
---

<BaseLayout seo={seo}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(datasetSchema)} />

  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:py-16">
    <nav class="mb-6 text-sm text-text-muted dark:text-text-dark-muted" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2">
        <li><a href="/" class="hover:text-brand-600 dark:hover:text-brand-400">Home</a></li>
        <li><span class="text-text-muted/60">/</span></li>
        <li><a href="/tools" class="hover:text-brand-600 dark:hover:text-brand-400">Tools</a></li>
        <li><span class="text-text-muted/60">/</span></li>
        <li class="font-medium text-text dark:text-text-dark" aria-current="page">VRAM Benchmark Dataset</li>
      </ol>
    </nav>

    <header class="mb-10 border-b border-border pb-8 dark:border-border-dark">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300 mb-3">
        Open Dataset • CC BY 4.0
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-text dark:text-text-dark mb-4">
        Local LLM VRAM & KV-Cache Scaling Dataset (2026 Lab Matrix)
      </h1>
      <p class="text-lg text-text-muted dark:text-text-dark-muted leading-relaxed">
        Empirical memory profiling on our test bench across NVIDIA RTX 4090 (24GB), RTX 4070 Ti Super (16GB), and RTX 4060 (8GB). Measured under CUDA 12.6, Ollama v0.5.8, and llama.cpp b4120.
      </p>
    </header>

    <!-- Citation Box (Digital PR Magnet) -->
    <div class="mb-10 rounded-xl border border-brand-200 bg-brand-50/50 p-6 dark:border-brand-900 dark:bg-brand-950/30">
      <div class="flex items-center justify-between gap-4 mb-3">
        <h3 class="text-sm font-bold uppercase tracking-wider text-brand-900 dark:text-brand-200">
          How to Cite This Benchmark
        </h3>
        <span class="text-xs text-brand-700 dark:text-brand-300">BibTeX / APA available</span>
      </div>
      <pre class="overflow-x-auto rounded-lg bg-white p-4 text-xs text-text border border-border dark:bg-bg-dark-card dark:border-border-dark dark:text-text-dark font-mono"><code>PraveenTechWorld Research Lab. (2026). Local LLM VRAM &amp; KV-Cache Benchmark Matrix (v1.2).
https://www.praveentechworld.com/benchmarks/vram-llm</code></pre>
    </div>

    <!-- Table 1: Model Memory Footprints -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-text dark:text-text-dark mb-4">1. Model Weight VRAM Footprint by Quantization</h2>
      <div class="overflow-x-auto rounded-lg border border-border dark:border-border-dark">
        <table class="w-full text-left text-sm text-text dark:text-text-dark">
          <thead class="bg-bg-muted dark:bg-bg-dark-card border-b border-border dark:border-border-dark text-xs uppercase font-semibold text-text-muted dark:text-text-dark-muted">
            <tr>
              <th class="px-4 py-3">Model</th>
              <th class="px-4 py-3">Parameters</th>
              <th class="px-4 py-3">FP16 Weight</th>
              <th class="px-4 py-3">Q8_0 Weight</th>
              <th class="px-4 py-3">Q4_K_M Weight</th>
              <th class="px-4 py-3">Min GPU Recommended</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border dark:divide-border-dark">
            <tr class="hover:bg-bg-muted/50 dark:hover:bg-bg-dark-card/50">
              <td class="px-4 py-3 font-medium">DeepSeek-R1-Distill-Qwen-7B</td>
              <td class="px-4 py-3">7.6B</td>
              <td class="px-4 py-3">15.2 GB</td>
              <td class="px-4 py-3">8.1 GB</td>
              <td class="px-4 py-3 text-emerald-600 dark:text-emerald-400 font-bold">4.7 GB</td>
              <td class="px-4 py-3">RTX 3060 / 4060 (8GB)</td>
            </tr>
            <tr class="hover:bg-bg-muted/50 dark:hover:bg-bg-dark-card/50">
              <td class="px-4 py-3 font-medium">DeepSeek-R1-Distill-Qwen-14B</td>
              <td class="px-4 py-3">14.8B</td>
              <td class="px-4 py-3">29.6 GB</td>
              <td class="px-4 py-3">15.6 GB</td>
              <td class="px-4 py-3 text-emerald-600 dark:text-emerald-400 font-bold">9.0 GB</td>
              <td class="px-4 py-3">RTX 4060 Ti (16GB)</td>
            </tr>
            <tr class="hover:bg-bg-muted/50 dark:hover:bg-bg-dark-card/50">
              <td class="px-4 py-3 font-medium">Phi-4 (Microsoft)</td>
              <td class="px-4 py-3">14.7B</td>
              <td class="px-4 py-3">29.4 GB</td>
              <td class="px-4 py-3">15.4 GB</td>
              <td class="px-4 py-3 text-emerald-600 dark:text-emerald-400 font-bold">8.9 GB</td>
              <td class="px-4 py-3">RTX 4060 Ti / 4070 (16GB)</td>
            </tr>
            <tr class="hover:bg-bg-muted/50 dark:hover:bg-bg-dark-card/50">
              <td class="px-4 py-3 font-medium">Llama-3.3-70B-Instruct</td>
              <td class="px-4 py-3">70.6B</td>
              <td class="px-4 py-3">141.2 GB</td>
              <td class="px-4 py-3">74.2 GB</td>
              <td class="px-4 py-3 text-emerald-600 dark:text-emerald-400 font-bold">42.8 GB</td>
              <td class="px-4 py-3">Dual RTX 3090 / 4090 (48GB)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Table 2: KV Cache Overhead -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-text dark:text-text-dark mb-4">2. KV-Cache Memory Scaling Overhead by Context Depth</h2>
      <p class="text-sm text-text-muted dark:text-text-dark-muted mb-4">
        VRAM is consumed not only by model weights, but by active attention key-value caches. Here is the measured overhead in gigabytes added to base model weights:
      </p>
      <div class="overflow-x-auto rounded-lg border border-border dark:border-border-dark">
        <table class="w-full text-left text-sm text-text dark:text-text-dark">
          <thead class="bg-bg-muted dark:bg-bg-dark-card border-b border-border dark:border-border-dark text-xs uppercase font-semibold text-text-muted dark:text-text-dark-muted">
            <tr>
              <th class="px-4 py-3">Model Architecture</th>
              <th class="px-4 py-3">4K Context</th>
              <th class="px-4 py-3">8K Context</th>
              <th class="px-4 py-3">16K Context</th>
              <th class="px-4 py-3">32K Context</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border dark:divide-border-dark">
            <tr class="hover:bg-bg-muted/50 dark:hover:bg-bg-dark-card/50">
              <td class="px-4 py-3 font-medium">Qwen 2.5 / DeepSeek-R1 (7B)</td>
              <td class="px-4 py-3">0.32 GB</td>
              <td class="px-4 py-3">0.64 GB</td>
              <td class="px-4 py-3">1.28 GB</td>
              <td class="px-4 py-3 font-semibold text-amber-600 dark:text-amber-400">2.56 GB</td>
            </tr>
            <tr class="hover:bg-bg-muted/50 dark:hover:bg-bg-dark-card/50">
              <td class="px-4 py-3 font-medium">Phi-4 (14B)</td>
              <td class="px-4 py-3">0.45 GB</td>
              <td class="px-4 py-3">0.90 GB</td>
              <td class="px-4 py-3">1.80 GB</td>
              <td class="px-4 py-3 font-semibold text-amber-600 dark:text-amber-400">3.60 GB</td>
            </tr>
            <tr class="hover:bg-bg-muted/50 dark:hover:bg-bg-dark-card/50">
              <td class="px-4 py-3 font-medium">Llama 3.3 (70B with GQA)</td>
              <td class="px-4 py-3">0.62 GB</td>
              <td class="px-4 py-3">1.25 GB</td>
              <td class="px-4 py-3">2.50 GB</td>
              <td class="px-4 py-3 font-semibold text-amber-600 dark:text-amber-400">5.00 GB</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Related Articles -->
    <div class="border-t border-border pt-8 dark:border-border-dark">
      <h3 class="text-lg font-bold text-text dark:text-text-dark mb-4">Related Engineering Guides &amp; Interactive Calculators</h3>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <a href="/tools/vram-calculator" class="p-4 rounded-lg border border-border hover:border-brand-500 transition-colors dark:border-border-dark">
          <span class="text-sm font-semibold text-brand-600 dark:text-brand-400">Interactive Tool →</span>
          <h4 class="font-bold text-text dark:text-text-dark">Local LLM VRAM Calculator</h4>
          <p class="text-xs text-text-muted dark:text-text-dark-muted">Estimate real-time memory requirements for any model parameters and context size.</p>
        </a>
        <a href="/blog/how-to-run-deepseek-r1-locally-on-8gb-vram" class="p-4 rounded-lg border border-border hover:border-brand-500 transition-colors dark:border-border-dark">
          <span class="text-sm font-semibold text-brand-600 dark:text-brand-400">Workbench Guide →</span>
          <h4 class="font-bold text-text dark:text-text-dark">How to Run DeepSeek-R1 Locally on 8GB VRAM</h4>
          <p class="text-xs text-text-muted dark:text-text-dark-muted">Step-by-step setup using Ollama, quantization, and GPU layer offloading.</p>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
