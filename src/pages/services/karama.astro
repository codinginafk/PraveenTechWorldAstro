---
import BaseLayout from "@layouts/BaseLayout.astro";

const seo = {
  title: "Google Ads & Tech Services in Al Karama, Dubai — Praveen",
  description: "I help businesses in Al Karama, Dubai get more customers with Google/Meta Ads, local Search Console optimization, and fast web apps. Direct 1-on-1 access.",
  canonical: "https://www.praveentechworld.com/services/karama",
};

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Praveen Kumar Mishra",
  "url": "https://www.praveentechworld.com",
  "jobTitle": "Freelance Growth & Tech Consultant",
  "email": "contact@praveentechworld.com",
  "knowsAbout": [
    "Google Ads Management Karama",
    "Meta Ads Al Karama",
    "Local SEO Dubai",
    "GA4 Analytics"
  ],
  "areaServed": [
    { "@type": "AdministrativeArea", "name": "Al Karama, Dubai" }
  ]
};
---

<BaseLayout seo={seo}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />

  <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8 space-y-12">
    <!-- Header -->
    <div class="space-y-4">
      <div class="inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-50 dark:bg-brand-500/10 px-3 py-1 text-xs font-bold text-brand-700 dark:text-brand-300">
        📍 Location: Al Karama, Dubai
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-text dark:text-text-dark sm:text-4xl">
        IT Consultant & Google Ads Specialist in Al Karama, Dubai
      </h1>
      <p class="text-base text-text-muted dark:text-text-dark-muted leading-relaxed">
        Looking for a dedicated <strong class="text-text dark:text-text-dark">IT consultant in Al Karama</strong> or a Google Ads specialist? Hi, I'm <strong class="text-text dark:text-text-dark">Praveen</strong>. I work directly with retail stores, restaurants, electronics shops, and commercial services in Al Karama to build targeted ad campaigns, optimize Google Maps visibility, and drive direct WhatsApp sales inquiries.
      </p>
    </div>

    <!-- What I Do for Karama Businesses -->
    <div class="space-y-6">
      <h2 class="text-2xl font-bold text-text dark:text-text-dark">
        How I Help Karama Business Owners
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="rounded-xl border border-border dark:border-border-dark p-6 bg-surface dark:bg-surface-dark space-y-2">
          <h3 class="font-bold text-text dark:text-text-dark">🎯 Targeted Google & Meta Ads</h3>
          <p class="text-sm text-text-muted dark:text-text-dark-muted leading-relaxed">
            I write custom ad copy, set up conversion tracking, and target customers living or working in Al Karama to maximize your ad spend.
          </p>
        </div>

        <div class="rounded-xl border border-border dark:border-border-dark p-6 bg-surface dark:bg-surface-dark space-y-2">
          <h3 class="font-bold text-text dark:text-text-dark">⚡ Fast Web Apps & Landing Pages</h3>
          <p class="text-sm text-text-muted dark:text-text-dark-muted leading-relaxed">
            I build mobile-first web landing pages designed specifically for WhatsApp lead capture so customers in Karama can reach you instantly.
          </p>
        </div>
      </div>
    </div>

    <!-- Local Advantage -->
    <div class="rounded-2xl border border-border dark:border-border-dark bg-surface-subtle dark:bg-surface-dark-subtle p-8 space-y-4">
      <h3 class="text-xl font-bold text-text dark:text-text-dark">
        Why Work With Me Directly?
      </h3>
      <p class="text-sm text-text-muted dark:text-text-dark-muted leading-relaxed">
        I understand the high-competition retail environment in Karama. Instead of waiting days for an agency account manager to reply to an email, you text or call me directly. I move fast, optimize your campaigns daily, and focus entirely on your revenue.
      </p>
      
      <div class="pt-4 flex flex-wrap gap-4">
        <a
          href="https://wa.me/971562980106?text=Hi%20Praveen,%20I'm%20in%20Karama%20and%20need%20help%20with%20my%20business"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl bg-brand-600 px-6 py-3 text-sm font-bold text-white hover:bg-brand-700 transition-all"
        >
          💬 Chat on WhatsApp
        </a>
        <a
          href="mailto:contact@praveentechworld.com?subject=Karama%20Services%20Inquiry"
          class="inline-flex items-center gap-2 rounded-xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark px-6 py-3 text-sm font-bold text-text dark:text-text-dark hover:border-brand-600 transition-all"
        >
          ✉️ Send Email
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
