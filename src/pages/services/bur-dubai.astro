---
import BaseLayout from "@layouts/BaseLayout.astro";

const seo = {
  title: "E-Commerce Catalog Sync & Ads in Bur Dubai — Praveen",
  description: "I help retailers and traders in Bur Dubai sync their inventory across Noon, Amazon UAE, and Carrefour, plus manage high-ROI Google/Meta Ads.",
  canonical: "https://www.praveentechworld.com/services/bur-dubai",
};

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Praveen Kumar Mishra",
  "url": "https://www.praveentechworld.com",
  "jobTitle": "Freelance Growth & Tech Consultant",
  "email": "contact@praveentechworld.com",
  "knowsAbout": [
    "Noon Marketplace Sync",
    "Amazon UAE Catalog Sync",
    "Bur Dubai Performance Marketing",
    "E-Commerce Automation"
  ],
  "areaServed": [
    { "@type": "AdministrativeArea", "name": "Bur Dubai, Dubai" }
  ]
};
---

<BaseLayout seo={seo}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />

  <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8 space-y-12">
    <!-- Header -->
    <div class="space-y-4">
      <div class="inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-50 dark:bg-brand-500/10 px-3 py-1 text-xs font-bold text-brand-700 dark:text-brand-300">
        📍 Location: Bur Dubai, Dubai
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-text dark:text-text-dark sm:text-4xl">
        E-Commerce Catalog Sync & Tech Services in Bur Dubai
      </h1>
      <p class="text-base text-text-muted dark:text-text-dark-muted leading-relaxed">
        Hi, I'm <strong class="text-text dark:text-text-dark">Praveen</strong>. I help traders, textile wholesalers, and retailers in Bur Dubai automate their e-commerce inventory sync across regional marketplaces like Noon, Amazon UAE, and Carrefour so you never suffer overselling or price errors.
      </p>
    </div>

    <!-- Core Services for Bur Dubai -->
    <div class="space-y-6">
      <h2 class="text-2xl font-bold text-text dark:text-text-dark">
        Services I Offer Bur Dubai Businesses
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="rounded-xl border border-border dark:border-border-dark p-6 bg-surface dark:bg-surface-dark space-y-2">
          <h3 class="font-bold text-text dark:text-text-dark">🛒 Live Marketplace Catalog Sync</h3>
          <p class="text-sm text-text-muted dark:text-text-dark-muted leading-relaxed">
            I write Python sync tools and configure Shopify/Magento connections to keep your price and stock levels synchronized across Noon, Amazon UAE, and Carrefour automatically.
          </p>
        </div>

        <div class="rounded-xl border border-border dark:border-border-dark p-6 bg-surface dark:bg-surface-dark space-y-2">
          <h3 class="font-bold text-text dark:text-text-dark">📊 B2B & Retail Performance Ads</h3>
          <p class="text-sm text-text-muted dark:text-text-dark-muted leading-relaxed">
            I manage targeted Google Search & Meta ad campaigns for Bur Dubai businesses to attract wholesale buyers and local shoppers straight to your business.
          </p>
        </div>
      </div>
    </div>

    <!-- Direct Contact CTA -->
    <div class="rounded-2xl border border-border dark:border-border-dark bg-surface-subtle dark:bg-surface-dark-subtle p-8 text-center space-y-4">
      <h3 class="text-xl font-bold text-text dark:text-text-dark">
        Let's Discuss Your Bur Dubai Business Needs
      </h3>
      <p class="text-sm text-text-muted dark:text-text-dark-muted max-w-xl mx-auto leading-relaxed">
        I offer a highest discount or 100% free initial test audit on your first project so you can evaluate my speed and technical execution first.
      </p>
      
      <div class="pt-2">
        <a
          href="https://wa.me/971500000000?text=Hi%20Praveen,%20I'm%20in%20Bur%20Dubai%20and%20need%20help%20with%20my%20store"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl bg-brand-600 px-6 py-3 text-sm font-bold text-white hover:bg-brand-700 transition-all"
        >
          💬 Chat with Praveen on WhatsApp
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
