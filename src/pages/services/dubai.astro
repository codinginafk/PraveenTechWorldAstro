---
import BaseLayout from "@layouts/BaseLayout.astro";

const seo = {
  title: "Freelance Tech & Growth Services Dubai — Praveen",
  description: "I provide freelance digital marketing, Google/Meta Ads management, e-commerce catalog sync, and custom Python automation for Dubai businesses.",
  canonical: "https://www.praveentechworld.com/services/dubai",
};

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Praveen Kumar Mishra",
  "url": "https://www.praveentechworld.com",
  "jobTitle": "Freelance Growth & Tech Consultant",
  "email": "contact@praveentechworld.com",
  "knowsAbout": [
    "Digital Marketing Dubai",
    "Google Ads Dubai",
    "E-Commerce Catalog Sync",
    "Technical SEO Dubai"
  ],
  "areaServed": [
    { "@type": "City", "name": "Dubai" }
  ]
};
---

<BaseLayout seo={seo}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />

  <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8 space-y-12">
    <!-- Header -->
    <div class="space-y-4 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-50 dark:bg-brand-500/10 px-3 py-1 text-xs font-bold text-brand-700 dark:text-brand-300">
        🇦🇪 Serving Dubai, UAE
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-text dark:text-text-dark sm:text-5xl">
        Freelance Tech & Growth Specialist in Dubai
      </h1>
      <p class="text-base text-text-muted dark:text-text-dark-muted max-w-2xl mx-auto leading-relaxed">
        Hi, I'm <strong class="text-text dark:text-text-dark">Praveen</strong>. I help companies in Dubai cut through agency overhead by providing direct 1-on-1 growth engineering, performance ad management, and e-commerce tech execution.
      </p>
      <div class="pt-4 flex justify-center gap-4 flex-wrap">
        <a
          href="https://wa.me/971562980106?text=Hi%20Praveen,%20I'd%20like%20to%20discuss%20a%20project%20in%20Dubai"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl bg-brand-600 px-6 py-3.5 text-sm font-bold text-white shadow-lg hover:bg-brand-700 transition-all"
        >
          💬 Chat on WhatsApp
        </a>
        <a
          href="mailto:contact@praveentechworld.com?subject=Dubai%20Growth%20Services%20Inquiry"
          class="inline-flex items-center gap-2 rounded-xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark px-6 py-3.5 text-sm font-bold text-text dark:text-text-dark hover:border-brand-600 transition-all"
        >
          ✉️ Send Email
        </a>
      </div>
    </div>

    <!-- Location Hub Links -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <a href="/services/karama" class="rounded-xl border border-border dark:border-border-dark p-6 bg-surface dark:bg-surface-dark hover:border-brand-600 transition-all space-y-2 block">
        <h3 class="font-bold text-text dark:text-text-dark">📍 Services in Al Karama →</h3>
        <p class="text-xs text-text-muted dark:text-text-dark-muted">Retail ads, local lead gen, and Google Maps optimization for Karama businesses.</p>
      </a>

      <a href="/services/bur-dubai" class="rounded-xl border border-border dark:border-border-dark p-6 bg-surface dark:bg-surface-dark hover:border-brand-600 transition-all space-y-2 block">
        <h3 class="font-bold text-text dark:text-text-dark">📍 Services in Bur Dubai →</h3>
        <p class="text-xs text-text-muted dark:text-text-dark-muted">Noon/Amazon inventory sync, trading ads, and e-commerce tech for Bur Dubai traders.</p>
      </a>
    </div>
  </div>
</BaseLayout>
