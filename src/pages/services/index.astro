---
import BaseLayout from "@layouts/BaseLayout.astro";

const seo = {
  title: "Web Administrator & Server Infrastructure Services in Dubai — Praveen",
  description: "Web Administrator administering 30+ Web & Application Servers. Hands-on Domain, DNS, Cloudflare, SSL, MySQL/PostgreSQL, 24/7 Uptime Monitoring, and Technical SEO in Dubai.",
  canonical: "https://www.praveentechworld.com/services",
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Praveen Kumar Mishra",
  "url": "https://www.praveentechworld.com",
  "jobTitle": "Web Administrator & Cloud Infrastructure Engineer",
  "email": "contact@praveentechworld.com",
  "knowsAbout": [
    "Web Server Administration (30+ Live Application Servers)",
    "Domain, DNS & Cloudflare CDN Management",
    "SSL Certificate Automation & Hardening",
    "24/7 Outage & Uptime SLA Monitoring",
    "MySQL & PostgreSQL Database Maintenance",
    "Docker Containerization & Cloud Hosting",
    "Technical SEO & 301 Redirect Architecture",
    "Google Ads & Performance Marketing"
  ],
  "areaServed": [
    { "@type": "AdministrativeArea", "name": "Al Karama, Dubai" },
    { "@type": "AdministrativeArea", "name": "Bur Dubai, Dubai" },
    { "@type": "City", "name": "Dubai" },
    { "@type": "Country", "name": "United Arab Emirates" }
  ]
};
---

<BaseLayout seo={seo}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />

  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-24">
    <!-- Hero Section -->
    <div class="text-center space-y-6">
      <div class="inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-50 dark:bg-brand-500/10 px-4 py-2 text-xs font-bold text-brand-700 dark:text-brand-300">
        📍 Web Administrator & Cloud Operations • Dubai, UAE
      </div>
      
      <h1 class="text-4xl font-extrabold tracking-tight text-text dark:text-text-dark sm:text-5xl lg:text-6xl">
        Web & Server Administration <br />
        <span class="text-brand-600 dark:text-brand-400">30+ Live Application Servers Under Care</span>
      </h1>
      
      <p class="mx-auto max-w-3xl text-lg text-text-muted dark:text-text-dark-muted leading-relaxed">
        Hi, I'm <strong class="text-text dark:text-text-dark">Praveen Kumar Mishra</strong>. I administer 30+ web and application servers across cloud infrastructure, handling end-to-end DNS, SSL certificates, Cloudflare CDN/WAF security, database management (MySQL/PostgreSQL), 24/7 uptime monitoring, technical SEO, and 301 redirect architecture. You work 1-on-1 directly with me — zero agency bloat, real on-call experience, and immediate accountability.
      </p>

      <div class="flex flex-wrap justify-center gap-4 pt-4">
        <a
          href="https://wa.me/971562980106?text=Hi%20Praveen,%20I'd%20like%20to%20discuss%20web%20server%20and%20tech%20administration"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl bg-brand-600 px-6 py-3.5 text-sm font-bold text-white shadow-lg hover:bg-brand-700 transition-all hover:shadow-brand-600/20 active:scale-[0.98]"
        >
          💬 Chat on WhatsApp (+971 56 298 0106)
        </a>
        <a
          href="mailto:contact@praveentechworld.com?subject=Web%20Administration%20Inquiry"
          class="inline-flex items-center gap-2 rounded-xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark px-6 py-3.5 text-sm font-bold text-text dark:text-text-dark hover:border-brand-600 transition-all"
        >
          ✉️ Direct Email Inquiry
        </a>
        <a
          href="/portfolio"
          class="inline-flex items-center gap-2 rounded-xl border border-brand-500/40 bg-brand-50/50 dark:bg-brand-900/20 px-6 py-3.5 text-sm font-bold text-brand-700 dark:text-brand-300 hover:border-brand-500 transition-all"
        >
          📂 View Live Portfolio →
        </a>
      </div>
    </div>

    <!-- Core Metrics Banner -->
    <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-6 text-center border-y border-border dark:border-border-dark py-8">
      <div>
        <div class="text-3xl font-extrabold text-brand-600 dark:text-brand-400">30+</div>
        <div class="text-xs text-text-muted dark:text-text-dark-muted mt-1">Servers Administered</div>
      </div>
      <div>
        <div class="text-3xl font-extrabold text-emerald-600 dark:text-emerald-400">99.9%</div>
        <div class="text-xs text-text-muted dark:text-text-dark-muted mt-1">Uptime SLA Target</div>
      </div>
      <div>
        <div class="text-3xl font-extrabold text-purple-600 dark:text-purple-400">24/7</div>
        <div class="text-xs text-text-muted dark:text-text-dark-muted mt-1">On-Call Incident Response</div>
      </div>
      <div>
        <div class="text-3xl font-extrabold text-amber-600 dark:text-amber-400">100%</div>
        <div class="text-xs text-text-muted dark:text-text-dark-muted mt-1">Direct 1-on-1 Work</div>
      </div>
    </div>

    <!-- Specialized Services Grid -->
    <div class="mt-20">
      <h2 class="text-3xl font-extrabold text-text dark:text-text-dark text-center mb-4">
        Technical Administration & Infrastructure Capabilities
      </h2>
      <p class="text-center text-text-muted dark:text-text-dark-muted max-w-2xl mx-auto mb-12 text-sm">
        Production-tested web operations, system administration, security hardening, and performance engineering tailored for UAE businesses:
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Service 1: Web & Application Server Admin -->
        <div class="rounded-2xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark p-8 hover:border-brand-600 transition-all shadow-sm">
          <div class="text-3xl mb-4">🖥️</div>
          <h3 class="text-xl font-bold text-text dark:text-text-dark mb-2">Web & Application Server Administration</h3>
          <p class="text-sm text-text-muted dark:text-text-dark-muted leading-relaxed mb-4">
            Hands-on administration of 30+ Linux (Ubuntu/Debian) and Windows servers. Configuring Nginx, Apache, Node.js, and IIS application environments for speed and reliability.
          </p>
          <ul class="space-y-1.5 text-xs text-text-muted dark:text-text-dark-muted border-t border-border dark:border-border-dark pt-4">
            <li class="flex items-center gap-2"><span class="text-brand-600">✓</span> 2+ Years Direct Sysadmin Experience</li>
            <li class="flex items-center gap-2"><span class="text-brand-600">✓</span> Real On-Call / After-Hours Outage Triage</li>
            <li class="flex items-center gap-2"><span class="text-brand-600">✓</span> Server Resource & CPU Load Tuning</li>
          </ul>
        </div>

        <!-- Service 2: Domain, DNS, SSL & Cloudflare WAF -->
        <div class="rounded-2xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark p-8 hover:border-brand-600 transition-all shadow-sm">
          <div class="text-3xl mb-4">🌐</div>
          <h3 class="text-xl font-bold text-text dark:text-text-dark mb-2">Domain, DNS & Cloudflare CDN Security</h3>
          <p class="text-sm text-text-muted dark:text-text-dark-muted leading-relaxed mb-4">
            Complete management of domain records, DNS propagation, Cloudflare WAF firewall rules, page rules, edge caching, and Let's Encrypt automated SSL certificate renewals.
          </p>
          <ul class="space-y-1.5 text-xs text-text-muted dark:text-text-dark-muted border-t border-border dark:border-border-dark pt-4">
            <li class="flex items-center gap-2"><span class="text-brand-600">✓</span> Cloudflare Rules & DDoS Protection</li>
            <li class="flex items-center gap-2"><span class="text-brand-600">✓</span> Automated SSL/TLS Certificate Setup</li>
            <li class="flex items-center gap-2"><span class="text-brand-600">✓</span> DNS Record Audits (A, CNAME, MX, TXT)</li>
          </ul>
        </div>

        <!-- Service 3: Database & Uptime SLA Monitoring -->
        <div class="rounded-2xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark p-8 hover:border-brand-600 transition-all shadow-sm">
          <div class="text-3xl mb-4">🗄️</div>
          <h3 class="text-xl font-bold text-text dark:text-text-dark mb-2">Database Maintenance & Uptime SLA Tracking</h3>
          <p class="text-sm text-text-muted dark:text-text-dark-muted leading-relaxed mb-4">
            Comfortable with MySQL, PostgreSQL, and SQLite database administration. Routine database backups, query troubleshooting, and 24/7 uptime monitoring tools integration.
          </p>
          <ul class="space-y-1.5 text-xs text-text-muted dark:text-text-dark-muted border-t border-border dark:border-border-dark pt-4">
            <li class="flex items-center gap-2"><span class="text-brand-600">✓</span> MySQL / PostgreSQL Database Backups</li>
            <li class="flex items-center gap-2"><span class="text-brand-600">✓</span> Automated Status & Uptime Monitoring</li>
            <li class="flex items-center gap-2"><span class="text-brand-600">✓</span> Rapid Disaster Recovery Protocols</li>
          </ul>
        </div>

        <!-- Service 4: Technical SEO & 301 Redirect Architecture -->
        <div class="rounded-2xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark p-8 hover:border-brand-600 transition-all shadow-sm">
          <div class="text-3xl mb-4">📈</div>
          <h3 class="text-xl font-bold text-text dark:text-text-dark mb-2">Technical SEO & 301 Redirect Architecture</h3>
          <p class="text-sm text-text-muted dark:text-text-dark-muted leading-relaxed mb-4">
            Fixing broken links, resolving 404/308 redirect loops with clean 301 redirects, sitemap configuration, Google Search Console indexing API setups, and Core Web Vitals optimization.
          </p>
          <ul class="space-y-1.5 text-xs text-text-muted dark:text-text-dark-muted border-t border-border dark:border-border-dark pt-4">
            <li class="flex items-center gap-2"><span class="text-brand-600">✓</span> 301 Redirect Loop Cleanups</li>
            <li class="flex items-center gap-2"><span class="text-brand-600">✓</span> GSC Indexing & Sitemap Audits</li>
            <li class="flex items-center gap-2"><span class="text-brand-600">✓</span> Core Web Vitals LCP/CLS Fixes</li>
          </ul>
        </div>

        <!-- Service 5: Docker & Cloud Deployments -->
        <div class="rounded-2xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark p-8 hover:border-brand-600 transition-all shadow-sm">
          <div class="text-3xl mb-4">🐳</div>
          <h3 class="text-xl font-bold text-text dark:text-text-dark mb-2">Docker Containerization & Cloud Hosting</h3>
          <p class="text-sm text-text-muted dark:text-text-dark-muted leading-relaxed mb-4">
            Containerizing applications using Docker, managing Vercel / DigitalOcean / GCP deployments, script automation (Bash & PowerShell), and CMS maintenance (Astro, WordPress, Magento).
          </p>
          <ul class="space-y-1.5 text-xs text-text-muted dark:text-text-dark-muted border-t border-border dark:border-border-dark pt-4">
            <li class="flex items-center gap-2"><span class="text-brand-600">✓</span> Docker Compose & Container Volumes</li>
            <li class="flex items-center gap-2"><span class="text-brand-600">✓</span> Vercel / AWS / DigitalOcean Hosting</li>
            <li class="flex items-center gap-2"><span class="text-brand-600">✓</span> Bash & PowerShell System Automation</li>
          </ul>
        </div>

        <!-- Service 6: Performance Marketing & Google/Meta Ads -->
        <div class="rounded-2xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark p-8 hover:border-brand-600 transition-all shadow-sm">
          <div class="text-3xl mb-4">🎯</div>
          <h3 class="text-xl font-bold text-text dark:text-text-dark mb-2">Google & Meta Ads Performance Marketing</h3>
          <p class="text-sm text-text-muted dark:text-text-dark-muted leading-relaxed mb-4">
            Combining technical web administration with paid performance marketing. Google Search & Meta ad campaign setup, GA4 event tracking, and local Dubai customer acquisition.
          </p>
          <ul class="space-y-1.5 text-xs text-text-muted dark:text-text-dark-muted border-t border-border dark:border-border-dark pt-4">
            <li class="flex items-center gap-2"><span class="text-brand-600">✓</span> High-ROI Google & Meta Campaign Setup</li>
            <li class="flex items-center gap-2"><span class="text-brand-600">✓</span> GA4 Custom Conversion Event Tracking</li>
            <li class="flex items-center gap-2"><span class="text-brand-600">✓</span> Local Dubai Business Lead Generation</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Targeted Dubai Neighborhood Hubs -->
    <div class="mt-20 bg-surface-alt/30 dark:bg-surface-dark-alt/20 rounded-3xl p-8 border border-border dark:border-border-dark">
      <h2 class="text-2xl font-bold text-text dark:text-text-dark text-center mb-6">
        Local UAE Neighborhood Services
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="/services/karama" class="block rounded-xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark p-5 hover:border-brand-600 transition-all text-center">
          <div class="text-2xl mb-1">🏬</div>
          <div class="font-bold text-text dark:text-text-dark">Al Karama Tech Hub</div>
          <div class="text-xs text-text-muted dark:text-text-dark-muted mt-1">Retail store IT, local ads, and server admin</div>
        </a>
        <a href="/services/bur-dubai" class="block rounded-xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark p-5 hover:border-brand-600 transition-all text-center">
          <div class="text-2xl mb-1">📦</div>
          <div class="font-bold text-text dark:text-text-dark">Bur Dubai Commerce</div>
          <div class="text-xs text-text-muted dark:text-text-dark-muted mt-1">Trading firm web ops, hosting & catalog sync</div>
        </a>
        <a href="/services/dubai" class="block rounded-xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark p-5 hover:border-brand-600 transition-all text-center">
          <div class="text-2xl mb-1">🏙️</div>
          <div class="font-bold text-text dark:text-text-dark">Dubai Master Services</div>
          <div class="text-xs text-text-muted dark:text-text-dark-muted mt-1">Enterprise web administration across Dubai</div>
        </a>
      </div>
    </div>

    <!-- CTA Section -->
    <div class="mt-20 text-center rounded-3xl border border-brand-500/30 bg-brand-50/50 dark:bg-brand-900/10 p-10 space-y-6">
      <h2 class="text-3xl font-extrabold text-text dark:text-text-dark">
        Need Reliable Web & Server Administration for Your Site?
      </h2>
      <p class="text-text-muted dark:text-text-dark-muted max-w-xl mx-auto text-sm leading-relaxed">
        Whether you are suffering from site outages, broken SSL certificates, slow database queries, or need 24/7 uptime management for your application servers, let's connect directly.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="https://wa.me/971562980106?text=Hi%20Praveen,%20I'd%20like%20to%20discuss%20web%20administration"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl bg-brand-600 px-6 py-3.5 text-sm font-bold text-white shadow-lg hover:bg-brand-700 transition-all"
        >
          💬 Chat Directly on WhatsApp
        </a>
        <a
          href="mailto:contact@praveentechworld.com"
          class="inline-flex items-center gap-2 rounded-xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark px-6 py-3.5 text-sm font-bold text-text dark:text-text-dark hover:border-brand-600 transition-all"
        >
          ✉️ Send Email
        </a>
      </div>
    </div>

  </div>
</BaseLayout>
