---
import BaseLayout from "@layouts/BaseLayout.astro";

const seo = {
  title: "Freelance Growth Engineering & Tech Services in Dubai — Praveen",
  description: "Hi, I'm Praveen. I help businesses in Dubai, Karama, and Bur Dubai directly with Google/Meta Ads, E-Commerce Catalog Sync, AI Automation & Technical SEO.",
  canonical: "https://www.praveentechworld.com/services",
};

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Praveen Kumar Mishra",
  "url": "https://www.praveentechworld.com",
  "jobTitle": "Freelance Growth & Tech Consultant",
  "email": "contact@praveentechworld.com",
  "knowsAbout": [
    "Google Ads Management",
    "Meta Ads Management",
    "E-Commerce Catalog Sync",
    "AI Automation Scripts",
    "Technical SEO",
    "GA4 Analytics"
  ],
  "areaServed": [
    { "@type": "AdministrativeArea", "name": "Al Karama, Dubai" },
    { "@type": "AdministrativeArea", "name": "Bur Dubai, Dubai" },
    { "@type": "City", "name": "Dubai" }
  ]
};
---

<BaseLayout seo={seo}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />

  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8">
    <!-- Hero Section -->
    <div class="text-center space-y-6">
      <div class="inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-50 dark:bg-brand-500/10 px-4 py-2 text-xs font-bold text-brand-700 dark:text-brand-300">
        📍 Serving Al Karama, Bur Dubai & Dubai (General)
      </div>
      
      <h1 class="text-4xl font-extrabold tracking-tight text-text dark:text-text-dark sm:text-5xl">
        Growth Engineering & Tech Services <br />
        <span class="text-brand-600 dark:text-brand-400">Done Personally By Praveen</span>
      </h1>
      
      <p class="mx-auto max-w-2xl text-lg text-text-muted dark:text-text-dark-muted leading-relaxed">
        Hi, I'm <strong class="text-text dark:text-text-dark">Praveen</strong>. I help businesses in Dubai, Karama, and Bur Dubai grow through high-ROI Google/Meta Ads, e-commerce inventory sync, and AI automation. You work 1-on-1 directly with me — no account managers, no junior staff, and no agency overhead.
      </p>

      <div class="flex flex-wrap justify-center gap-4 pt-4">
        <a
          href="https://wa.me/971500000000?text=Hi%20Praveen,%20I'd%20like%20to%20discuss%20a%20project"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl bg-brand-600 px-6 py-3.5 text-sm font-bold text-white shadow-lg hover:bg-brand-700 transition-all"
        >
          💬 Chat on WhatsApp
        </a>
        <a
          href="mailto:contact@praveentechworld.com?subject=Inquiry%20from%20Services%20Page"
          class="inline-flex items-center gap-2 rounded-xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark px-6 py-3.5 text-sm font-bold text-text dark:text-text-dark hover:border-brand-600 transition-all"
        >
          ✉️ Send Email
        </a>
      </div>
    </div>

    <!-- Core Locations Grid -->
    <div class="mt-20">
      <h2 class="text-2xl font-bold text-text dark:text-text-dark text-center mb-8">
        Target Neighborhood Services
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Karama Card -->
        <a href="/services/karama" class="group rounded-2xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark p-8 hover:border-brand-600 transition-all shadow-sm">
          <div class="flex items-center justify-between mb-4">
            <span class="text-3xl">🏬</span>
            <span class="text-xs font-bold text-brand-600 dark:text-brand-400 bg-brand-50 dark:bg-brand-500/10 px-3 py-1 rounded-full">Al Karama</span>
          </div>
          <h3 class="text-xl font-bold text-text dark:text-text-dark group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
            Services in Al Karama
          </h3>
          <p class="mt-2 text-sm text-text-muted dark:text-text-dark-muted leading-relaxed">
            Local store lead generation, Google Maps optimization, and performance ads for Karama retail, dining, and commercial businesses.
          </p>
          <div class="mt-4 text-xs font-bold text-brand-600 dark:text-brand-400 flex items-center gap-1">
            Explore Karama Services →
          </div>
        </a>

        <!-- Bur Dubai Card -->
        <a href="/services/bur-dubai" class="group rounded-2xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark p-8 hover:border-brand-600 transition-all shadow-sm">
          <div class="flex items-center justify-between mb-4">
            <span class="text-3xl">📦</span>
            <span class="text-xs font-bold text-brand-600 dark:text-brand-400 bg-brand-50 dark:bg-brand-500/10 px-3 py-1 rounded-full">Bur Dubai</span>
          </div>
          <h3 class="text-xl font-bold text-text dark:text-text-dark group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
            Services in Bur Dubai
          </h3>
          <p class="mt-2 text-sm text-text-muted dark:text-text-dark-muted leading-relaxed">
            E-commerce catalog synchronization for Noon, Amazon UAE, and Carrefour, plus B2B/B2C growth marketing for Bur Dubai traders.
          </p>
          <div class="mt-4 text-xs font-bold text-brand-600 dark:text-brand-400 flex items-center gap-1">
            Explore Bur Dubai Services →
          </div>
        </a>
      </div>
    </div>

    <!-- Direct Value Proposition -->
    <div class="mt-20 rounded-2xl border border-border dark:border-border-dark bg-surface-subtle dark:bg-surface-dark-subtle p-8 text-center space-y-4">
      <h3 class="text-xl font-bold text-text dark:text-text-dark">
        Why Work Directly With Me Instead of an Agency?
      </h3>
      <p class="text-sm text-text-muted dark:text-text-dark-muted max-w-2xl mx-auto leading-relaxed">
        Agencies pass your account down to junior account managers and charge massive monthly retainer markups. When you work with me, I handle your strategy, campaign builds, code, and analytics personally with 100% accountability.
      </p>
    </div>
  </div>
</BaseLayout>
