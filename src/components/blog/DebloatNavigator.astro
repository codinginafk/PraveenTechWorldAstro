---
import Icon from "@components/common/Icon.astro";

interface Props {
  currentSlug: string;
  position?: "top" | "bottom";
}

const { currentSlug = "", position = "top" } = Astro.props;

interface SeriesStep {
  step: number;
  title: string;
  shortTitle: string;
  slug: string;
  description: string;
  isLive: boolean;
  statusText: string;
}

const seriesSteps: SeriesStep[] = [
  {
    step: 1,
    title: "Debloat Windows 11 Without Breaking WSL or Store: Sysadmin Guide",
    shortTitle: "Windows 11 Workstation",
    slug: "debloat-windows-11-sysadmin-guide-2026",
    description: "Surgical PowerShell debloater that frees 1.6GB RAM while keeping WSL2, Docker, Winget, and the Store 100% operational.",
    isLive: true,
    statusText: "Live Guide",
  },
  {
    step: 2,
    title: "How to Debloat Android TV & Google TV: 5 Steps (Tested)",
    shortTitle: "Android & Google TV",
    slug: "how-to-debloat-android-tv-google-tv-adb-guide",
    description: "Wireless ADB runbook to reclaim 2.17GB storage, cut idle RAM, stop auto-playing video ads, and install Projectivy.",
    isLive: false,
    statusText: "Coming Soon",
  },
  {
    step: 3,
    title: "Remove Copilot & Recall from Windows 11: Quiet PC Guide",
    shortTitle: "Copilot & Recall Stripping",
    slug: "remove-copilot-recall-bloat-windows-11-quiet-pc-guide",
    description: "Group Policy, Settings, and reversible PowerShell commands to strip AI entry points, telemetry, and background snapshots.",
    isLive: false,
    statusText: "Coming Soon",
  },
  {
    step: 4,
    title: "Windows 11 24H2 GPO Debloat Script and Telemetry Lockdown",
    shortTitle: "24H2 GPO & Telemetry",
    slug: "windows-11-24h2-debloat-gpo-telemetry-guide",
    description: "Enterprise policy templates and registry keys to silence Microsoft consumer diagnostic telemetry.",
    isLive: true,
    statusText: "Live Guide",
  },
  {
    step: 5,
    title: "How to Debloat Samsung, Xiaomi & Vivo: 3 Tested Steps in 2026",
    shortTitle: "Samsung, Xiaomi & Vivo",
    slug: "how-to-debloat-samsung-xiaomi-vivo-phones-adb-guide",
    description: "Universal ADB runbook to reclaim 1.8GB RAM, silence ad daemons, and stop battery drain across One UI, HyperOS, and Funtouch OS.",
    isLive: false,
    statusText: "Coming Soon",
  },
];

const cleanSlug = currentSlug.replace(/^\/|\/$/g, "").replace(/^blog\//, "");
const currentIndex = seriesSteps.findIndex((s) => s.slug === cleanSlug || cleanSlug.includes(s.slug));
const currentStep = currentIndex !== -1 ? seriesSteps[currentIndex] : seriesSteps[0];
---

{position === "top" ? (
  <div class="my-8 rounded-2xl border border-border dark:border-border-dark bg-amber-500/5 dark:bg-amber-400/5 p-5 md:p-6 not-prose border-amber-500/30 dark:border-amber-400/20 shadow-xs">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4 pb-3 border-b border-border/60 dark:border-border-dark/60">
      <div class="flex items-center gap-2.5">
        <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-amber-500/10 text-amber-600 dark:bg-amber-400/10 dark:text-amber-400 shadow-xs">
          <Icon name="terminal" class="w-4 h-4" />
        </span>
        <div>
          <span class="text-[11px] font-black uppercase tracking-wider text-amber-700 dark:text-amber-400">
            Special Hub: Hardware & Device Debloat Series
          </span>
          <p class="text-xs sm:text-sm font-bold text-text dark:text-text-dark m-0">
            Part {currentStep.step} of {seriesSteps.length}: {currentStep.shortTitle}
          </p>
        </div>
      </div>
      <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-amber-500/10 text-amber-700 dark:bg-amber-400/10 dark:text-amber-300 self-start sm:self-auto">
        Active Section
      </span>
    </div>

    <!-- Stepper Pipeline -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-2.5">
      {seriesSteps.map((step) => {
        const isCurrent = step.slug === cleanSlug || cleanSlug.includes(step.slug);
        return (
          <div class={`flex flex-col p-3 rounded-xl border text-xs transition-all ${
            isCurrent
              ? "border-amber-500/60 bg-surface dark:bg-surface-dark shadow-sm ring-1 ring-amber-500/30"
              : step.isLive
              ? "border-border dark:border-border-dark bg-surface/70 dark:bg-surface-dark/50 hover:border-amber-400/40"
              : "border-border/40 dark:border-border-dark/30 bg-surface/30 dark:bg-surface-dark/20 opacity-70"
          }`}>
            <div class="flex items-center justify-between gap-1 mb-1.5">
              <span class="font-bold text-[11px] text-text-muted dark:text-text-dark-muted">
                0{step.step}
              </span>
              <span class={`text-[10px] px-1.5 py-0.5 rounded font-semibold ${
                isCurrent
                  ? "bg-amber-500/10 text-amber-700 dark:text-amber-300"
                  : step.isLive
                  ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"
                  : "bg-surface-muted dark:bg-surface-dark-muted text-text-muted dark:text-text-dark-muted"
              }`}>
                {isCurrent ? "Reading Now" : step.statusText}
              </span>
            </div>

            {step.isLive && !isCurrent ? (
              <a href={`/blog/${step.slug}`} class="font-bold text-text dark:text-text-dark hover:text-amber-600 dark:hover:text-amber-400 line-clamp-2 mt-auto">
                {step.shortTitle}
              </a>
            ) : (
              <span class={`font-bold line-clamp-2 mt-auto ${isCurrent ? "text-amber-600 dark:text-amber-400" : "text-text-muted dark:text-text-dark-muted"}`}>
                {step.shortTitle}
              </span>
            )}
          </div>
        );
      })}
    </div>
  </div>
) : (
  <div class="my-10 rounded-2xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark p-6 not-prose shadow-sm">
    <div class="flex items-center justify-between mb-4 pb-3 border-b border-border/60 dark:border-border-dark/60">
      <div>
        <h4 class="text-sm font-bold uppercase tracking-wider text-text dark:text-text-dark">
          Explore the Complete Device Debloat Runbooks
        </h4>
        <p class="text-xs text-text-muted dark:text-text-dark-muted mt-0.5">
          Follow our verified workbench runbooks to strip consumer bloatware across workstations, smartphones, and smart TVs.
        </p>
      </div>
      <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-amber-500/10 text-amber-700 dark:bg-amber-400/10 dark:text-amber-400">
        5-Part Hub
      </span>
    </div>

    <div class="space-y-3">
      {seriesSteps.map((step) => {
        const isCurrent = step.slug === cleanSlug || cleanSlug.includes(step.slug);
        return (
          <div class={`flex flex-col sm:flex-row sm:items-center justify-between p-3.5 rounded-xl border text-xs gap-3 transition-all ${
            isCurrent
              ? "border-amber-500/60 bg-amber-50/50 dark:bg-amber-950/20"
              : "border-border/60 dark:border-border-dark/60 hover:border-amber-400/40 bg-surface-alt/40 dark:bg-surface-dark-alt/30"
          }`}>
            <div class="flex items-start gap-3">
              <span class={`flex h-6 w-6 shrink-0 items-center justify-center rounded-md font-bold text-xs ${
                isCurrent
                  ? "bg-amber-600 text-white dark:bg-amber-500"
                  : "bg-surface-muted dark:bg-surface-dark-muted text-text-muted"
              }`}>
                {step.step}
              </span>
              <div>
                {step.isLive && !isCurrent ? (
                  <a href={`/blog/${step.slug}`} class="font-bold text-text dark:text-text-dark hover:text-amber-600 dark:hover:text-amber-400">
                    {step.title}
                  </a>
                ) : (
                  <span class={`font-bold ${isCurrent ? "text-amber-700 dark:text-amber-400" : "text-text"}`}>
                    {step.title}
                  </span>
                )}
                <p class="text-text-muted dark:text-text-dark-muted mt-1 m-0 text-[11px] leading-relaxed">
                  {step.description}
                </p>
              </div>
            </div>

            <div class="shrink-0 flex items-center gap-2 self-end sm:self-center">
              {isCurrent ? (
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold bg-amber-500/15 text-amber-700 dark:text-amber-300">
                  Current Guide
                </span>
              ) : step.isLive ? (
                <a
                  href={`/blog/${step.slug}`}
                  class="inline-flex items-center gap-1 px-3 py-1 rounded-lg bg-surface dark:bg-surface-dark border border-border dark:border-border-dark text-[11px] font-semibold text-text dark:text-text-dark hover:bg-amber-50 dark:hover:bg-amber-950/30 hover:border-amber-500 transition-colors"
                >
                  Read Runbook &rarr;
                </a>
              ) : (
                <span class="text-[10px] font-semibold text-text-muted dark:text-text-dark-muted px-2 py-0.5">
                  Coming Soon
                </span>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>
)}
