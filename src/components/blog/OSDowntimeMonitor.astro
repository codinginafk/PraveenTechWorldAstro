---
import osDowntimesRaw from "../../data/os-downtimes.json";

interface Incident {
  id: string;
  name: string;
  osGroup: "windows" | "linux" | "macos-unix";
  osGroupName: string;
  distroDetail: string;
  year: number;
  dateString: string;
  downtimeHours: number;
  downtimeHuman: string;
  blastRadius: string;
  blastRank: number;
  cve: string;
  vector: string;
  quickFix: string;
  spokeSlug: string;
  impactHighlights: string;
  workbenchLessons: string;
}

const osDowntimes = osDowntimesRaw as Incident[];
---

<div class="my-10 rounded-2xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark shadow-sm overflow-hidden not-prose" id="os-downtime-monitor">
  <!-- Header Bar -->
  <div class="border-b border-border dark:border-border-dark bg-surface-muted/50 dark:bg-surface-dark-muted/40 p-5 md:p-6">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-500/10 text-red-600 dark:bg-red-400/10 dark:text-red-400 border border-red-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-red-500 mr-1.5 animate-pulse"></span>
            Historical Incident Monitor
          </span>
          <span class="text-xs text-text-muted dark:text-text-dark-muted">1988 – 2026</span>
        </div>
        <h3 class="text-xl md:text-2xl font-black tracking-tight text-text dark:text-text-dark">
          Operating System Downtime & Compromise Matrix
        </h3>
        <p class="text-sm text-text-muted dark:text-text-dark-muted mt-1 max-w-2xl">
          Real-world data on catastrophic OS outages, recovery durations, blast radii, and root architectural causes.
        </p>
      </div>

      <!-- Quick Metrics Counters -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 shrink-0">
        <div class="p-2.5 rounded-xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark text-center">
          <div class="text-lg md:text-xl font-extrabold text-brand-600 dark:text-brand-400">11</div>
          <div class="text-[11px] font-medium text-text-muted dark:text-text-dark-muted uppercase tracking-wider">Incidents</div>
        </div>
        <div class="p-2.5 rounded-xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark text-center">
          <div class="text-lg md:text-xl font-extrabold text-red-600 dark:text-red-400">8.5M</div>
          <div class="text-[11px] font-medium text-text-muted dark:text-text-dark-muted uppercase tracking-wider">Peak Blast</div>
        </div>
        <div class="p-2.5 rounded-xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark text-center col-span-2 sm:col-span-1">
          <div class="text-lg md:text-xl font-extrabold text-amber-600 dark:text-amber-400">14+ Days</div>
          <div class="text-[11px] font-medium text-text-muted dark:text-text-dark-muted uppercase tracking-wider">Max Recovery</div>
        </div>
      </div>
    </div>

    <!-- Interactive Filter & Search Controls -->
    <div class="mt-6 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3 pt-4 border-t border-border/60 dark:border-border-dark/60">
      <!-- Filter Tabs -->
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 md:pb-0" id="filter-tabs">
        <button
          type="button"
          data-filter="all"
          class="monitor-filter-btn active px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all duration-200 bg-brand-600 text-white shadow-sm"
        >
          All OSes ({osDowntimes.length})
        </button>
        <button
          type="button"
          data-filter="windows"
          class="monitor-filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all duration-200 bg-surface dark:bg-surface-dark border border-border dark:border-border-dark text-text-muted dark:text-text-dark-muted hover:text-text dark:hover:text-text-dark hover:border-brand-500/40"
        >
          Windows ({osDowntimes.filter((i: Incident) => i.osGroup === 'windows').length})
        </button>
        <button
          type="button"
          data-filter="linux"
          class="monitor-filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all duration-200 bg-surface dark:bg-surface-dark border border-border dark:border-border-dark text-text-muted dark:text-text-dark-muted hover:text-text dark:hover:text-text-dark hover:border-brand-500/40"
        >
          Linux Distros ({osDowntimes.filter((i: Incident) => i.osGroup === 'linux').length})
        </button>
        <button
          type="button"
          data-filter="macos-unix"
          class="monitor-filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all duration-200 bg-surface dark:bg-surface-dark border border-border dark:border-border-dark text-text-muted dark:text-text-dark-muted hover:text-text dark:hover:text-text-dark hover:border-brand-500/40"
        >
          macOS & Unix ({osDowntimes.filter((i: Incident) => i.osGroup === 'macos-unix').length})
        </button>
      </div>

      <!-- Search & Sort Controls -->
      <div class="flex items-center gap-2">
        <div class="relative flex-grow md:flex-grow-0">
          <input
            type="text"
            id="monitor-search-input"
            placeholder="Search CVE, vector, OS..."
            class="w-full md:w-56 px-3 py-1.5 text-xs rounded-lg border border-border dark:border-border-dark bg-surface dark:bg-surface-dark text-text dark:text-text-dark placeholder-text-muted/60 focus:outline-none focus:ring-2 focus:ring-brand-500/40"
          />
        </div>
        <select
          id="monitor-sort-select"
          class="px-2.5 py-1.5 text-xs rounded-lg border border-border dark:border-border-dark bg-surface dark:bg-surface-dark text-text dark:text-text-dark focus:outline-none focus:ring-2 focus:ring-brand-500/40 shrink-0 cursor-pointer"
        >
          <option value="year-desc">Newest First</option>
          <option value="year-asc">Oldest First</option>
          <option value="hours-desc">Longest Downtime</option>
          <option value="blast-asc">Highest Blast Radius</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Incident Roster List -->
  <div class="divide-y divide-border/60 dark:divide-border-dark/60" id="incidents-container">
    {osDowntimes.map((incident: Incident) => (
      <div
        class="incident-card group p-5 md:p-6 transition-colors duration-150 hover:bg-surface-muted/40 dark:hover:bg-surface-dark-muted/20"
        data-os={incident.osGroup}
        data-year={incident.year}
        data-hours={incident.downtimeHours}
        data-blast-rank={incident.blastRank}
        data-text={`${incident.name} ${incident.distroDetail} ${incident.cve} ${incident.vector} ${incident.osGroupName}`.toLowerCase()}
      >
        <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
          <div class="flex-grow">
            <!-- Badges Bar -->
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <span class={`inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold tracking-wide uppercase ${
                incident.osGroup === 'windows'
                  ? 'bg-blue-500/10 text-blue-600 dark:bg-blue-400/10 dark:text-blue-300 border border-blue-500/20'
                  : incident.osGroup === 'linux'
                  ? 'bg-emerald-500/10 text-emerald-600 dark:bg-emerald-400/10 dark:text-emerald-300 border border-emerald-500/20'
                  : 'bg-purple-500/10 text-purple-600 dark:bg-purple-400/10 dark:text-purple-300 border border-purple-500/20'
              }`}>
                {incident.osGroupName}
              </span>
              <span class="text-xs font-mono text-text-muted dark:text-text-dark-muted">
                {incident.dateString}
              </span>
              <span class="text-xs font-mono px-2 py-0.5 rounded bg-surface-muted dark:bg-surface-dark-muted text-text dark:text-text-dark border border-border dark:border-border-dark">
                {incident.cve}
              </span>
            </div>

            <!-- Incident Title & Systems -->
            <h4 class="text-base md:text-lg font-bold text-text dark:text-text-dark group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
              {incident.name}
            </h4>
            <div class="text-xs text-text-muted dark:text-text-dark-muted mt-0.5">
              <strong class="font-medium text-text/80 dark:text-text-dark/80">Affected:</strong> {incident.distroDetail}
            </div>

            <!-- Vulnerability Vector -->
            <p class="text-xs md:text-sm text-text-muted dark:text-text-dark-muted mt-2 leading-relaxed">
              <span class="font-semibold text-text dark:text-text-dark">Root Vector:</span> {incident.vector}
            </p>
          </div>

          <!-- Impact & Downtime Pill -->
          <div class="flex md:flex-col items-end justify-between md:justify-start gap-1.5 shrink-0 min-w-[190px]">
            <div class="text-right">
              <div class="text-xs font-bold text-red-600 dark:text-red-400">
                {incident.blastRadius}
              </div>
              <div class="text-[11px] text-text-muted dark:text-text-dark-muted">
                {incident.downtimeHuman}
              </div>
            </div>
            
            <button
              type="button"
              class="incident-expand-btn inline-flex items-center gap-1 text-xs font-semibold text-brand-600 dark:text-brand-400 hover:underline mt-2 cursor-pointer"
            >
              <span>View Runbook</span>
              <svg class="w-3.5 h-3.5 transition-transform duration-200 expand-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
          </div>
        </div>

        <!-- Expandable Remediation Drawer -->
        <div class="incident-drawer hidden mt-4 pt-4 border-t border-border/50 dark:border-border-dark/50">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Impact Details -->
            <div class="rounded-xl p-3.5 bg-surface-muted/60 dark:bg-surface-dark-muted/40 border border-border/60 dark:border-border-dark/60">
              <h5 class="text-xs font-bold uppercase tracking-wider text-text dark:text-text-dark mb-1.5 flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-red-500"></span>
                Real-World Impact & Blast Radius
              </h5>
              <p class="text-xs text-text-muted dark:text-text-dark-muted leading-relaxed">
                {incident.impactHighlights}
              </p>
              <div class="mt-3 pt-2.5 border-t border-border/40 dark:border-border-dark/40 text-[11px] text-text-muted dark:text-text-dark-muted">
                <span class="font-semibold text-text dark:text-text-dark">Workbench Takeaway:</span> {incident.workbenchLessons}
              </div>
            </div>

            <!-- Workbench Emergency Runbook -->
            <div class="rounded-xl p-3.5 bg-surface-muted/60 dark:bg-surface-dark-muted/40 border border-border/60 dark:border-border-dark/60">
              <h5 class="text-xs font-bold uppercase tracking-wider text-text dark:text-text-dark mb-1.5 flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-brand-500"></span>
                Emergency Triage & Remediation Command
              </h5>
              <div class="mt-1 font-mono text-xs p-2.5 rounded-lg bg-surface dark:bg-surface-dark border border-border dark:border-border-dark text-text dark:text-text-dark overflow-x-auto select-all">
                {incident.quickFix}
              </div>
              <div class="mt-3 flex items-center justify-between">
                <span class="text-[11px] text-text-muted dark:text-text-dark-muted">Forensic deep dive available in cluster</span>
                <a
                  href={`/blog/${incident.spokeSlug}`}
                  class="text-xs font-semibold text-brand-600 dark:text-brand-400 hover:underline inline-flex items-center gap-1"
                >
                  Read Postmortem &rarr;
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Empty Search Fallback -->
  <div id="no-incidents-msg" class="hidden p-12 text-center text-text-muted dark:text-text-dark-muted">
    <p class="text-sm">No recorded OS outages match your filter or search query.</p>
    <button
      type="button"
      id="reset-filter-btn"
      class="mt-3 px-3 py-1.5 text-xs font-semibold rounded-lg bg-brand-600 text-white hover:bg-brand-700"
    >
      Reset Filters
    </button>
  </div>
</div>

<script>
  function initOSDowntimeMonitor() {
    const container = document.getElementById("os-downtime-monitor");
    if (!container) return;

    const cards = Array.from(container.querySelectorAll<HTMLElement>(".incident-card"));
    const listEl = container.querySelector<HTMLElement>("#incidents-container");
    const filterBtns = Array.from(container.querySelectorAll<HTMLButtonElement>(".monitor-filter-btn"));
    const searchInput = container.querySelector<HTMLInputElement>("#monitor-search-input");
    const sortSelect = container.querySelector<HTMLSelectElement>("#monitor-sort-select");
    const emptyMsg = container.querySelector<HTMLElement>("#no-incidents-msg");
    const resetBtn = container.querySelector<HTMLButtonElement>("#reset-filter-btn");

    let currentFilter = "all";
    let searchQuery = "";
    let currentSort = "year-desc";

    function updateView() {
      let visibleCount = 0;

      cards.forEach((card) => {
        const osGroup = card.dataset.os || "";
        const text = card.dataset.text || "";

        const matchesFilter = currentFilter === "all" || osGroup === currentFilter;
        const matchesSearch = !searchQuery || text.includes(searchQuery);

        if (matchesFilter && matchesSearch) {
          card.style.display = "";
          visibleCount++;
        } else {
          card.style.display = "none";
        }
      });

      if (emptyMsg) {
        emptyMsg.style.display = visibleCount === 0 ? "block" : "none";
      }

      // Sort visible cards
      if (listEl) {
        const sorted = [...cards].sort((a, b) => {
          const yearA = parseInt(a.dataset.year || "0", 10);
          const yearB = parseInt(b.dataset.year || "0", 10);
          const hoursA = parseInt(a.dataset.hours || "0", 10);
          const hoursB = parseInt(b.dataset.hours || "0", 10);
          const blastA = parseInt(a.dataset.blastRank || "99", 10);
          const blastB = parseInt(b.dataset.blastRank || "99", 10);

          if (currentSort === "year-desc") return yearB - yearA;
          if (currentSort === "year-asc") return yearA - yearB;
          if (currentSort === "hours-desc") return hoursB - hoursA;
          if (currentSort === "blast-asc") return blastA - blastB;
          return 0;
        });

        sorted.forEach((card) => listEl.appendChild(card));
      }
    }

    // Filter Buttons
    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        filterBtns.forEach((b) => {
          b.classList.remove("active", "bg-brand-600", "text-white", "shadow-sm");
          b.classList.add("bg-surface", "dark:bg-surface-dark", "text-text-muted", "dark:text-text-dark-muted");
        });
        btn.classList.add("active", "bg-brand-600", "text-white", "shadow-sm");
        btn.classList.remove("bg-surface", "dark:bg-surface-dark", "text-text-muted", "dark:text-text-dark-muted");

        currentFilter = btn.dataset.filter || "all";
        updateView();
      });
    });

    // Search Input
    searchInput?.addEventListener("input", (e) => {
      searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
      updateView();
    });

    // Sort Select
    sortSelect?.addEventListener("change", (e) => {
      currentSort = (e.target as HTMLSelectElement).value;
      updateView();
    });

    // Reset Button
    resetBtn?.addEventListener("click", () => {
      currentFilter = "all";
      searchQuery = "";
      if (searchInput) searchInput.value = "";
      filterBtns.forEach((b, idx) => {
        if (idx === 0) {
          b.classList.add("active", "bg-brand-600", "text-white");
        } else {
          b.classList.remove("active", "bg-brand-600", "text-white");
        }
      });
      updateView();
    });

    // Toggle Expandable Runbooks
    cards.forEach((card) => {
      const expandBtn = card.querySelector<HTMLButtonElement>(".incident-expand-btn");
      const drawer = card.querySelector<HTMLElement>(".incident-drawer");
      const icon = card.querySelector<SVGElement>(".expand-icon");

      expandBtn?.addEventListener("click", () => {
        const isHidden = drawer?.classList.contains("hidden");
        if (isHidden) {
          drawer?.classList.remove("hidden");
          expandBtn.querySelector("span")!.textContent = "Hide Runbook";
          icon?.classList.add("rotate-180");
        } else {
          drawer?.classList.add("hidden");
          expandBtn.querySelector("span")!.textContent = "View Runbook";
          icon?.classList.remove("rotate-180");
        }
      });
    });
  }

  // Initialize on page load & Astro client router transitions
  initOSDowntimeMonitor();
  document.addEventListener("astro:page-load", initOSDowntimeMonitor);
</script>
