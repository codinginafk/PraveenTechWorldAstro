---
interface Props {
  quickAnswer?: {
    summary: string;
    command?: string;
    hook?: string;
    scrollCta?: string;
  };
}

const { quickAnswer } = Astro.props;
---

{quickAnswer && (
  <aside aria-label="Quick Answer" class="my-6 rounded-2xl border-2 border-brand-500/30 bg-surface dark:bg-surface-dark-alt p-5 sm:p-6 shadow-sm ring-1 ring-brand-500/10">
    <div class="flex items-center gap-2.5 mb-3">
      <span class="flex h-6 w-6 items-center justify-center rounded-full bg-emerald-500/15 text-emerald-600 dark:bg-emerald-400/20 dark:text-emerald-400 text-xs font-black">
        ✓
      </span>
      <h2 class="text-base font-extrabold tracking-tight text-text dark:text-text-dark m-0">
        Quick Answer (30-Second Solution)
      </h2>
    </div>

    <p class="text-sm sm:text-base font-medium text-text dark:text-text-dark leading-relaxed mb-3.5">
      {quickAnswer.summary}
    </p>

    {quickAnswer.command && (
      <div class="relative mb-3.5 overflow-hidden rounded-xl border border-border dark:border-border-dark bg-slate-950 p-3.5 text-slate-100 font-mono text-xs sm:text-sm">
        <div class="flex items-center justify-between pb-2 mb-2 border-b border-slate-800 text-[11px] text-slate-400 font-sans">
          <span>Run in Administrator Terminal / PowerShell:</span>
        </div>
        <pre class="overflow-x-auto m-0 p-0 text-amber-300 select-all"><code>{quickAnswer.command}</code></pre>
      </div>
    )}

    <div class="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-border/40 dark:border-border-dark/40 text-xs">
      {quickAnswer.hook && (
        <span class="font-medium text-emerald-700 dark:text-emerald-400">
          ⚡ {quickAnswer.hook}
        </span>
      )}
      <span class="text-text-muted dark:text-text-dark-muted font-medium">
        {quickAnswer.scrollCta || "Need alternative steps? Continue reading below ↓"}
      </span>
    </div>
  </aside>
)}
