---
interface Props {
  headline?: string;
  subtext?: string;
  leadMagnetName?: string;
}

const {
  headline = "Get Our Sysadmin & AI Runbooks Direct to Your Inbox",
  subtext = "Join 2,500+ engineers receiving our weekly PowerShell automation scripts, root cause analyses, and hardware diagnostic playbooks.",
  leadMagnetName = "Free PowerShell & Sysadmin Toolkit"
} = Astro.props;
---

<div class="lead-magnet-box" id="lead-magnet-box">
  <div class="lead-badge">
    <span>⚡ {leadMagnetName}</span>
  </div>
  
  <h3 class="lead-title">{headline}</h3>
  <p class="lead-subtext">{subtext}</p>
  
  <form 
    action="https://formspree.io/f/mqabewpk" 
    method="POST" 
    class="lead-form"
    id="form-lead-capture"
  >
    <div class="form-inputs">
      <input 
        type="email" 
        name="email" 
        placeholder="Enter your work or personal email..." 
        required 
        class="lead-input"
        id="input-lead-email"
      />
      <button type="submit" class="lead-submit-btn" id="btn-lead-submit">
        Subscribe & Get Scripts
      </button>
    </div>
    <span class="lead-disclaimer">Zero spam. Unsubscribe anytime in 1 click.</span>
  </form>
</div>

<style>
  .lead-magnet-box {
    margin: 2.5rem 0;
    padding: 2rem;
    border-radius: 12px;
    background: #090d16;
    border: 1px solid #1e293b;
    color: #f8fafc;
  }
  
  .lead-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    font-size: 0.8125rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }
  
  .lead-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 0.5rem 0;
    line-height: 1.35;
  }
  
  .lead-subtext {
    font-size: 0.9375rem;
    color: #94a3b8;
    margin: 0 0 1.25rem 0;
    line-height: 1.5;
  }
  
  .lead-form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .form-inputs {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  
  @media (min-width: 640px) {
    .form-inputs {
      flex-direction: row;
    }
  }
  
  .lead-input {
    flex: 1;
    padding: 0.65rem 1rem;
    border-radius: 8px;
    border: 1px solid #334155;
    background: #0f172a;
    color: #ffffff;
    font-size: 0.9375rem;
    outline: none;
    transition: border-color 0.2s ease;
  }
  
  .lead-input:focus {
    border-color: #38bdf8;
  }
  
  .lead-submit-btn {
    padding: 0.65rem 1.25rem;
    border-radius: 8px;
    background: #2563eb;
    color: #ffffff;
    font-weight: 700;
    font-size: 0.9375rem;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s ease;
  }
  
  .lead-submit-btn:hover {
    background: #1d4ed8;
  }
  
  .lead-disclaimer {
    font-size: 0.75rem;
    color: #64748b;
  }
</style>
