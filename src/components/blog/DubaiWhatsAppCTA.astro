---
interface Props {
  headline?: string;
  subtext?: string;
  prefilledText?: string;
}

const {
  headline = "Need Help With Your Dubai Business or Technology Setup?",
  subtext = "Our team helps UAE business owners, founders, and IT teams solve complex verifications, local SEO, and custom automation.",
  prefilledText = "Hi Praveen, I read your Dubai guide on PraveenTechWorld and would like to discuss our business tech/growth requirements."
} = Astro.props;

const encodedText = encodeURIComponent(prefilledText);
// Professional Dubai WhatsApp Contact Line (Direct deep link)
const whatsappUrl = `https://wa.me/971562980106?text=${encodedText}`;
---

<div class="dubai-whatsapp-cta" id="dubai-whatsapp-cta">
  <div class="cta-badge">
    <span class="badge-dot"></span>
    <span>Dubai & UAE Direct Consultation</span>
  </div>
  
  <h3 class="cta-title">{headline}</h3>
  <p class="cta-description">{subtext}</p>
  
  <div class="cta-actions">
    <a 
      href={whatsappUrl} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="cta-whatsapp-btn"
      id="btn-whatsapp-inquiry"
    >
      <svg class="whatsapp-icon" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.634.077-1.748-.387-1.391-.581-2.29-2.001-2.36-2.093-.07-.093-.563-.748-.563-1.425 0-.677.356-.99.48-.112.124-.124.271-.156.363-.156.091 0 .183.001.264.005.083.004.195-.031.306.234.113.265.385.94.419 1.009.034.07.056.15.011.238-.045.088-.068.143-.135.22-.068.077-.142.172-.204.231-.067.065-.138.136-.06.269.079.133.351.58.753.939.519.462.956.606 1.092.673.136.067.215.056.294-.034.079-.089.339-.395.429-.53.09-.136.181-.113.306-.068.124.045.79.373.926.441.136.068.226.102.26.159.034.057.034.339-.11.744z"/>
      </svg>
      <span>Chat on WhatsApp</span>
    </a>
    
    <a 
      href="mailto:contact@praveentechworld.com?subject=Dubai%20Consultation%20Inquiry" 
      class="cta-email-link"
    >
      Or email our desk &rarr;
    </a>
  </div>
</div>

<style>
  .dubai-whatsapp-cta {
    margin: 2.5rem 0;
    padding: 1.75rem;
    border-radius: 12px;
    background: #0f172a;
    border: 1px solid #1e293b;
    color: #f8fafc;
  }
  
  .cta-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    background: rgba(34, 197, 94, 0.15);
    color: #4ade80;
    font-size: 0.8125rem;
    font-weight: 600;
    margin-bottom: 0.875rem;
  }
  
  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #22c55e;
  }
  
  .cta-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 0.5rem 0;
    line-height: 1.35;
  }
  
  .cta-description {
    font-size: 0.9375rem;
    color: #94a3b8;
    margin: 0 0 1.25rem 0;
    line-height: 1.5;
  }
  
  .cta-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  
  .cta-whatsapp-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #22c55e;
    color: #022c22;
    font-weight: 700;
    font-size: 0.9375rem;
    padding: 0.65rem 1.25rem;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.1s ease;
  }
  
  .cta-whatsapp-btn:hover {
    background: #16a34a;
    color: #ffffff;
    transform: translateY(-1px);
  }
  
  .cta-email-link {
    color: #cbd5e1;
    font-size: 0.875rem;
    text-decoration: none;
    font-weight: 500;
  }
  
  .cta-email-link:hover {
    color: #38bdf8;
    text-decoration: underline;
  }
</style>
