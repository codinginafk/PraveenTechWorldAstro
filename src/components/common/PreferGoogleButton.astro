---
interface Props {
  variant?: "badge" | "card" | "banner";
  class?: string;
}

const { variant = "badge", class: className = "" } = Astro.props;
---

{variant === "badge" && (
  <a
    href="https://www.google.com/preferences/source?q=praveentechworld.com"
    target="_blank"
    rel="nofollow noopener noreferrer"
    class={`inline-flex items-center gap-2 rounded-xl border border-brand-500/30 bg-brand-50/80 px-3.5 py-2 text-xs font-bold text-brand-700 shadow-sm transition-all hover:bg-brand-100 hover:border-brand-500 hover:shadow dark:border-brand-500/30 dark:bg-brand-950/40 dark:text-brand-300 dark:hover:bg-brand-900/50 ${className}`}
    title="Add PraveenTechWorld to your preferred sources in Google Search results"
  >
    <svg class="h-4 w-4 text-amber-500 shrink-0" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
    </svg>
    <span>Prefer on Google Search</span>
    <svg class="h-3 w-3 opacity-60 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
    </svg>
  </a>
)}

{variant === "card" && (
  <div class={`rounded-xl border border-brand-500/30 bg-gradient-to-br from-brand-50/70 via-surface to-brand-50/30 p-4 sm:p-5 dark:border-brand-500/20 dark:from-brand-950/40 dark:via-surface-dark-alt dark:to-brand-900/20 ${className}`}>
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-brand-700 dark:bg-brand-900/60 dark:text-brand-300">
          <svg class="h-5 w-5 text-amber-500" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
          </svg>
        </div>
        <div>
          <span class="text-xs sm:text-sm font-bold text-text dark:text-text-dark block">Get Independent Tech Benchmarks First</span>
          <p class="text-[11px] sm:text-xs text-text-muted dark:text-text-dark-muted m-0">Add PraveenTechWorld as a preferred source in your Google Search results.</p>
        </div>
      </div>
      <a
        href="https://www.google.com/preferences/source?q=praveentechworld.com"
        target="_blank"
        rel="nofollow noopener noreferrer"
        class="inline-flex shrink-0 items-center justify-center gap-1.5 rounded-xl bg-brand-600 px-4 py-2 text-xs font-bold text-white shadow-sm transition-all hover:bg-brand-500"
      >
        <span>⭐ Prefer on Google</span>
        <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </div>
)}
