---
export interface Props {
  skipBreadcrumbs?: boolean;
  /**
   * Page-level metadata. Without it every page emitted the *site* name and the
   * same generic description as its own WebPage entity, so ~630 pages claimed
   * to be one identical WebPage.
   */
  seo?: { title?: string; description?: string; ogImage?: string };
}

const { skipBreadcrumbs = false, seo } = Astro.props;
const siteUrl = "https://www.praveentechworld.com";
const siteName = "PraveenTechWorld";
const contactEmail = "contact@praveentechworld.com";

const FALLBACK_DESCRIPTION =
  "Practical technology guides, how-to tutorials, AI workflows, productivity tips, and troubleshooting solutions.";
const pageName = seo?.title?.trim() || siteName;
const pageDescription = seo?.description?.trim() || FALLBACK_DESCRIPTION;
const rawImage = seo?.ogImage;
const pageImage = rawImage
  ? /^https?:\/\//i.test(rawImage)
    ? rawImage
    : `${siteUrl}${rawImage}`
  : `${siteUrl}/images/og-default.png`;

const rawPathname = Astro.url.pathname.replace(/\/$/, "");
const segments = rawPathname.split("/").filter(Boolean);

// Format slug to readable Title Case
const formatSegment = (segment: string) => {
  return segment
    .split("-")
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");
};

// Build BreadcrumbList hierarchy
const breadcrumbItems = [
  { name: "Home", url: `${siteUrl}/` },
  ...segments.map((segment, index) => {
    const url = `${siteUrl}/${segments.slice(0, index + 1).join("/")}`;
    return { name: formatSegment(segment), url };
  }),
];

// Single blog articles (/blog/:slug) provide their own article-specific breadcrumb schema in [...slug].astro
const isArticlePage = segments.length >= 2 && segments[0] === "blog";
const shouldRenderBreadcrumbs = !skipBreadcrumbs && !isArticlePage;
const currentPageUrl = `${siteUrl}${Astro.url.pathname}`;
---

<script type="application/ld+json" is:inline set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteName,
  url: siteUrl,
  description: "Practical technology guides, productivity tips, and AI workflows.",
  inLanguage: "en-US",
})} />

<script type="application/ld+json" is:inline set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteName,
  url: siteUrl,
  logo: `${siteUrl}/favicon/favicon.svg`,
  email: contactEmail,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Dubai",
    addressCountry: "AE",
  },
  location: {
    "@type": "Place",
    name: "Dubai, United Arab Emirates",
  },
  sameAs: [
    "https://x.com/praveenwithapen",
    "https://www.linkedin.com/in/praveen-kumar-says/",
  ],
})} />

<script type="application/ld+json" is:inline set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: pageName,
  url: currentPageUrl,
  description: pageDescription,
  primaryImageOfPage: {
    "@type": "ImageObject",
    url: pageImage,
  },
  inLanguage: "en-US",
  isPartOf: {
    "@type": "WebSite",
    name: siteName,
    url: siteUrl,
  },
})} />

{shouldRenderBreadcrumbs && (
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbItems.map((item, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: item.name,
      item: item.url,
    })),
  })} />
)}

