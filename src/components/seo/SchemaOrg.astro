---
export interface Props {
  type: string;
  articleData?: {
    title: string;
    description?: string;
    url: string;
    publishDate?: string;
    updatedDate?: string;
    authorName?: string;
    image?: string;
    imageWidth?: number;
    imageHeight?: number;
    tags?: string[];
  };
  breadcrumbItems?: Array<{ name: string; url: string }>;
  faqItems?: Array<{ question: string; answer: string }>;
  personData?: {
    name: string;
    description?: string;
    url?: string;
    image?: string;
    sameAs?: string[];
  };
  itemListData?: {
    name: string;
    description?: string;
    items: Array<{ name: string; url: string; position: number }>;
  };
  webApplicationData?: {
    name: string;
    description: string;
    url: string;
    applicationCategory: string;
    operatingSystem?: string;
    browserRequirements?: string;
    offers?: {
      price: string;
      priceCurrency: string;
    };
  };
}

const { type, articleData, breadcrumbItems, faqItems, personData, itemListData, webApplicationData } = Astro.props;
---

{
  type === "article" && articleData && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["Article", "TechArticle"],
      headline: articleData.title,
      description: articleData.description,
      url: articleData.url,
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": articleData.url,
      },
      datePublished: articleData.publishDate,
      dateModified: articleData.updatedDate || articleData.publishDate,
      author: {
        "@type": "Person",
        name: articleData.authorName || "Praveen",
        url: "https://www.praveentechworld.com/about",
        sameAs: [
          "https://x.com/praveenwithapen",
          "https://www.linkedin.com/in/praveen-kumar-says/",
        ],
      },
      publisher: {
        "@type": "Organization",
        name: "PraveenTechWorld",
        url: "https://www.praveentechworld.com",
        logo: {
          "@type": "ImageObject",
          url: "https://www.praveentechworld.com/favicon/favicon.svg",
        },
      },
      image: articleData.image ? {
        "@type": "ImageObject",
        url: articleData.image.startsWith("http")
          ? articleData.image
          : `https://www.praveentechworld.com${articleData.image}`,
        ...(articleData.imageWidth && articleData.imageHeight
          ? { width: articleData.imageWidth, height: articleData.imageHeight }
          : {}),
      } : undefined,
      keywords: articleData.tags?.join(", "),
      inLanguage: "en-US",
    })} />
  )
}

{
  type === "breadcrumb" && breadcrumbItems && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbItems.map((item, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: item.name,
        item: item.url,
      })),
    })} />
  )
}

{
  type === "faq" && faqItems && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer,
        },
      })),
    })} />
  )
}

{
  type === "person" && personData && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: personData.name,
      description: personData.description,
      url: personData.url,
      image: personData.image,
      sameAs: personData.sameAs,
    })} />
  )
}

{
  type === "webapplication" && webApplicationData && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      name: webApplicationData.name,
      description: webApplicationData.description,
      url: webApplicationData.url,
      applicationCategory: webApplicationData.applicationCategory,
      operatingSystem: webApplicationData.operatingSystem || "All",
      browserRequirements: webApplicationData.browserRequirements || "Requires JavaScript. Requires HTML5.",
      ...(webApplicationData.offers ? {
        offers: {
          "@type": "Offer",
          price: webApplicationData.offers.price,
          priceCurrency: webApplicationData.offers.priceCurrency,
        },
      } : {}),
      creator: {
        "@type": "Organization",
        name: "PraveenTechWorld",
        url: "https://www.praveentechworld.com",
      },
    })} />
  )
}

{
  type === "itemlist" && itemListData && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ItemList",
      name: itemListData.name,
      description: itemListData.description,
      itemListElement: itemListData.items.map((item) => ({
        "@type": "ListItem",
        position: item.position,
        name: item.name,
        url: item.url.startsWith("http") ? item.url : `https://www.praveentechworld.com${item.url}`,
      })),
    })} />
  )
}
