---
import { buildPageTitle, buildCanonical, type SEOMetadata } from "@lib/seo/metadata";
import { getCoverImageDimensions } from "@lib/images/dimensions";

export interface Props extends SEOMetadata {
  noindex?: boolean;
  ogType?: string;
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogImage,
  canonical,
  noindex,
  ogType = "website",
  publishedTime,
  modifiedTime,
} = Astro.props;

const siteUrl = "https://www.praveentechworld.com";
const siteName = "PraveenTechWorld";
const pageTitle = buildPageTitle(title);
const pageCanonical = canonical || buildCanonical(siteUrl, Astro.url.pathname);

// Social crawlers do not resolve relative URLs and do not render SVG, so the
// card image must always be an absolute raster URL. Frontmatter `coverImage`
// values are site-relative (`/images/...`), which previously reached og:image
// verbatim and produced a broken preview on every article.
const RESERVED_PATH = "/images/og-default.png";
const rawImage = ogImage || RESERVED_PATH;
const ogImg = /^https?:\/\//i.test(rawImage) ? rawImage : new URL(rawImage, siteUrl).href;
const ogDims = ogImage ? await getCoverImageDimensions(ogImage) : { width: 1200, height: 630 };
const ogTypeAttr = /\.png$/i.test(ogImg) ? "image/png" : /\.webp$/i.test(ogImg) ? "image/webp" : "image/jpeg";
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={pageCanonical} />

<meta property="og:type" content={ogType} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={ogTitle || pageTitle} />
<meta property="og:description" content={ogDescription || description} />
<meta property="og:url" content={pageCanonical} />
<meta property="og:image" content={ogImg} />
<meta property="og:image:type" content={ogTypeAttr} />
{ogDims && <meta property="og:image:width" content={String(ogDims.width)} />}
{ogDims && <meta property="og:image:height" content={String(ogDims.height)} />}
<meta property="og:image:alt" content={ogTitle || pageTitle} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@praveenwithapen" />
<meta name="twitter:creator" content="@praveenwithapen" />
<meta name="twitter:title" content={ogTitle || pageTitle} />
<meta name="twitter:description" content={ogDescription || description} />
<meta name="twitter:image" content={ogImg} />

{noindex ? (
  <meta name="robots" content="noindex, follow" />
) : (
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
)}
