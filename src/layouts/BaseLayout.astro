---
import "../styles/global.css";
import Header from "@components/common/Header.astro";
import Footer from "@components/common/Footer.astro";
import SEO from "@components/seo/SEO.astro";
import GlobalSchema from "@components/seo/GlobalSchema.astro";
import type { SEOMetadata } from "@lib/seo/metadata";
import Analytics from "@vercel/analytics/astro";

export interface Props {
  seo: SEOMetadata;
  noindex?: boolean;
}

const { seo, noindex: explicitNoindex } = Astro.props;
const noindex = explicitNoindex !== undefined ? explicitNoindex : seo?.noindex;
---

<!doctype html>
<html lang="en" class="">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />

    <!-- Google Consent Mode v2 (Advanced) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      var savedConsent = null;
      try { savedConsent = localStorage.getItem('cookie-consent'); } catch(e) {}
      if (savedConsent === 'accepted') {
        gtag('consent', 'default', {
          'ad_storage': 'granted',
          'ad_user_data': 'granted',
          'ad_personalization': 'granted',
          'analytics_storage': 'granted'
        });
      } else {
        gtag('consent', 'default', {
          'ad_storage': 'denied',
          'ad_user_data': 'denied',
          'ad_personalization': 'denied',
          'analytics_storage': 'denied',
          'wait_for_update': 500
        });
      }
    </script>

    <!-- Google tag (gtag.js) - GA4 with Consent Mode v2 Cookieless Pings -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-TR2F3NPMVN"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-TR2F3NPMVN', {
        'send_page_view': true,
        'anonymize_ip': true,
        'cookie_flags': 'SameSite=None;Secure'
      });
    </script>

    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-N2N2QBJC');
    </script>
    <!-- End Google Tag Manager -->

    <!-- Microsoft Clarity Heatmaps & Session Recording (idle-deferred: never
         competes with LCP/hero bytes; heatmaps don't need first paint) -->
    <script is:inline>
      window.__ptwLoadClarity = function() {
        (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "yf20xj4sle");
      };
      if ("requestIdleCallback" in window) {
        requestIdleCallback(function() { window.__ptwLoadClarity(); }, { timeout: 4000 });
      } else {
        setTimeout(window.__ptwLoadClarity, 2500);
      }
    </script>
    <!-- End Microsoft Clarity -->

    <SEO {...seo} noindex={noindex} />
    <GlobalSchema seo={{ title: seo?.title, description: seo?.description, ogImage: seo?.ogImage }} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="author" content="Praveen" />
    <meta name="msvalidate.01" content="65D5AFBFB481C5C601E5930AA846A740" />
    <meta property="og:locale" content="en_US" />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <meta name="view-transition" content="same-origin" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://clarity.ms" />
    <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
    <link rel="dns-prefetch" href="https://analytics.ahrefs.com" />
    {seo?.ogImage && <link rel="preload" as="image" href={seo.ogImage} fetchpriority="high" />}
    {seo?.preloadImage && <link rel="preload" as="image" href={seo.preloadImage} fetchpriority="high" />}

    <!-- Speculation rules: instant article-to-article navigation.
         Prerender /blog/* on hover intent only; unsupported browsers ignore.
         (Turnstile/contact/tools pages excluded — heavy interactive state.) -->
    <script is:inline type="speculationrules">
      {"prerender": [{"source": "document", "where": {"href_matches": ["/blog/*"]}, "eagerness": "moderate"}]}
    </script>

    <script is:inline>
      (function () {
        // First visit always renders light (trust-first impression for new
        // readers); the toggle persists an explicit choice. OS dark-mode is
        // intentionally NOT auto-applied — dark dashboards read as untrusted
        // to first-time visitors.
        const isDark = localStorage.getItem("theme") === "dark";
        if (isDark) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", isDark ? "#09090b" : "#ffffff");
      })();
      // Sanitize legacy Blogger ?m=1 query strings client-side
      if (window.location.search.includes("m=1") || window.location.search.includes("m=0")) {
        const cleanUrl = window.location.protocol + "//" + window.location.host + window.location.pathname;
        window.history.replaceState(null, "", cleanUrl);
      }
    </script>

    <!-- Google AdSense Verification & Runtime -->
    <meta name="google-adsense-account" content="ca-pub-7141944151842257" />
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7141944151842257" crossorigin="anonymous"></script>

    <!-- Ahrefs Web Analytics & Ownership Verification -->
    <script is:inline src="https://analytics.ahrefs.com/analytics.js" data-key="MK+SHF8VR3nNzLoiww157g" async></script>
  </head>
  <body class="bg-surface text-text dark:bg-surface-dark dark:text-text-dark antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-N2N2QBJC"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Analytics />
    <a href="#main-content" class="skip-link">
      Skip to main content
    </a>
    <Header />
    <main id="main-content" class="min-h-screen">
      <slot />
    </main>
    <Footer />

    <div id="cookie-banner" class="fixed bottom-0 left-0 right-0 z-50 border-t border-border bg-surface p-4 shadow-xl dark:border-border-dark dark:bg-surface-dark hidden">
      <div class="mx-auto flex max-w-4xl flex-col items-center justify-between gap-3 sm:flex-row">
        <p class="flex-1 text-sm text-text-muted dark:text-text-dark-muted">
          We use cookies and privacy-safe analytics to understand site traffic and ensure our technical guides and tools work properly. You can accept all or select necessary only.
          <a href="/privacy" class="underline hover:text-brand-700 dark:hover:text-brand-300">Privacy Policy</a>
        </p>
        <div class="flex shrink-0 items-center gap-2">
          <button id="cookie-necessary" class="rounded-lg border border-border px-4 py-2 text-sm font-medium text-text-muted transition-colors hover:bg-surface-alt hover:text-text dark:border-border-dark dark:text-text-dark-muted dark:hover:bg-surface-dark-alt dark:hover:text-text-dark cursor-pointer">Necessary Only</button>
          <button id="cookie-accept" class="rounded-lg bg-brand-700 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-brand-800 cursor-pointer">Accept All</button>
        </div>
      </div>
    </div>

    <script is:inline>
      // WebMCP tools
      var mc = document.modelContext || navigator.modelContext;
      if (mc) {
        try {
          mc.registerTool({
            name: "accept_cookies",
            description: "Accept all cookies for full analytics and personalization",
            inputSchema: { type: "object", properties: {}, required: [] },
            execute: async function() {
              var b = document.getElementById("cookie-accept");
              if (b) b.click();
              return { status: "accepted" };
            }
          });
          mc.registerTool({
            name: "necessary_cookies",
            description: "Allow only necessary cookies and anonymous cookieless measurement",
            inputSchema: { type: "object", properties: {}, required: [] },
            execute: async function() {
              var b = document.getElementById("cookie-necessary") || document.getElementById("cookie-reject");
              if (b) b.click();
              return { status: "necessary" };
            }
          });
          mc.registerTool({
            name: "reject_cookies",
            description: "Alias for necessary_cookies",
            inputSchema: { type: "object", properties: {}, required: [] },
            execute: async function() {
              var b = document.getElementById("cookie-necessary") || document.getElementById("cookie-reject");
              if (b) b.click();
              return { status: "necessary" };
            }
          });
          mc.registerTool({
            name: "get_article",
            description: "Navigate to a specific article by slug",
            inputSchema: { type: "object", properties: { slug: { type: "string", description: "Article URL slug" } }, required: ["slug"] },
            execute: async function(p) {
              window.location.href = "/blog/" + p.slug;
              return { navigated: true, url: "/blog/" + p.slug };
            }
          });
          mc.registerTool({
            name: "list_recent_articles",
            description: "Get the list of recently published article titles and URLs",
            inputSchema: { type: "object", properties: {}, required: [] },
            execute: async function() {
              window.location.href = "/blog";
              return { navigated: true, url: "/blog" };
            }
          });
        } catch(e) { console.warn("WebMCP registration failed:", e); }
      }
    </script>

    <script is:inline>
      function updateConsent(status) {
        try { localStorage.setItem("cookie-consent", status); } catch(e) {}
        if (typeof gtag === "function") {
          if (status === "accepted") {
            gtag('consent', 'update', {
              'ad_storage': 'granted',
              'ad_user_data': 'granted',
              'ad_personalization': 'granted',
              'analytics_storage': 'granted'
            });
          } else {
            gtag('consent', 'update', {
              'ad_storage': 'denied',
              'ad_user_data': 'denied',
              'ad_personalization': 'denied',
              'analytics_storage': 'denied'
            });
          }
        }
      }
      var banner = document.getElementById("cookie-banner");
      var acceptBtn = document.getElementById("cookie-accept");
      var necessaryBtn = document.getElementById("cookie-necessary");
      var consent = null;
      try { consent = localStorage.getItem("cookie-consent"); } catch(e) {}

      if (!consent && banner) {
        banner.classList.remove("hidden");
      }
      if (acceptBtn) {
        acceptBtn.addEventListener("click", function () {
          updateConsent("accepted");
          if (banner) banner.classList.add("hidden");
        });
      }
      if (necessaryBtn) {
        necessaryBtn.addEventListener("click", function () {
          updateConsent("necessary");
          if (banner) banner.classList.add("hidden");
        });
      }
    </script>
    <script>
      // Real-user Core Web Vitals -> GA4.
      // Under Consent Mode v2, gtag automatically routes web vitals via
      // cookieless pings when analytics_storage is denied, or full events when granted.
      import { onCLS, onFCP, onINP, onLCP, onTTFB } from "web-vitals";
      const reportVital = (m: { name: string; value: number; rating: string }) => {
        try {
          const gtag = (window as unknown as { gtag?: (...args: unknown[]) => void }).gtag;
          if (typeof gtag !== "function") return;
          gtag("event", "web_vital", {
            vital_name: m.name,
            vital_value: Math.round(m.name === "CLS" ? m.value * 1000 : m.value),
            vital_rating: m.rating,
            page_path: location.pathname,
          });
        } catch { /* measurement must never break the page */ }
      };
      onCLS(reportVital);
      onFCP(reportVital);
      onINP(reportVital);
      onLCP(reportVital);
      onTTFB(reportVital);
    </script>
  </body>
</html>
